# SPDX-License-Identifier: GPL-3.0-or-later
# CAD-127..129, CAD-134, CAD-135 on a real coarse OpenFOAM v2506 run made in the app (about a
# minute): the results in 3D have one colour bar per quantity and the forces card, the guide
# bar steps aside, the sections and streamlines are cropped to the region around the part,
# the dense rakes give many streamlines, the pointer reads the value under it, and the
# pressure colours and Cp range can be changed, and the section across the flow can be
# moved along the wake (CAD-148).
# Run: AEROCAD_CFD_DIR=<empty dir> AeroCAD tests/data/box_200x80x60.stl --ui-script <this file>
ui.wait(800)
(() => { const p = controller.execute("document.parts").result.parts[0]; window.selectPart(p.id) })()
window.simulationVisible = true
ui.wait(500)
(() => { const r = controller.execute("simulation.run", { id: 1, mesh: "coarse", label: "results 3d" }); if (!r.ok) ui.fail("simulation.run: " + r.error); else { simulationPanel.refreshRuns(); simulationPanel.selectRun(r.result.id) } })()
# Up to 3 minutes for the run.
(() => { simulationPanel.refreshRuns(); const s = simulationPanel.activeStatus; if (s && (s.state === "running" || s.state === "prepared")) ui.wait(5000) })()
(() => { simulationPanel.refreshRuns(); const s = simulationPanel.activeStatus; if (s && (s.state === "running" || s.state === "prepared")) ui.wait(5000) })()
(() => { simulationPanel.refreshRuns(); const s = simulationPanel.activeStatus; if (s && (s.state === "running" || s.state === "prepared")) ui.wait(5000) })()
(() => { simulationPanel.refreshRuns(); const s = simulationPanel.activeStatus; if (s && (s.state === "running" || s.state === "prepared")) ui.wait(5000) })()
(() => { simulationPanel.refreshRuns(); const s = simulationPanel.activeStatus; if (s && (s.state === "running" || s.state === "prepared")) ui.wait(5000) })()
