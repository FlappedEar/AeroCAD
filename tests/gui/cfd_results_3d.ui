(() => { simulationPanel.refreshRuns(); const s = simulationPanel.activeStatus; ui.log("run " + (s ? s.id + " " + s.state : "missing")); if (!s || s.state !== "finished") ui.fail("the run did not finish") })()
(() => { simulationPanel.tab = 1; simulationPanel.setField(1, true); simulationPanel.setField(2, true) })()
ui.wait(1500)
(() => { const l = cfdOverlay.legends; ui.log("LEGENDS " + JSON.stringify(l)); if (l.length !== 2) ui.fail("expected a Cp and a speed legend, got " + l.length); const sp = l.find(x => x.scalar === "speed"); if (!sp || sp.kinds.length !== 3) ui.fail("sections and streamlines should share one speed scale") })()
(() => { if (contextBar.visible) ui.fail("the guide bar covers the results") })()
(() => { const s = simulationPanel.results.summary; ui.log("DRAG " + s.dragN); if (!(s.dragN > 0)) ui.fail("no drag on the card") })()
ui.clickText("Pressure coefficient Cp")
ui.clickText("results 3d (" + new Date(simulationPanel.activeStatus.created).toLocaleTimeString(Qt.locale(), "HH:mm") + ")")
(() => { const id = simulationPanel.activeRun; const c = simulationPanel.results.conditions; const L = c.characteristicLength * 1000; for (const kind of ["sectionHorizontal", "sectionVertical"]) { const r = controller.execute("simulation.field", { run: id, kind: kind }).result; const b = r.bounds; const size = [0, 1, 2].map(i => b.max[i] - b.min[i]); ui.log("SECTION " + kind + " size " + JSON.stringify(size) + " L " + L); if (Math.max(...size) > 3.5 * L) ui.fail(kind + " is not cropped around the part: " + JSON.stringify(size)) } })()
(() => { const r = controller.execute("simulation.field", { run: simulationPanel.activeRun, kind: "streamlines" }).result; ui.log("STREAMLINES " + r.lines + " lines"); if (r.lines < 100) ui.fail("expected the dense rakes, got " + r.lines + " streamlines") })()
# The value under the pointer, on the top of the part (sections off: the vertical one passes
# through the same point).
(() => { simulationPanel.setField(1, false); simulationPanel.setField(2, false) })()
ui.wait(500)
(() => { const b = controller.execute("simulation.field", { run: simulationPanel.activeRun, kind: "surface" }).result.bounds; const v = viewport.viewPoint(Qt.vector3d((b.min[0] + b.max[0]) / 2, (b.min[1] + b.max[1]) / 2, b.max[2])); const w = viewport.mapToItem(null, v.x, v.y); ui.move(w.x, w.y) })()
ui.wait(400)
(() => { const p = viewport.fieldProbe; ui.log("PROBE " + JSON.stringify(p)); if (!p || p.kind !== "surface" || p.values.Cp === undefined) ui.fail("no pressure value under the pointer on the part") })()
ui.clickText(viewport.probeText(viewport.fieldProbe))
ui.shot("cfd-results-3d.png")
(() => { simulationPanel.pressurePalette = "coolwarm"; simulationPanel.setRangeOverride("Cp", -1, 1) })()
ui.wait(500)
(() => { const l = cfdOverlay.legends.find(x => x.scalar === "Cp"); ui.log("CP LEGEND " + JSON.stringify(l)); if (!l || l.palette !== "coolwarm" || l.min !== -1 || l.max !== 1) ui.fail("pressure colours or Cp range not applied") })()
ui.log("cfd results 3d done")
