# SPDX-License-Identifier: GPL-3.0-or-later
# Run: AeroCAD tests/data/models/dome.stl --ui-script tests/gui/surface_timeline.ui
# The audit's curved scan is the fixture. Actual timeline context-menu clicks open
# editors; real Apply/OK clicks commit independent clearance and thickness edits.
# Evidence is written beside the temporary project (/tmp/aerocad-cad78-*).
Qt.createQmlObject('import QtQuick; Item { objectName: "surfaceTimelineTest"; visible: false; property var s: ({}); function run(name, params) { const r = controller.execute(name, params || {}); if (!r.ok) { ui.fail(name + ": " + r.error); throw new Error(r.error) } return r.result } function find(item, predicate) { if (predicate(item)) return item; for (const c of item.children || []) { const hit = find(c, predicate); if (hit) return hit } return null } function openFeature(type) { const f = run("timeline.list").features.find(x => x.type === type); const text = find(window.contentItem, x => x.visible && x.text === f.name); if (!text) throw new Error("No timeline chip for " + type); const p = text.mapToItem(null, text.width / 2, text.height / 2); ui.click(p.x, p.y, "right") } function setField(key, value) { const input = find(featureDialog, x => x.field && x.field.key === key && x.editingFinished !== undefined); if (!input) throw new Error("No editor for " + key); const p = input.mapToItem(null, input.width / 2, input.height / 2); ui.click(p.x, p.y); input.text = String(value); input.editingFinished() } function solidTop() { return run("document.parts").parts.find(p => p.id === s.solid.id).bounds.max[2] } }', window.contentItem)
ui.wait(600)
(() => { const t = Array.from(window.contentItem.children).find(x => x.objectName === "surfaceTimelineTest"); const scan = t.run("document.parts").parts[0]; t.s.scan = scan.id; t.run("selection.brush", {id: scan.id, points: [[0, 0, scan.bounds.max[2]]], radius: 45}); t.s.fit = t.run("surface.fit_selection", {id: scan.id, tolerance: 0.5}); t.s.offset = t.run("surface.offset", {id: t.s.fit.id, distance: 2}); t.s.solid = t.run("surface.thicken", {id: t.s.offset.id, thickness: 3}); t.s.originalTop = t.solidTop(); for (const id of [scan.id, t.s.fit.id, t.s.offset.id]) t.run("part.set_visible", {id: id, visible: false}); if (t.run("timeline.list").features.length !== 3) ui.fail("expected three persistent steps"); if (contextActions.role(controller.partInfo(t.s.fit.id)) !== "surface") ui.fail("timeline surface lost surface actions"); window.selectPart(t.s.solid.id); viewport.fitAll(); Preferences.theme = "light"; t.run("project.save", {path: "/tmp/aerocad-cad78-surface.aerocad"}); })()
ui.wait(300)
Array.from(window.contentItem.children).find(x => x.objectName === "surfaceTimelineTest").openFeature("offset_surface")
ui.wait(150)
ui.clickText("Edit Feature")
ui.wait(200)
(() => { const t = Array.from(window.contentItem.children).find(x => x.objectName === "surfaceTimelineTest"); if (!featureDialog.visible || featureDialog.type !== "offset_surface") ui.fail("clearance editor did not open"); t.setField("distance", 4); })()
ui.shot("/tmp/aerocad-cad78-clearance-light.png")
ui.clickText("OK")
ui.wait(250)
(() => { const t = Array.from(window.contentItem.children).find(x => x.objectName === "surfaceTimelineTest"); const features = t.run("timeline.list").features; if (features.find(f => f.type === "offset_surface").params.distance !== 4 || features.find(f => f.type === "thicken_surface").params.thickness !== 3) ui.fail("clearance edit changed wall thickness"); t.s.offsetTop = t.solidTop(); if (t.s.offsetTop < t.s.originalTop + 1.8) ui.fail("solid did not follow clearance"); t.openFeature("thicken_surface"); })()
ui.wait(150)
ui.clickText("Edit Feature")
ui.wait(200)
(() => { const t = Array.from(window.contentItem.children).find(x => x.objectName === "surfaceTimelineTest"); t.setField("thickness", 4); Preferences.theme = "dark"; })()
ui.wait(200)
ui.shot("/tmp/aerocad-cad78-thickness-dark.png")
ui.clickText("OK")
ui.wait(250)
(() => { const t = Array.from(window.contentItem.children).find(x => x.objectName === "surfaceTimelineTest"); if (t.solidTop() < t.s.offsetTop + 0.8) ui.fail("solid did not follow thickness"); const beforeMove = t.solidTop(); t.run("part.transform", {id: t.s.scan, translate: [0, 0, 10]}); if (Math.abs(t.solidTop() - beforeMove - 10) > 0.1) ui.fail("source translation did not rebuild descendants"); t.run("edit.undo"); if (Math.abs(t.solidTop() - beforeMove) > 0.1) ui.fail("source undo did not restore descendants"); t.run("edit.redo"); t.s.savedTop = t.solidTop(); t.run("variant.create"); t.run("feature.edit", {id: t.s.solid.feature, params: {thickness: 5}}); t.run("variant.activate", {variant: "A"}); if (Math.abs(t.solidTop() - t.s.savedTop) > 0.1) ui.fail("variant A changed"); t.run("project.save", {path: "/tmp/aerocad-cad78-surface.aerocad"}); t.run("project.open", {path: "/tmp/aerocad-cad78-surface.aerocad"}); if (Math.abs(t.solidTop() - t.s.savedTop) > 0.1) ui.fail("save/reopen changed the result"); t.run("variant.activate", {variant: "B"}); if (t.solidTop() < t.s.savedTop + 0.8) ui.fail("variant B lost its wall thickness"); viewport.fitAll(); ui.log("CAD-78 curved GUI workflow passed: timeline editors, independent dimensions, source undo/redo, variants and save/reopen"); })()
ui.wait(300)
ui.shot("/tmp/aerocad-cad78-reopened-dark.png")
