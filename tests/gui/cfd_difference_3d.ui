# SPDX-License-Identifier: GPL-3.0-or-later
# CAD-141 on two real coarse OpenFOAM v2506 runs of the same box made in the app (about a
# minute, both at once): with B ticked in the run list, "Difference B − A on the part" draws the
# pressure change on A's part with its own diverging colour bar, and the card adds the change of
# the forces. Identical shapes and settings: the change is zero within the noise of parallel runs (|ΔCp| under 0.03 on 96 % of the part; 0.004 to 0.011 seen) and no
# point is grey (no point of A without B's surface next to it).
# Run: AEROCAD_CFD_DIR=<empty dir> AeroCAD tests/data/box_200x80x60.stl --ui-script <this file>
ui.wait(800)
(() => { const p = controller.execute("document.parts").result.parts[0]; window.selectPart(p.id) })()
window.simulationVisible = true
ui.wait(500)
Qt.createQmlObject('import QtQuick; Item { objectName: "diffTest"; visible: false; property var ids: ({}) }', window.contentItem)
(() => { const t = Array.from(window.contentItem.children).find(c => c.objectName === "diffTest"); for (const label of ["first", "second"]) { const r = controller.execute("simulation.run", { id: 1, mesh: "coarse", label: label }); if (!r.ok) ui.fail("simulation.run: " + r.error); else t.ids[label] = r.result.id } simulationPanel.refreshRuns() })()
# Up to 4 minutes for both runs.
(() => { simulationPanel.refreshRuns(); if (simulationPanel.runs.some(r => r.state === "running" || r.state === "prepared")) ui.wait(5000) })()
(() => { simulationPanel.refreshRuns(); if (simulationPanel.runs.some(r => r.state === "running" || r.state === "prepared")) ui.wait(5000) })()
