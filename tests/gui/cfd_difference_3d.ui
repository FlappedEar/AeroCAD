(() => { const t = Array.from(window.contentItem.children).find(c => c.objectName === "diffTest"); simulationPanel.refreshRuns(); const mine = simulationPanel.runs.filter(r => r.id === t.ids.first || r.id === t.ids.second); ui.log("runs " + mine.map(r => r.id + " " + r.state).join(", ")); if (mine.length !== 2 || mine.some(r => r.state !== "finished")) ui.fail("the runs did not finish") })()
# A = the first run, B = the second one, ticked with its B button in the run list.
(() => { const t = Array.from(window.contentItem.children).find(c => c.objectName === "diffTest"); simulationPanel.selectRun(t.ids.first); simulationPanel.tab = 0 })()
ui.wait(500)
(() => { const t = Array.from(window.contentItem.children).find(c => c.objectName === "diffTest"); const name = "compareButton_" + t.ids.second; const find = i => { if (!i) return null; if (i.objectName === name) return i; const ch = i.children || []; for (let k = 0; k < ch.length; ++k) { const r = find(ch[k]); if (r) return r } return null }; const b = find(simulationPanel); if (!b || !b.visible) { ui.fail("no B button for the second run"); return } const p = b.mapToItem(null, b.width / 2, b.height / 2); ui.click(p.x, p.y) })()
ui.wait(800)
(() => { ui.log("comparison " + JSON.stringify(simulationPanel.comparison ? simulationPanel.comparison.reasons : null)); if (!simulationPanel.finalComparisonAvailable) ui.fail("A and B not comparable") })()
(() => { simulationPanel.tab = 1 })()
ui.wait(500)
# Scroll the panel so the check box is in view, then tick it with a real click.
(() => { const find = i => { if (!i) return null; if (i.objectName === "differenceCheck") return i; const ch = i.children || []; for (let k = 0; k < ch.length; ++k) { const r = find(ch[k]); if (r) return r } return null }; const c = find(simulationPanel); let f = c.parent; while (f && f.contentY === undefined) f = f.parent; if (f) { const y = c.mapToItem(f.contentItem, 0, 0).y; f.contentY = Math.max(0, Math.min(y - 100, f.contentHeight - f.height)) } })()
ui.wait(300)
ui.clickText("Difference B − A on the part (ΔCp)")
ui.wait(1500)
(() => { const f = simulationPanel.viewportFields.find(x => x.kind === "surface"); ui.log("FIELD " + JSON.stringify(f)); if (!simulationPanel.differenceShown || !f || f.scalar !== "dCp" || f.compareRun !== simulationPanel.compareRun) ui.fail("the difference map is not drawn") })()
(() => { const s = simulationPanel.differenceStats; ui.log("DCP " + JSON.stringify(s)); if (!s || Math.abs(s.p02) > 0.03 || Math.abs(s.p98) > 0.03 || Math.abs(s.min) > 0.2 || Math.abs(s.max) > 0.2) ui.fail("identical runs should give no pressure change beyond the noise of parallel runs") })()
(() => { const r = controller.execute("simulation.field", { run: simulationPanel.activeRun, kind: "surface", compare: simulationPanel.compareRun }).result; const a = controller.execute("simulation.field", { run: simulationPanel.activeRun, kind: "surface" }).result; ui.log("POINTS " + r.points + " of " + a.points); if (r.points !== a.points) ui.fail("the difference is not on A's surface") })()
ui.clickText("Cp change, B − A")
ui.clickText("on part A · grey: shapes differ")
ui.clickText("Change B − A")
(() => { if (!cfdOverlay.comparison) ui.fail("the card has no change of the forces"); if (!/^A: /.test(cfdOverlay.runTitle)) ui.fail("card title: " + cfdOverlay.runTitle) })()
ui.shot("cfd-difference-3d.png")
# "Show B in 3D" and the difference exclude each other; the card stays on A while the
# difference is shown.
(() => { simulationPanel.showB = true; if (simulationPanel.showDifference) ui.fail("Show B in 3D left the difference ticked"); simulationPanel.showDifference = true; if (simulationPanel.showB) ui.fail("the difference left Show B in 3D ticked"); if (simulationPanel.displayedRun !== simulationPanel.activeRun || !cfdOverlay.results) ui.fail("the card does not show A with the difference") })()
ui.wait(500)
# Unticked: the pressure of A comes back.
ui.clickText("Difference B − A on the part (ΔCp)")
ui.wait(800)
(() => { const f = simulationPanel.viewportFields.find(x => x.kind === "surface"); if (!f || f.scalar !== "Cp" || cfdOverlay.comparison) ui.fail("the pressure map of A did not come back") })()
ui.log("cfd difference 3d done")
