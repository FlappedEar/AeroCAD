# Mouse and touchpad navigation and the right-click menu, with real input events:
#  - the mouse wheel zooms (also with the pixel delta macOS adds to every wheel) and keeps
#    the model point under the pointer in place;
#  - a right drag orbits around the point under the pointer and opens no menu;
#  - a right click opens a menu that fits what is under the pointer;
#  - two-finger scroll zooms by default, Ctrl + scroll pans; Move/Rotate turns a scan.
# Run: AeroCAD tests/data/box_200x80x60.stl --ui-script <this file>
Qt.createQmlObject('import QtQuick; Item { objectName: "navTest"; visible: false; property var s: ({}); function vp() { return viewport } function center() { const p = viewport.mapToItem(null, viewport.width / 2, viewport.height / 2); return Qt.point(p.x, p.y) } function cam() { return viewport.cameraState() } function near(a, b, tol) { return Math.abs(a - b) <= tol } function dist(p, q) { return p.minus(q).length() } function local(p) { return viewport.mapFromItem(null, p.x, p.y) } function under(p) { const l = local(p); return viewport.scenePointUnder(l.x, l.y, true) } function menuTexts() { const out = []; for (let i = 0; i < partMenu.count; ++i) out.push(partMenu.itemAt(i).text || "-"); return out } }', window.contentItem)
ui.wait(800)
(() => { const parts = controller.execute("document.parts").result.parts; if (parts.length !== 1) ui.fail("expected the box to be loaded, got " + parts.length + " parts"); viewport.restoreCameraState({ pivot: [0, 0, 0], pitch: -30, yaw: 45, distance: 1, orthographic: false }); viewport.fitAll() })()
ui.wait(300)
# 1. Mouse wheel, as on macOS (pixel delta too): zoom in, no pan, no orbit.
(() => { const t = Array.from(window.contentItem.children).find(c => c.objectName === "navTest"); const c = t.center(); t.s.before = t.cam(); ui.mouseWheel(c.x, c.y, 3, 20); const a = t.cam(); ui.log("wheel: distance " + t.s.before.distance.toFixed(1) + " -> " + a.distance.toFixed(1)); if (!(a.distance < t.s.before.distance * 0.75)) ui.fail("mouse wheel did not zoom in"); if (!t.near(a.pitch, t.s.before.pitch, 1e-6) || !t.near(a.yaw, t.s.before.yaw, 1e-6)) ui.fail("mouse wheel rotated the view"); ui.mouseWheel(c.x, c.y, -3, 20); const b = t.cam(); if (!t.near(b.distance, t.s.before.distance, t.s.before.distance * 1e-3)) ui.fail("wheel back did not restore the distance: " + b.distance) })()
# 2. Zoom towards the pointer: the model point under the pointer stays under it.
(() => { const t = Array.from(window.contentItem.children).find(c => c.objectName === "navTest"); const c = t.center(); const p = Qt.point(c.x + 60, c.y + 20); const before = t.under(p); if (!before) { ui.fail("no model under the pointer"); return } for (let i = 0; i < 5; ++i) ui.mouseWheel(p.x, p.y, 1); const after = t.under(p); const d = after ? t.dist(before, after) : -1; ui.log("zoom at pointer: point moved " + d.toFixed(3) + " mm, distance " + t.cam().distance.toFixed(1)); if (!after || d > 0.5) ui.fail("zoom moved the point under the pointer by " + d) })()
viewport.fitAll()
ui.wait(200)
# 3. Right drag orbits around the point under the pointer and opens no menu.
(() => { const t = Array.from(window.contentItem.children).find(c => c.objectName === "navTest"); const c = t.center(); const p = Qt.point(c.x + 40, c.y + 10); t.s.p = p; t.s.at = t.under(p); t.s.before = t.cam(); ui.drag(p.x, p.y, p.x + 120, p.y + 40, "right", "", 12) })()
ui.wait(300)
(() => { const t = Array.from(window.contentItem.children).find(c => c.objectName === "navTest"); const a = t.cam(); ui.log("right drag: yaw " + t.s.before.yaw.toFixed(1) + " -> " + a.yaw.toFixed(1) + ", pitch " + t.s.before.pitch.toFixed(1) + " -> " + a.pitch.toFixed(1)); if (t.near(a.yaw, t.s.before.yaw, 5)) ui.fail("right drag did not orbit"); if (partMenu.visible) ui.fail("right drag opened the context menu"); const ray = t.under(t.s.p); ui.log("orbit centre drift " + (ray ? t.dist(ray, t.s.at).toFixed(3) : "none")); if (!ray || t.dist(ray, t.s.at) > 1.0) ui.fail("orbit did not keep the point under the pointer") })()
viewport.fitAll()
ui.wait(200)
# 4. Right click on the box: its own commands only.
(() => { const t = Array.from(window.contentItem.children).find(c => c.objectName === "navTest"); const c = t.center(); ui.click(c.x, c.y, "right") })()
ui.wait(400)
(() => { const t = Array.from(window.contentItem.children).find(c => c.objectName === "navTest"); const items = t.menuTexts(); ui.log("menu on part: " + JSON.stringify(items)); if (!partMenu.visible) ui.fail("right click on the part opened no menu"); if (!items.some(s => s.startsWith("Scan (mesh): "))) ui.fail("menu has no part header"); for (const want of ["Move / Rotate…", "Zoom to this", "Hide", "Delete"]) if (items.indexOf(want) < 0) ui.fail("menu on part lacks " + want); for (const bad of ["Import a scan or model", "New sketch", "Box", "Fit All (F6)"]) if (items.indexOf(bad) >= 0) ui.fail("menu on part offers " + bad); for (let i = 0; i < partMenu.count; ++i) if (partMenu.itemAt(i).text && !partMenu.itemAt(i).enabled && i > 0) ui.fail("menu shows a disabled item: " + partMenu.itemAt(i).text); partMenu.close() })()
ui.wait(300)
# 5. Right click on empty space: view commands, nothing about parts.
(() => { const p = viewport.mapToItem(null, 30, viewport.height - 80); ui.click(p.x, p.y, "right") })()
ui.wait(400)
(() => { const t = Array.from(window.contentItem.children).find(c => c.objectName === "navTest"); const items = t.menuTexts(); ui.log("menu on empty space: " + JSON.stringify(items)); if (!partMenu.visible) ui.fail("right click on empty space opened no menu"); for (const want of ["Fit All (F6)", "Home View", "Orthographic", "Import a scan or model"]) if (items.indexOf(want) < 0) ui.fail("empty-space menu lacks " + want); for (const bad of ["Delete", "Hide", "Move / Rotate…"]) if (items.indexOf(bad) >= 0) ui.fail("empty-space menu offers " + bad); partMenu.close() })()
ui.wait(300)
# 6. Touchpad: two-finger scroll zooms, Ctrl + scroll pans, Shift + scroll orbits.
(() => { const t = Array.from(window.contentItem.children).find(c => c.objectName === "navTest"); const c = t.center(); const b = t.cam(); ui.wheel(c.x, c.y, 0, 30); const a = t.cam(); ui.log("touchpad scroll: distance " + b.distance.toFixed(1) + " -> " + a.distance.toFixed(1)); if (!(a.distance < b.distance * 0.95)) ui.fail("two-finger scroll did not zoom"); ui.wheel(c.x, c.y, 25, 0, "ctrl"); const p = t.cam(); if (!t.near(p.distance, a.distance, 1e-6) || t.near(p.pivot[0] + p.pivot[1] + p.pivot[2], a.pivot[0] + a.pivot[1] + a.pivot[2], 1e-6)) ui.fail("ctrl + scroll did not pan"); ui.wheel(c.x, c.y, 30, 0, "shift"); if (t.near(t.cam().yaw, p.yaw, 1)) ui.fail("shift + scroll did not orbit") })()
# 7. Move/Rotate: M opens it for the selected scan, 90 degrees about Z swaps its X and Y size.
(() => { const id = controller.execute("document.parts").result.parts[0].id; window.selectPart(id); moveAction.trigger() })()
ui.wait(300)
(() => { if (!actionPopup.visible) ui.fail("Move/Rotate asked for nothing"); const info = controller.partInfo(window.selectedPartId); ui.log("before: " + info.sizeX.toFixed(1) + " x " + info.sizeY.toFixed(1)); actionPopup.close(); contextActions.run("moveRotate", info, { axis: "z", angle: 90, dx: 0, dy: 0, dz: 10 }); const after = controller.partInfo(window.selectedPartId); ui.log("after: " + after.sizeX.toFixed(1) + " x " + after.sizeY.toFixed(1)); if (Math.abs(after.sizeX - info.sizeY) > 1e-3 || Math.abs(after.sizeY - info.sizeX) > 1e-3) ui.fail("rotate did not turn the scan"); controller.execute("edit.undo"); const back = controller.partInfo(window.selectedPartId); if (Math.abs(back.sizeX - info.sizeX) > 1e-3) ui.fail("undo did not restore the scan") })()
# 8. Alternate mouse profiles keep their middle-drag zoom (SolidWorks: Shift + middle).
(() => { const t = Array.from(window.contentItem.children).find(c => c.objectName === "navTest"); const old = Preferences.mouseProfile; Preferences.mouseProfile = "solidworks"; const c = t.center(); const b = t.cam().distance; ui.drag(c.x, c.y, c.x, c.y + 80, "middle", "shift", 8); const a = t.cam().distance; Preferences.mouseProfile = old; ui.log("solidworks shift+middle: " + b.toFixed(1) + " -> " + a.toFixed(1)); if (Math.abs(a - b) < 1) ui.fail("Shift + middle drag did not zoom in the SolidWorks profile") })()
# 9. Fit All between two wheel turns at the same spot: the second turn anchors on what is
#    under the pointer now (0.05 mm: float precision, well under a pixel).
viewport.fitAll()
ui.wait(200)
(() => { const t = Array.from(window.contentItem.children).find(c => c.objectName === "navTest"); const c = t.center(); const p = Qt.point(c.x + 20, c.y + 10); ui.drag(c.x, c.y, c.x + 80, c.y + 30, "middle", "", 8); ui.mouseWheel(p.x, p.y, 1); viewport.fitAll(); const before = t.under(p); ui.mouseWheel(p.x, p.y, 1); const after = t.under(p); const d = before && after ? t.dist(before, after) : -1; ui.log("zoom after Fit All: point moved " + d.toFixed(4) + " mm"); if (d < 0 || d > 0.05) ui.fail("zoom after Fit All used a stale anchor: " + d); const b2 = t.under(p); ui.mouseWheel(p.x, p.y, 1); ui.mouseWheel(p.x, p.y, 1); const a2 = t.under(p); ui.log("consecutive: " + (a2 ? t.dist(a2, b2).toFixed(4) : "none") + " distance " + t.cam().distance.toFixed(1)); if (!a2 || t.dist(a2, b2) > 0.05) ui.fail("consecutive wheel turns lost their anchor") })()
