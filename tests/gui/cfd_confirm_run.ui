# CAD-151: stopping or deleting a wind tunnel run is asked first (a run can take hours and
# deleting removes its files). "Keep" leaves the run as it is; "Stop run" / "Delete" do it.
# Uses tests/gui/fake-docker.sh as the engine: the run only sleeps.
ui.wait(800)
(() => { for (const r of controller.execute("simulation.list").result.runs) controller.execute("simulation.delete", { run: r.id }) })()
(() => { const p = controller.execute("document.parts").result.parts[0]; window.selectPart(p.id) })()
ui.clickText("SIMULATE")
ui.wait(300)
ui.clickText("Wind Tunnel")
ui.wait(800)
ui.clickText("Run CFD")
ui.wait(1500)
# Results tab: Cancel asks; Keep leaves it running.
ui.clickText("Cancel")
ui.wait(400)
ui.shot("cfd-confirm-stop.png")
ui.clickText("Keep")
ui.wait(800)
(() => { simulationPanel.refreshRuns(); ui.log("after Keep: " + simulationPanel.activeStatus.state); if (simulationPanel.activeStatus.state !== "running") ui.fail("Keep stopped the run") })()
ui.clickText("Cancel")
ui.wait(400)
ui.clickText("Stop run")
ui.wait(1500)
(() => { simulationPanel.refreshRuns(); ui.log("after Stop run: " + simulationPanel.activeStatus.state); if (simulationPanel.activeStatus.state !== "cancelled") ui.fail("Stop run did not stop the run") })()
# Run list: ✕ asks; Keep leaves the run, Delete removes it.
(() => { simulationPanel.tab = 0 })()
ui.wait(500)
ui.clickText("✕")
ui.wait(400)
ui.shot("cfd-confirm-delete.png")
ui.clickText("Keep")
ui.wait(500)
(() => { const n = controller.execute("simulation.list").result.runs.length; ui.log("runs after Keep: " + n); if (n !== 1) ui.fail("Keep deleted the run") })()
ui.clickText("✕")
ui.wait(400)
ui.clickText("Delete")
ui.wait(800)
(() => { const n = controller.execute("simulation.list").result.runs.length; ui.log("runs after Delete: " + n); if (n !== 0) ui.fail("Delete kept the run") })()
ui.log("cfd confirm run done")
