# CAD-200: 2-Point Circle and 3-Point Circle in the sketch (Fusion Circle variants), with
# real clicks and a typed diameter. The circles extrude into bodies.
# Run: AeroCAD --ui-script <this file>
ui.wait(800)
Qt.createQmlObject('import QtQuick; Item { objectName: "ccTest"; visible: false; function at(u, v) { const o = viewport.sketchOverlay; const q = o.toScreen([u, v]); return o.mapToItem(null, q.x, q.y) } function clickAt(u, v) { const p = at(u, v); ui.click(p.x, p.y) } function moveTo(u, v) { const p = at(u, v); ui.move(p.x, p.y) } function curves() { return controller.execute("sketch.curves", { sketch: activeSketch.id }).result.curves } function isCircle(c, x, y, r) { return c.kind === "circle" && Math.abs(c.points[0][0] - x) < 1e-6 && Math.abs(c.points[0][1] - y) < 1e-6 && Math.abs(c.radius - r) < 1e-6 } }', window.contentItem)
(() => { const r = controller.execute("sketch.create", { plane: "XY", curves: [{ type: "line", start: [-80, 60], end: [-70, 70], construction: true }] }); if (!r.ok) ui.fail("sketch: " + r.error) })()
ui.wait(300)
(() => { enterSketch(controller.execute("timeline.list").result.features[0].id) })()
ui.wait(800)
# 2-Point Circle from the ribbon's CREATE menu: (0, -20) and (20, -20) are the ends of a
# diameter, so the centre is (10, -20) and the radius 10.
(() => { if (!ui.clickText("CREATE")) ui.fail("no CREATE caption in the sketch ribbon") })()
ui.wait(300)
(() => { if (!ui.clickText("&2-Point Circle")) ui.fail("no 2-Point Circle in the CREATE menu"); if (sketchTool !== "circle_2point") ui.fail("the tool did not start: " + sketchTool) })()
ui.wait(300)
(() => { const t = Array.from(window.contentItem.children).find(c => c.objectName === "ccTest"); t.clickAt(0, -20); t.moveTo(20, -20) })()
ui.wait(200)
ui.shot("sketch-circle-2point-preview.png")
(() => { const t = Array.from(window.contentItem.children).find(c => c.objectName === "ccTest"); t.clickAt(20, -20) })()
ui.wait(500)
(() => { const t = Array.from(window.contentItem.children).find(c => c.objectName === "ccTest"); const c = t.curves(); ui.log("2-point circle " + JSON.stringify(c[1])); if (c.length !== 2 || !t.isCircle(c[1], 10, -20, 10)) ui.fail("expected a circle about (10, -20), r 10: " + JSON.stringify(c)) })()
# Typed diameter: first point (-40, -30), cursor towards +x, "8" Enter: centre (-36, -30).
(() => { const t = Array.from(window.contentItem.children).find(c => c.objectName === "ccTest"); t.clickAt(-40, -30); t.moveTo(-30, -30) })()
ui.wait(200)
ui.type("8")
ui.key("Return")
ui.wait(500)
(() => { const t = Array.from(window.contentItem.children).find(c => c.objectName === "ccTest"); const c = t.curves(); ui.log("typed 2-point circle " + JSON.stringify(c[2])); if (c.length !== 3 || !t.isCircle(c[2], -36, -30, 4)) ui.fail("typed diameter 8 from (-40, -30) not drawn: " + JSON.stringify(c.slice(2))) })()
# A diameter expression: with d0 = 6 mm, first point (0, 20), cursor towards +x, "d0 + 2"
# in the Size field (letters are tool shortcuts, so click the field first): diameter 8
# about (4, 20), kept as the expression.
(() => { const r = controller.execute("parameter.set", { name: "d0", expression: "6 mm" }); if (!r.ok) ui.fail("parameter: " + r.error) })()
ui.wait(300)
(() => { const t = Array.from(window.contentItem.children).find(c => c.objectName === "ccTest"); t.clickAt(0, 20); t.moveTo(10, 20) })()
ui.wait(200)
(() => { const find = it => { if (it.objectName === "sketchDimension") return it; for (let i = 0; i < it.children.length; ++i) { const f = find(it.children[i]); if (f) return f } return null }; const f = find(viewport.sketchOverlay); if (!f || !f.visible) ui.fail("no Size field"); const p = f.mapToItem(null, f.width / 2, f.height / 2); ui.click(p.x, p.y) })()
ui.wait(200)
ui.type("d0 + 2")
ui.key("Return")
ui.wait(500)
(() => { const t = Array.from(window.contentItem.children).find(c => c.objectName === "ccTest"); const c = t.curves(); ui.log("expression 2-point circle " + JSON.stringify(c[3])); if (c.length !== 4 || !t.isCircle(c[3], 4, 20, 4)) ui.fail("diameter d0 + 2 from (0, 20) not drawn: " + JSON.stringify(c.slice(3))); const items = controller.execute("timeline.list").result.features[0].params.curves; if (items[items.length - 1].diameter !== "d0 + 2") ui.fail("the circle lost the diameter expression: " + JSON.stringify(items[items.length - 1])) })()
# 3-Point Circle from the Sketch menu: (40, -30), (60, -30), (50, -20) lie on the circle
# about (50, -30) with radius 10.
(() => { if (!ui.clickText("&Sketch")) ui.fail("no Sketch menu") })()
ui.wait(300)
(() => { if (!ui.clickText("&3-Point Circle")) ui.fail("no 3-Point Circle in the Sketch menu"); if (sketchTool !== "circle_3point") ui.fail("the tool did not start: " + sketchTool) })()
ui.wait(300)
(() => { const t = Array.from(window.contentItem.children).find(c => c.objectName === "ccTest"); t.clickAt(40, -30); t.clickAt(60, -30); t.moveTo(50, -20) })()
ui.wait(200)
ui.shot("sketch-circle-3point-preview.png")
(() => { const t = Array.from(window.contentItem.children).find(c => c.objectName === "ccTest"); t.clickAt(50, -20) })()
ui.wait(500)
(() => { const t = Array.from(window.contentItem.children).find(c => c.objectName === "ccTest"); const c = t.curves(); ui.log("3-point circle " + JSON.stringify(c[4])); if (c.length !== 5 || !t.isCircle(c[4], 50, -30, 10)) ui.fail("expected a circle about (50, -30), r 10: " + JSON.stringify(c.slice(4))) })()
# Three points on one line give no circle, and the next three clicks start afresh.
(() => { const t = Array.from(window.contentItem.children).find(c => c.objectName === "ccTest"); t.clickAt(-40, 10); t.clickAt(-30, 10); t.clickAt(-20, 10) })()
ui.wait(500)
(() => { const t = Array.from(window.contentItem.children).find(c => c.objectName === "ccTest"); const c = t.curves(); if (c.length !== 5) ui.fail("collinear points made a curve: " + JSON.stringify(c.slice(5))); if (viewport.sketchOverlay.points.length !== 0) ui.fail("collinear clicks left points pending: " + JSON.stringify(viewport.sketchOverlay.points)) })()
ui.shot("sketch-circle-tools.png")
# Finish and extrude: the four circles are the profiles (r 10, 4, 4 and 10; 10 mm).
(() => { finishSketch(true) })()
ui.wait(500)
(() => { const sk = controller.execute("timeline.list").result.features[0].id; const r = controller.execute("feature.extrude", { sketch: sk, distance: 10 }); if (!r.ok) ui.fail("extrude: " + r.error) })()
ui.wait(500)
(() => { const b = controller.execute("timeline.list").result.bodies; const v = b.reduce((s, x) => s + x.volume, 0); ui.log("volume " + v); if (Math.abs(v - Math.PI * (100 + 16 + 16 + 100) * 10) > 0.5) ui.fail("expected " + (Math.PI * 2320) + " mm³, got " + v) })()
