# CAD-269: Polygon types (Inscribed / Circumscribed / Edge) and Slot types (Center to Center /
# Overall / Center Point) like Fusion, picked from the tool options with real clicks. Before,
# Polygon and Slot had one way of drawing each.
# Run: AeroCAD --ui-script <this file>
Qt.createQmlObject('import QtQuick; Item { objectName: "psTest"; visible: false; function find(i, name) { if (!i) return null; if (i.objectName === name && i.visible) return i; const ch = i.children || []; for (let k = 0; k < ch.length; ++k) { const r = find(ch[k], name); if (r) return r } return null } function at(q) { const o = viewport.sketchOverlay; const p = o.toScreen(q); return o.mapToItem(null, p.x, p.y) } function clickAt(q) { const w = at(q); ui.move(w.x, w.y); ui.wait(80); ui.click(w.x, w.y); ui.wait(150) } function moveTo(q) { const w = at(q); ui.move(w.x, w.y); ui.wait(150) } function curves() { return controller.execute("sketch.curves", { sketch: activeSketch.id }).result.curves } function pick(box, label) { const b = find(window.contentItem, box); if (!b) return false; const p = b.mapToItem(null, b.width / 2, b.height / 2); ui.click(p.x, p.y); ui.wait(300); return ui.clickText(label) } }', window.contentItem)
ui.wait(800)
(() => { window.createSketch({ plane: "XY" }); if (!window.activeSketch) ui.fail("no sketch") })()
ui.wait(800)
(() => { viewport.restoreCameraState({ pivot: [30, 10, 0], pitch: -90, yaw: 0, distance: 220, orthographic: false }) })()
ui.wait(400)
(() => { if (!ui.clickText("CREATE")) ui.fail("no CREATE menu on the ribbon") })()
ui.wait(400)
(() => { if (!ui.clickText("Polygon")) ui.fail("no Polygon in the CREATE menu") })()
ui.wait(300)
(() => { if (sketchTool !== "polygon") ui.fail("Polygon did not start: " + sketchTool) })()
# Circumscribed: centre (0,0), then the middle of a side at (10,0): a hexagon with apothem 10.
(() => { const t = Array.from(window.contentItem.children).find(c => c.objectName === "psTest"); if (!t.pick("polygonModeBox", "Circumscribed")) ui.fail("no Circumscribed in the Polygon type list") })()
ui.wait(300)
(() => { if (viewport.sketchOverlay.polygonMode !== "circumscribed") ui.fail("the type did not change: " + viewport.sketchOverlay.polygonMode) })()
(() => { const t = Array.from(window.contentItem.children).find(c => c.objectName === "psTest"); t.clickAt([0, 0]); t.moveTo([10, 0]) })()
ui.shot("build/sketch-polygon-circumscribed-preview.png")
(() => { const t = Array.from(window.contentItem.children).find(c => c.objectName === "psTest"); t.clickAt([10, 0]) })()
ui.wait(500)
(() => { const t = Array.from(window.contentItem.children).find(c => c.objectName === "psTest"); const c = t.curves(); const a = controller.execute("sketch.profiles", { sketch: activeSketch.id }).result.profiles[0].area; const want = 6 * 100 * Math.tan(Math.PI / 6); ui.log("circumscribed hexagon: " + c.length + " sides, area " + a.toFixed(3) + " want " + want.toFixed(3)); if (c.length !== 6 || Math.abs(a - want) > 1e-3) ui.fail("not a hexagon with apothem 10") })()
# Edge polygon: a hexagon (6 sides by default) on the side from (40,0) to (50,0), above it.
(() => { const t = Array.from(window.contentItem.children).find(c => c.objectName === "psTest"); if (!t.pick("polygonModeBox", "Edge")) ui.fail("no Edge in the Polygon type list") })()
ui.wait(300)
(() => { const t = Array.from(window.contentItem.children).find(c => c.objectName === "psTest"); t.clickAt([40, 0]); t.moveTo([50, 0]) })()
ui.shot("build/sketch-polygon-edge-preview.png")
(() => { const t = Array.from(window.contentItem.children).find(c => c.objectName === "psTest"); t.clickAt([50, 0]) })()
ui.wait(500)
(() => { const t = Array.from(window.contentItem.children).find(c => c.objectName === "psTest"); const c = t.curves(); ui.log("curves after edge polygon: " + c.length); if (c.length !== 12) ui.fail("expected 6 + 6 curves, got " + c.length); const ps = controller.execute("sketch.profiles", { sketch: activeSketch.id }).result.profiles; const p = ps.find(q => q.centroid[0] > 30); if (!p || Math.abs(p.area - 6 / 4 * 100 / Math.tan(Math.PI / 6)) > 1e-3 || p.centroid[1] <= 0) ui.fail("not a hexagon of side 10 above the edge: " + JSON.stringify(p)) })()
# Slot: Overall from (0,40) to (25,40), width 6.
(() => { if (!ui.clickText("CREATE")) ui.fail("no CREATE menu on the ribbon") })()
ui.wait(400)
(() => { if (!ui.clickText("Slot")) ui.fail("no Slot in the CREATE menu") })()
ui.wait(300)
(() => { if (sketchTool !== "slot") ui.fail("Slot did not start: " + sketchTool) })()
(() => { const t = Array.from(window.contentItem.children).find(c => c.objectName === "psTest"); if (!t.pick("slotModeBox", "Overall")) ui.fail("no Overall in the Slot type list") })()
ui.wait(300)
(() => { const t = Array.from(window.contentItem.children).find(c => c.objectName === "psTest"); t.clickAt([0, 40]); t.clickAt([25, 40]); t.moveTo([13, 43]) })()
ui.shot("build/sketch-slot-overall-preview.png")
(() => { const t = Array.from(window.contentItem.children).find(c => c.objectName === "psTest"); t.clickAt([13, 43]) })()
ui.wait(500)
(() => { const c = controller.execute("sketch.curves", { sketch: activeSketch.id }).result.curves; const slot = c.slice(12); const xs = slot.reduce((acc, k) => acc.concat(k.points.map(p => p[0])), []); ui.log("overall slot: " + slot.length + " curves, x from " + Math.min(...xs) + " to " + Math.max(...xs)); if (slot.length !== 4) ui.fail("expected 4 curves in the slot, got " + slot.length); if (Math.abs(Math.min(...xs) - 0) > 1e-6 || Math.abs(Math.max(...xs) - 25) > 1e-6) ui.fail("the slot does not span 0 to 25 overall") })()
# Center Point slot: middle (60,40), end centre (70,40), width 10 -> spans 45 to 75.
(() => { const t = Array.from(window.contentItem.children).find(c => c.objectName === "psTest"); if (!t.pick("slotModeBox", "Center Point")) ui.fail("no Center Point in the Slot type list") })()
ui.wait(300)
(() => { const t = Array.from(window.contentItem.children).find(c => c.objectName === "psTest"); t.clickAt([60, 40]); t.clickAt([70, 40]); t.moveTo([65, 45]) })()
ui.shot("/mnt/project-files/ux/sketch-slot-center-point.png")
(() => { const t = Array.from(window.contentItem.children).find(c => c.objectName === "psTest"); t.clickAt([65, 45]) })()
ui.wait(500)
(() => { const c = controller.execute("sketch.curves", { sketch: activeSketch.id }).result.curves; const slot = c.slice(16); const xs = slot.reduce((acc, k) => acc.concat(k.points.map(p => p[0])), []); ui.log("center point slot: " + slot.length + " curves, x from " + Math.min(...xs) + " to " + Math.max(...xs)); if (slot.length !== 4) ui.fail("expected 4 curves in the slot"); if (Math.abs(Math.min(...xs) - 45) > 1e-6 || Math.abs(Math.max(...xs) - 75) > 1e-6) ui.fail("the slot does not span 45 to 75 (end centres 50 and 70, half width 5): " + Math.min(...xs) + " .. " + Math.max(...xs)) })()
ui.log("Polygon and Slot types OK")
