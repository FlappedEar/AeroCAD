# CAD-273: Circle 2-Tangent also takes arcs and circles (Fusion): click a circle, a line, then a point the circle passes through.
# Run: AeroCAD --ui-script <this file>
Qt.createQmlObject('import QtQuick; Item { objectName: "ctTest"; visible: false; function at(q) { const o = viewport.sketchOverlay; const p = o.toScreen(q); return o.mapToItem(null, p.x, p.y) } function clickAt(q) { const w = at(q); ui.move(w.x, w.y); ui.wait(80); ui.click(w.x, w.y); ui.wait(200) } function curves() { return controller.execute("sketch.curves", { sketch: activeSketch.id }).result.curves } }', window.contentItem)
ui.wait(800)
(() => { window.createSketch({ plane: "XY" }); if (!window.activeSketch) ui.fail("no sketch") })()
ui.wait(500)
(() => { const r = controller.execute("sketch.add_curves", { sketch: activeSketch.id, curves: [{ type: "circle", center: [0, 0], radius: 10 }, { type: "line", start: [-60, -30], end: [100, -30] }] }); if (!r.ok) ui.fail("curves: " + r.error) })()
ui.wait(800)
(() => { viewport.restoreCameraState({ pivot: [20, -10, 0], pitch: -90, yaw: 0, distance: 160, orthographic: false }) })()
ui.wait(400)
(() => { if (!ui.clickText("CREATE")) ui.fail("no CREATE menu on the ribbon") })()
ui.wait(400)
(() => { if (!ui.clickText("2-Tangent Circle")) ui.fail("no 2-Tangent Circle in the CREATE menu") })()
ui.wait(300)
(() => { if (sketchTool !== "circle_2tangent") ui.fail("2-Tangent Circle did not start: " + sketchTool) })()
(() => { const t = Array.from(window.contentItem.children).find(c => c.objectName === "ctTest"); t.clickAt([0, 10]); t.clickAt([30, -30]) })()
ui.wait(300)
(() => { const t = Array.from(window.contentItem.children).find(c => c.objectName === "ctTest"); const w = t.at([30, -10]); ui.move(w.x, w.y); ui.wait(200) })()
ui.shot("sketch-circle-tangent-arcs-preview.png")
(() => { const t = Array.from(window.contentItem.children).find(c => c.objectName === "ctTest"); t.clickAt([30, -10]) })()
ui.wait(600)
(() => { const t = Array.from(window.contentItem.children).find(c => c.objectName === "ctTest"); const c = t.curves(); if (c.length !== 3) ui.fail("expected 3 curves, got " + c.length); const k = c[2]; const x = k.points[0][0], y = k.points[0][1], r = k.radius; const A = c[0], ax = A.points[0][0], ay = A.points[0][1]; const L = c[1].points; const lineDist = Math.abs((L[1][0] - L[0][0]) * (y - L[0][1]) - (L[1][1] - L[0][1]) * (x - L[0][0])) / Math.hypot(L[1][0] - L[0][0], L[1][1] - L[0][1]); const dA = Math.hypot(x - ax, y - ay); ui.log("circle at " + x.toFixed(3) + "," + y.toFixed(3) + " r " + r.toFixed(3) + " lineDist " + lineDist.toFixed(3) + " dA " + dA.toFixed(3) + " R " + A.radius); if (Math.abs(lineDist - r) > 1e-3) ui.fail("not tangent to the line"); if (Math.abs(dA - (A.radius + r)) > 1e-3 && Math.abs(dA - Math.abs(A.radius - r)) > 1e-3) ui.fail("not tangent to the circle"); if (Math.abs(Math.hypot(x - 30, y + 10) - r) > 1e-3) ui.fail("does not pass through the clicked point") })()
ui.shot("sketch-circle-tangent-arcs.png")
