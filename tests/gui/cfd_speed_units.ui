# SPDX-License-Identifier: GPL-3.0-or-later
# CAD-180: the wind tunnel speed takes km/h, mph and a decimal comma; the hint shows both units,
# and an invalid or too high speed is said under the field and disables Run CFD.
Qt.createQmlObject('import QtQuick; Item { objectName: "cfTest"; visible: false; function find(i, name) { if (!i) return null; if (i.objectName === name) return i; const ch = i.children || []; for (let k = 0; k < ch.length; ++k) { const r = find(ch[k], name); if (r) return r } return null } function runButton(i) { if (!i) return null; if (i.text === "Run CFD" && i.highlighted !== undefined) return i; const ch = i.children || []; for (let k = 0; k < ch.length; ++k) { const r = runButton(ch[k]); if (r) return r } return null } }', window.contentItem)
ui.wait(800)
(() => { const p = controller.execute("document.parts").result.parts[0]; window.selectPart(p.id) })()
ui.clickText("SIMULATE")
ui.wait(300)
ui.clickText("Wind Tunnel")
ui.wait(800)
(() => { simulationPanel.tab = 0 })()
ui.wait(300)
(() => { const t = Array.from(window.contentItem.children).find(c => c.objectName === "cfTest"); const h = t.find(simulationPanel, "cfdSpeedHint"); ui.log("DEFAULT " + h.text); if (h.text !== "= 20 m/s = 72 km/h") ui.fail("default hint: " + h.text) })()
(() => { const t = Array.from(window.contentItem.children).find(c => c.objectName === "cfTest"); const f = t.find(simulationPanel, "cfdSpeedField"); const p = f.mapToItem(null, f.width / 2, f.height / 2); ui.click(p.x, p.y); f.selectAll() })()
ui.type("200 km/h")
ui.wait(200)
(() => { const t = Array.from(window.contentItem.children).find(c => c.objectName === "cfTest"); const h = t.find(simulationPanel, "cfdSpeedHint"); const b = t.runButton(simulationPanel); const v = simulationPanel.runParams().speed; ui.log("KMH " + h.text + " speed " + v + " run " + b.enabled); if (h.text !== "= 55.56 m/s = 200 km/h" || v !== 55.5556 || !b.enabled) ui.fail("200 km/h") })()
ui.shot("cfd-speed-units.png")
(() => { const t = Array.from(window.contentItem.children).find(c => c.objectName === "cfTest"); t.find(simulationPanel, "cfdSpeedField").selectAll() })()
ui.type("20,5")
ui.wait(200)
(() => { const t = Array.from(window.contentItem.children).find(c => c.objectName === "cfTest"); const f = t.find(simulationPanel, "cfdSpeedField"); const v = simulationPanel.runParams().speed; ui.log("COMMA " + f.text + " -> " + v); if (f.text !== "20,5" || v !== 20.5) ui.fail("decimal comma") })()
(() => { const t = Array.from(window.contentItem.children).find(c => c.objectName === "cfTest"); t.find(simulationPanel, "cfdSpeedField").selectAll() })()
ui.type("100 mph")
ui.wait(200)
(() => { const v = simulationPanel.runParams().speed; ui.log("MPH " + v); if (v !== 44.704) ui.fail("mph") })()
(() => { const t = Array.from(window.contentItem.children).find(c => c.objectName === "cfTest"); t.find(simulationPanel, "cfdSpeedField").selectAll() })()
ui.type("abc")
ui.wait(200)
(() => { const t = Array.from(window.contentItem.children).find(c => c.objectName === "cfTest"); const h = t.find(simulationPanel, "cfdSpeedHint"); const b = t.runButton(simulationPanel); ui.log("BAD " + h.text + " run " + b.enabled); if (h.text.indexOf("Type a speed") !== 0 || b.enabled) ui.fail("invalid speed") })()
(() => { const t = Array.from(window.contentItem.children).find(c => c.objectName === "cfTest"); t.find(simulationPanel, "cfdSpeedField").selectAll() })()
ui.type("600 km/h")
ui.wait(200)
(() => { const t = Array.from(window.contentItem.children).find(c => c.objectName === "cfTest"); const h = t.find(simulationPanel, "cfdSpeedHint"); const b = t.runButton(simulationPanel); ui.log("HIGH " + h.text + " run " + b.enabled); if (h.text.indexOf("166.7 m/s is above 150 m/s") !== 0 || b.enabled) ui.fail("too high") })()
# A run at 200 km/h is stored as 55.5556 m/s and its settings come back exactly.
(() => { const p = controller.execute("document.parts").result.parts[0]; const r = controller.execute("simulation.run", { id: p.id, speed: simulationPanel.speedMs("200 km/h"), prepareOnly: true }); if (!r.ok) ui.fail("prepare: " + r.error); simulationPanel.refreshRuns(); simulationPanel.useSettingsOf(r.result.id); const t = Array.from(window.contentItem.children).find(c => c.objectName === "cfTest"); const f = t.find(simulationPanel, "cfdSpeedField"); ui.log("COPIED KMH " + f.text); if (f.text !== "55.5556") ui.fail("copied km/h run: " + f.text) })()
# A run's settings come back in m/s.
(() => { const p = controller.execute("document.parts").result.parts[0]; const r = controller.execute("simulation.run", { id: p.id, speed: 35, prepareOnly: true }); if (!r.ok) ui.fail("prepare: " + r.error); simulationPanel.refreshRuns(); if (!simulationPanel.useSettingsOf(r.result.id)) ui.fail("use settings") })()
ui.wait(200)
(() => { const t = Array.from(window.contentItem.children).find(c => c.objectName === "cfTest"); const h = t.find(simulationPanel, "cfdSpeedHint"); ui.log("COPIED " + h.text); if (h.text !== "= 35 m/s = 126 km/h") ui.fail("copied speed: " + h.text) })()
ui.log("cfd speed units done")
