# CAD-256: Sketch Ellipse (Fusion: Create > Ellipse) with real clicks: CREATE > Ellipse on
# the ribbon, click the centre, the end of the major axis and a point for the minor radius:
# one ellipse, a closed profile. Then one drawn with typed radii (major, Enter, minor,
# Enter), and the Dimension tool on an ellipse near its major axis end sets its major radius.
# Run: AeroCAD --ui-script <this file>
Qt.createQmlObject('import QtQuick; Item { objectName: "elTest"; visible: false; function at(q) { const o = viewport.sketchOverlay; const p = o.toScreen(q); return o.mapToItem(null, p.x, p.y) } function clickAt(q) { const w = at(q); ui.move(w.x, w.y); ui.wait(80); ui.click(w.x, w.y); ui.wait(150) } function moveTo(q) { const w = at(q); ui.move(w.x, w.y); ui.wait(150) } function sketch() { return controller.execute("sketch.curves", { sketch: activeSketch.id }).result } }', window.contentItem)
ui.wait(800)
(() => { window.createSketch({ plane: "XY" }); if (!window.activeSketch) ui.fail("no sketch") })()
ui.wait(800)
(() => { viewport.restoreCameraState({ pivot: [20, 0, 0], pitch: -90, yaw: 0, distance: 200, orthographic: false }) })()
ui.wait(400)
(() => { if (!ui.clickText("CREATE")) ui.fail("no CREATE menu on the ribbon") })()
ui.wait(400)
(() => { if (!ui.clickText("Ellipse")) ui.fail("no Ellipse in the CREATE menu") })()
ui.wait(300)
(() => { if (sketchTool !== "ellipse") ui.fail("Ellipse did not start: " + sketchTool) })()
(() => { const t = Array.from(window.contentItem.children).find(c => c.objectName === "elTest"); t.clickAt([0, 0]); t.clickAt([30, 0]); t.moveTo([10, 10]) })()
ui.shot("build/sketch-ellipse-preview.png")
(() => { const t = Array.from(window.contentItem.children).find(c => c.objectName === "elTest"); t.clickAt([10, 10]) })()
ui.wait(500)
(() => { const s = Array.from(window.contentItem.children).find(c => c.objectName === "elTest").sketch(); const c = s.curves; ui.log("curves " + JSON.stringify(c.map(k => [k.kind, k.center, k.majorRadius, k.minorRadius, k.angle])) + ", profiles " + controller.execute("sketch.profiles", { sketch: activeSketch.id }).result.profiles.length); if (c.length !== 1 || c[0].kind !== "ellipse") ui.fail("expected one ellipse"); else { if (Math.hypot(c[0].center[0], c[0].center[1]) > 1e-6 || Math.abs(c[0].majorRadius - 30) > 1e-6 || Math.abs(c[0].minorRadius - 10) > 1e-6 || Math.abs(c[0].angle) > 1e-6) ui.fail("not the ellipse clicked: " + JSON.stringify(c[0])) } if (controller.execute("sketch.profiles", { sketch: activeSketch.id }).result.profiles.length !== 1) ui.fail("the ellipse is not a profile") })()
# Typed radii: centre, 20 towards the cursor (straight up), then 8.
(() => { const t = Array.from(window.contentItem.children).find(c => c.objectName === "elTest"); t.clickAt([70, 0]); t.moveTo([70, 15]) })()
ui.type("20")
ui.key("Return")
ui.wait(300)
(() => { const t = Array.from(window.contentItem.children).find(c => c.objectName === "elTest"); t.moveTo([75, 10]) })()
ui.type("8")
ui.key("Return")
ui.wait(500)
(() => { const c = Array.from(window.contentItem.children).find(c => c.objectName === "elTest").sketch().curves; ui.log("typed " + JSON.stringify(c[1])); if (c.length !== 2 || c[1].kind !== "ellipse" || Math.abs(c[1].majorRadius - 20) > 1e-6 || Math.abs(c[1].minorRadius - 8) > 1e-6 || Math.abs(c[1].angle - 90) > 1e-6) ui.fail("the typed ellipse is not 20 x 8 upright") })()
ui.shot("/mnt/project-files/ux/sketch-ellipse.png")
# Dimension the first ellipse near the end of its major axis: its major radius, set to 35.
ui.key("Esc")
ui.wait(200)
ui.key("D")
ui.wait(200)
(() => { if (sketchTool !== "dimension") ui.fail("Dimension did not start: " + sketchTool) })()
(() => { const t = Array.from(window.contentItem.children).find(c => c.objectName === "elTest"); t.clickAt([-29.9, 1]) })()
ui.wait(300)
ui.key("A", "ctrl")
ui.type("35")
ui.key("Return")
ui.wait(600)
(() => { const s = Array.from(window.contentItem.children).find(c => c.objectName === "elTest").sketch(); ui.log("constraints " + JSON.stringify(s.constraints) + ", first " + JSON.stringify([s.curves[0].majorRadius, s.curves[0].minorRadius])); if (!s.constraints.some(k => k.type === "major_radius" && k.curve === 0)) ui.fail("no major radius dimension"); if (Math.abs(s.curves[0].majorRadius - 35) > 1e-6 || Math.abs(s.curves[0].minorRadius - 10) > 1e-6) ui.fail("the major radius did not become 35") })()
ui.shot("build/sketch-ellipse-dimension.png")
ui.log("Sketch Ellipse OK")
