# SPDX-License-Identifier: GPL-3.0-or-later
# CAD-90: commands from MCP, scripts and Undo/Redo must invalidate old GUI editing state.
# Run from build/src/app/gui-context (CMake writes reset.json and variants.json there).
ui.wait(800)
# A new project cannot inherit or accept a pending Box preview from the previous one.
ui.clickText("Box")
ui.wait(500)
(() => { if (!featureDialog.visible || !controller.previewActive()) ui.fail("Box preview did not open"); const r = controller.execute("project.new"); if (!r.ok) ui.fail(r.error) })()
ui.wait(600)
(() => { const parts = controller.execute("document.parts").result.parts; ui.log("MCP New: " + JSON.stringify({dialog:featureDialog.visible, preview:controller.previewActive(), parts:parts.length, dirty:controller.projectDirty})); if (featureDialog.visible || controller.previewActive() || parts.length || controller.projectDirty || controller.canUndo) ui.fail("New inherited the old editor or its preview") })()
ui.shot("context_1_new.png")
# Prepare a saved project with a deliberately non-default camera, then edit another one.
(() => { controller.execute("feature.box", {size:[40,40,40]}); const r = controller.execute("project.save", {path:"saved.aerocad", view:{pivot:[1,2,3], pitch:-17, yaw:29, distance:321, orthographic:true}}); if (!r.ok) ui.fail(r.error); controller.newProject() })()
ui.clickText("Box")
ui.wait(500)
# A missing file is not a context change. Keep the editor and restore its live preview.
(() => { const r = controller.execute("project.open", {path:"missing.aerocad"}); if (r.ok) ui.fail("missing project unexpectedly opened") })()
ui.wait(600)
(() => { if (!featureDialog.visible || !controller.previewActive() || controller.projectName !== "Untitled") ui.fail("failed Open discarded the current editor"); ui.log("failed Open retained the editor and its preview") })()
ui.shot("context_2_failed_open.png")
(() => { const r = controller.execute("project.open", {path:"saved.aerocad"}); if (!r.ok) ui.fail(r.error) })()
ui.wait(600)
(() => { const b = controller.execute("timeline.list").result.bodies; const c = viewport.cameraState(); ui.log("MCP Open: " + JSON.stringify({dialog:featureDialog.visible, bodies:b, camera:c})); if (featureDialog.visible || controller.previewActive() || b.length !== 1 || Math.abs(b[0].volume-64000)>0.1 || controller.projectDirty) ui.fail("Open inherited the old editor or changed the saved model"); if (JSON.stringify(c.pivot)!=="[1,2,3]" || c.pitch!==-17 || c.yaw!==29 || c.distance!==321 || !c.orthographic) ui.fail("Open did not restore the saved camera") })()
ui.shot("context_3_open.png")
# Opening from a script must keep the saved camera after the script-finished callback.
ui.clickText("Box")
ui.wait(500)
(() => { if (!controller.runScript("open.json")) ui.fail("open script failed") })()
ui.wait(500)
(() => { const c=viewport.cameraState(); if (featureDialog.visible || controller.previewActive() || c.distance!==321 || c.pitch!==-17 || c.yaw!==29 || JSON.stringify(c.pivot)!=="[1,2,3]") ui.fail("script Open retained an editor or replaced its saved camera") })()
# A failed script Open must preserve the existing camera and editor as well.
ui.clickText("Box")
ui.wait(500)
(() => { if (controller.runScript("missing.json")) ui.fail("missing project script unexpectedly succeeded") })()
ui.wait(500)
(() => { const c=viewport.cameraState(); if (!featureDialog.visible || !controller.previewActive() || c.distance!==321 || c.pitch!==-17 || c.yaw!==29) ui.fail("failed script Open discarded the editor or changed camera") })()
ui.clickText("Cancel")
# Sketch editing and unfinished selection/scan picks must also belong to one context.
(() => { const r = controller.execute("sketch.create", {plane:"XY", curves:[{type:"line", start:[0,0], end:[10,0]}]}); if (!r.ok) { ui.fail(r.error); return } window.enterSketch(r.result.id); viewport.tool="region"; window.pickingSketchPlane=true; scanPanel.calibratePoints=[[1,2,3]]; scanPanel.alignPoints=[[4,5,6]]; if (!window.activeSketch || !viewport.sketchSnapPoints.length) ui.fail("sketch setup failed") })()
(() => { const r = controller.execute("project.open", {path:"saved.aerocad"}); if (!r.ok) ui.fail(r.error) })()
ui.wait(500)
(() => { if (window.activeSketch || window.pickingSketchPlane || viewport.tool!=="navigate" || viewport.sketchSnapPoints.length || viewport.sketchCurves.length || scanPanel.calibratePoints.length || scanPanel.alignPoints.length) ui.fail("Open retained sketch or pick state"); const c=viewport.cameraState(); if (c.pitch!==-17 || c.yaw!==29 || c.distance!==321) ui.fail("sketch camera animation overrode the opened project camera"); ui.log("Open cleared sketch and pick state") })()
# Script execution uses the same boundary (not just the File menu / execute wrapper).
ui.clickText("Box")
ui.wait(500)
(() => { if (!controller.runScript("reset.json")) ui.fail("reset script failed") })()
ui.wait(600)
(() => { if (featureDialog.visible || controller.previewActive() || controller.execute("document.parts").result.parts.length || controller.projectDirty) ui.fail("script New inherited an editor"); ui.log("script New cleared the editor") })()
# A is a 20 mm box, B is 40 mm. Open the real timeline context-menu editor in A.
(() => { controller.execute("feature.box", {size:[20,20,20]}); controller.execute("variant.create", {name:"B"}); controller.execute("feature.edit", {id:1, params:{size:[40,40,40]}}); controller.execute("variant.activate", {variant:"A"}); viewport.fitAll() })()
(() => { function find(i) { if (i.visible && i.text==="Box1") return i; const children=i.children||[]; for (let n=0; n<children.length; ++n) { const f=find(children[n]); if(f) return f } return null } const chip=find(window.contentItem); if (!chip) { ui.fail("no Box timeline chip"); return } const p=chip.mapToItem(null,chip.width/2,chip.height/2); ui.click(p.x,p.y,"right") })()
ui.wait(150)
ui.clickText("Edit Feature")
ui.wait(500)
(() => { if (!featureDialog.visible || !controller.previewActive() || featureDialog.editId!==1) ui.fail("A editor did not open"); viewport.restoreCameraState({pivot:[8,7,6], pitch:-11, yaw:37, distance:234, orthographic:false}); const r=controller.execute("variant.activate", {variant:"B"}); if (!r.ok) ui.fail(r.error) })()
ui.wait(600)
(() => { const b=controller.execute("timeline.list").result.bodies; const c=viewport.cameraState(); ui.log("B after A editor: " + JSON.stringify({dialog:featureDialog.visible, preview:controller.previewActive(), bodies:b, camera:c})); if (featureDialog.visible || controller.previewActive() || controller.activeVariantName!=="B" || Math.abs(b[0].volume-64000)>0.1) ui.fail("A editor leaked into B"); if (c.distance!==234 || c.pitch!==-11 || c.yaw!==37 || JSON.stringify(c.pivot)!=="[8,7,6]") ui.fail("variant activation moved the camera") })()
ui.shot("context_4_variant.png")
# Undo/Redo may switch variant too. Both must close a newly opened pending editor.
ui.clickText("Box")
ui.wait(500)
controller.execute("edit.undo")
ui.wait(600)
(() => { const b=controller.execute("timeline.list").result.bodies; if (featureDialog.visible || controller.previewActive() || controller.activeVariantName!=="A" || Math.abs(b[0].volume-8000)>0.1) ui.fail("Undo variant switch retained an editor or changed A") })()
ui.clickText("Box")
ui.wait(500)
controller.execute("edit.redo")
ui.wait(600)
(() => { const b=controller.execute("timeline.list").result.bodies; if (featureDialog.visible || controller.previewActive() || controller.activeVariantName!=="B" || Math.abs(b[0].volume-64000)>0.1) ui.fail("Redo variant switch retained an editor or changed B"); ui.log("Undo/Redo closed pending editors and preserved both variants") })()
# A script can switch B -> A -> B before returning. Comparing only its final id misses it.
ui.clickText("Box")
ui.wait(500)
(() => { if (!controller.runScript("variants.json")) ui.fail("variant script failed") })()
ui.wait(600)
(() => { const b=controller.execute("timeline.list").result.bodies; if (featureDialog.visible || controller.previewActive() || controller.activeVariantName!=="B" || Math.abs(b[0].volume-64000)>0.1) ui.fail("script round trip retained an editor"); const c=viewport.cameraState(); if (c.pitch!==-11 || c.yaw!==37 || c.distance!==234) ui.fail("script variant switch moved camera"); ui.log("script B -> A -> B cleared the editor") })()
# An ordinary same-context edit/Undo must keep a valid pending editor (CAD-86).
ui.clickText("Box")
ui.wait(500)
controller.execute("variant.rename", {variant:"B", name:"B renamed"})
ui.wait(500)
controller.execute("edit.undo")
ui.wait(500)
(() => { if (!featureDialog.visible || !controller.previewActive() || controller.activeVariantName!=="B") ui.fail("same-context Undo discarded a valid editor"); ui.log("same-context edit/Undo retained the editor") })()
ui.clickText("Cancel")
ui.wait(300)
(() => { const b=controller.execute("timeline.list").result.bodies; if (b.length!==1 || Math.abs(b[0].volume-64000)>0.1 || controller.previewActive()) ui.fail("Cancel did not preserve the committed B model") })()
ui.shot("context_5_preserved_b.png")
# A sketch's pending 250 ms view animation must stop at a variant context boundary.
(() => { const r=controller.execute("sketch.create", {plane:"XY", curves:[{type:"line", start:[0,0], end:[10,0]}]}); if (!r.ok) { ui.fail(r.error); return } viewport.restoreCameraState({pivot:[8,7,6], pitch:-11, yaw:37, distance:234, orthographic:false}); window.enterSketch(r.result.id); const changed=controller.execute("variant.activate", {variant:"A"}); if (!changed.ok) ui.fail(changed.error); ui.log("sketch variant boundary: " + JSON.stringify(viewport.cameraState())) })()
ui.wait(500)
(() => { const c=viewport.cameraState(); const b=controller.execute("timeline.list").result.bodies; ui.log("sketch variant after animation interval: " + JSON.stringify(c)); if (c.pitch!==-11 || c.yaw!==37 || window.activeSketch || viewport.sketchSnapPoints.length || controller.activeVariantName!=="A" || b.length!==1 || Math.abs(b[0].volume-8000)>0.1) ui.fail("old sketch animation or editor survived a variant switch") })()
ui.shot("context_6_variant_camera.png")
# A live Move/Rotate preview belongs to the previous project too (CAD-97 integration).
(() => { controller.execute("project.new"); const r=controller.execute("feature.box", {size:[20,20,20]}); if (!r.ok) { ui.fail(r.error); return } const part=controller.execute("document.parts").result.parts.find(p => p.kind === "body"); window.selectPart(part.id) })()
ui.wait(200)
ui.key("M")
ui.wait(200)
(() => { if (!viewport.transformActive) { ui.fail("live transform did not start"); return } viewport.transformMove=Qt.vector3d(7,0,0); const r=controller.execute("project.new"); if (!r.ok) ui.fail(r.error) })()
ui.wait(500)
(() => { if (viewport.transformActive || transformPanel.visible || controller.execute("document.parts").result.parts.length || controller.projectDirty) ui.fail("New inherited the previous transform preview"); ui.log("New cancelled the old live transform") })()
ui.shot("context_7_transform_new.png")
