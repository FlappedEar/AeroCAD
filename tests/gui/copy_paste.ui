# Copy / Paste of parts (Fusion: Ctrl+C / Ctrl+V), with real keys:
#  - Ctrl+C on a body, Ctrl+V: a copy is added, selected and open in Move; dragging it and
#    Enter places it; the original stays;
#  - Esc right after Ctrl+V removes the pasted copy again (nothing pasted);
#  - a timeline body is copied as a fixed solid; Ctrl+C while a dialog's search field has the
#    focus does not copy the part.
# Run: AeroCAD --ui-script <this file>
Qt.createQmlObject('import QtQuick; Item { objectName: "cpTest"; visible: false; property var s: ({}); function parts() { return controller.execute("document.parts").result.parts.filter(p => p.kind === "body" || p.kind === "imported") } function find(i, name) { if (!i) return null; if (i.objectName === name) return i; const ch = i.children || []; for (let k = 0; k < ch.length; ++k) { const r = find(ch[k], name); if (r) return r } return null } }', window.contentItem)
ui.wait(800)
(() => { const t = Array.from(window.contentItem.children).find(c => c.objectName === "cpTest"); const r = controller.execute("feature.box", { size: [40, 30, 6] }); if (!r.ok) ui.fail("box: " + r.error); const b = t.parts()[0]; t.s.body = b; window.selectPart(b.id); viewport.fitAll(); viewport.forceActiveFocus() })()
ui.wait(300)
ui.key("C", "ctrl")
ui.key("V", "ctrl")
ui.wait(300)
(() => { const t = Array.from(window.contentItem.children).find(c => c.objectName === "cpTest"); const ps = t.parts(); ui.log("after Ctrl+C, Ctrl+V: parts " + ps.length + ", moving " + viewport.transformActive); if (ps.length !== 2) { ui.fail("Ctrl+V did not paste a copy"); return } const copy = ps.find(p => p.id !== t.s.body.id); t.s.copy = copy; if (window.selectedPartId !== copy.id) ui.fail("the pasted copy is not selected"); if (!viewport.transformActive || viewport.transformTarget.partId !== copy.id) ui.fail("the pasted copy is not open in Move"); if (copy.kind !== "imported") ui.fail("a timeline body was not copied as a fixed solid: " + copy.kind); viewport.transformMove = Qt.vector3d(60, 0, 0) })()
ui.key("Return")
ui.wait(300)
(() => { const t = Array.from(window.contentItem.children).find(c => c.objectName === "cpTest"); const ps = t.parts(); const copy = ps.find(p => p.id === t.s.copy.id); const body = ps.find(p => p.id === t.s.body.id); ui.log("placed copy min x " + copy.bounds.min[0].toFixed(2) + ", original min x " + body.bounds.min[0].toFixed(2)); if (Math.abs(copy.bounds.min[0] - body.bounds.min[0] - 60) > 1e-6) ui.fail("the copy was not placed 60 mm along X"); if (Math.abs(copy.bounds.size[2] - 6) > 1e-6) ui.fail("the copy lost its shape") })()
ui.shot("build/copy-paste-1.png")
# Esc right after a paste: nothing pasted.
ui.key("V", "ctrl")
ui.wait(300)
(() => { const t = Array.from(window.contentItem.children).find(c => c.objectName === "cpTest"); t.s.n = t.parts().length; if (t.s.n !== 3 || !viewport.transformActive) ui.fail("second paste did not start: " + t.s.n) })()
ui.key("Escape")
ui.wait(300)
(() => { const t = Array.from(window.contentItem.children).find(c => c.objectName === "cpTest"); const n = t.parts().length; ui.log("Esc after paste: parts " + n + ", undo: " + controller.undoText); if (n !== 2) ui.fail("Esc after Ctrl+V kept the pasted copy"); if (viewport.transformActive) ui.fail("Esc did not end Move") })()
# Ctrl+C in a text field copies its text, not the part.
(() => { const t = Array.from(window.contentItem.children).find(c => c.objectName === "cpTest"); window.selectPart(t.s.body.id); window.copiedPartId = 0; shortcutsDialog.open() })()
ui.wait(300)
(() => { ui.key("C", "ctrl") })()
ui.wait(200)
(() => { ui.log("Ctrl+C with the shortcut search field focused: copied part " + window.copiedPartId); if (window.copiedPartId) ui.fail("Ctrl+C in a text field copied the part"); shortcutsDialog.close() })()
