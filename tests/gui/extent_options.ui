# CAD-268: Extrude has a Start Offset and Revolve has Symmetric / Two Sides direction (Fusion).
# A 20 x 10 rectangle extruded 5 mm with Start Offset 7 spans z 7..12; a square revolved
# Symmetric by 90 degrees is a quarter ring centred on the sketch plane. Before, neither existed.
# Run: AeroCAD --ui-script <this file>
ui.wait(800)
(() => { const r = controller.execute("sketch.create", { plane: "XY", curves: [{ type: "rectangle", corner: [0, 0], width: 20, height: 10 }] }); if (!r.ok) ui.fail("sketch: " + r.error) })()
ui.wait(300)
(() => { viewport.restoreCameraState({ pivot: [10, 5, 8], pitch: -25, yaw: 30, distance: 140, orthographic: false }) })()
ui.wait(300)
(() => { if (!ui.clickText("SOLID")) ui.fail("no SOLID tab") })()
ui.wait(300)
(() => { if (!ui.clickText("Extrude")) ui.fail("no Extrude button") })()
ui.wait(800)
(() => { if (!ui.clickText("Start Offset")) ui.fail("no Start Offset field in the Extrude dialog") })()
(() => { const find = (item) => { if (!item) return null; if (item.field && item.field.key === "start_offset" && item.selectAll) return item; const kids = item.children || []; for (let i = 0; i < kids.length; ++i) { const r = find(kids[i]); if (r) return r } if (item.contentItem && item.contentItem !== item) return find(item.contentItem); return null }; const f = find(featureDialog.contentItem) || find(featureDialog); if (!f) { ui.fail("no start offset text field"); return } const p = f.mapToItem(null, f.width / 2, f.height / 2); ui.click(p.x, p.y) })()
ui.wait(200)
ui.key("A", "ctrl")
ui.type("7")
ui.key("Tab")
ui.wait(800)
(() => { const v = featureDialog.values; if (Number(v.start_offset) !== 7) ui.fail("the typed start offset is not in the dialog values: " + v.start_offset) })()
(() => { featureDialog.setValue("distance", 5) })()
ui.wait(500)
ui.shot("extrude-start-offset.png")
(() => { if (!ui.clickText("OK")) ui.fail("no OK button") })()
ui.wait(800)
(() => { const tl = controller.execute("timeline.list").result; const b = tl.bodies[0]; const ex = tl.features.find(f => f.type === "extrude"); ui.log("body volume " + (b && b.volume.toFixed(1))); if (!b || Math.abs(b.volume - 1000) > 0.5) ui.fail("wrong extrusion volume"); if (!ex || Number(ex.params.start_offset) !== 7) ui.fail("the extrude does not store start_offset 7") })()
(() => { const r = controller.execute("sketch.create", { plane: "XZ", curves: [{ type: "rectangle", corner: [40, 0], width: 10, height: 10 }] }); if (!r.ok) ui.fail("revolve sketch: " + r.error) })()
ui.wait(300)
(() => { if (!ui.clickText("Revolve")) ui.fail("no Revolve button") })()
ui.wait(800)
(() => { featureDialog.setValue("extent", "symmetric"); featureDialog.setValue("angle", 90); featureDialog.setValue("axis", "Z") })()
ui.wait(800)
ui.shot("revolve-symmetric.png")
(() => { if (!ui.clickText("OK")) ui.fail("no OK button") })()
ui.wait(800)
(() => { const tl = controller.execute("timeline.list").result; const b = tl.bodies[tl.bodies.length - 1]; const expected = Math.PI * (50 * 50 - 40 * 40) * 10 / 4; ui.log("revolve volume " + (b && b.volume.toFixed(1)) + " expected " + expected.toFixed(1)); if (!b || Math.abs(b.volume - expected) > expected * 1e-3) ui.fail("wrong symmetric revolve volume"); const rv = tl.features.find(f => f.type === "revolve"); if (!rv || rv.params.extent !== "symmetric") ui.fail("the revolve does not store extent symmetric") })()
(() => { const r = controller.execute("sketch.create", { plane: "XZ", curves: [{ type: "rectangle", corner: [40, 20], width: 10, height: 10 }] }); if (!r.ok) ui.fail("second revolve sketch: " + r.error) })()
ui.wait(300)
(() => { if (!ui.clickText("Revolve")) ui.fail("no Revolve button") })()
ui.wait(800)
# Two Sides: picking it must not leave the default full turn in place (it would not fit).
(() => { featureDialog.setValue("extent", "two_sides"); featureDialog.setValue("angle2", 60); featureDialog.setValue("axis", "Z") })()
ui.wait(800)
(() => { const v = featureDialog.values; ui.log("two sides angles " + v.angle + " / " + v.angle2); if (Number(v.angle) + Number(v.angle2) > 360) ui.fail("Two Sides keeps an angle that cannot fit: " + v.angle); if (featureDialog.error) ui.fail("Two Sides shows an error: " + featureDialog.error) })()
(() => { if (!ui.clickText("OK")) ui.fail("no OK button") })()
ui.wait(800)
(() => { const tl = controller.execute("timeline.list").result; const b = tl.bodies[tl.bodies.length - 1]; const expected = Math.PI * (50 * 50 - 40 * 40) * 10 * 150 / 360; ui.log("two sides volume " + (b && b.volume.toFixed(1)) + " expected " + expected.toFixed(1)); if (!b || Math.abs(b.volume - expected) > expected * 1e-3) ui.fail("wrong Two Sides revolve volume") })()
