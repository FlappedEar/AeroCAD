# SPDX-License-Identifier: GPL-3.0-or-later
# CAD-132: once an outline is drawn on a scan, the scan's guide marks step 1 done and offers
# Part on surface (for that sketch) as the next step. CAD-131: the part made on the scan
# offers Export for printing as its next step, and it writes the part.
ui.wait(1200)
(() => { const p = controller.execute("document.parts").result.parts[0]; window.selectPart(p.id) })()
ui.wait(300)
(() => { const g = contextActions.guide(window.selectionInfo); const s = g.sections[0].steps; if (s[0].done) ui.fail("outline step done before drawing"); if (s[1].actions[0].id !== "partOnSurface" || s[1].actions[0].enabled) ui.fail("Part on surface should be shown but off before drawing"); if (contextActions.nextAction(window.selectionInfo).id !== "sketchOnScan") ui.fail("next step is not Sketch on the scan") })()
ui.clickText("Sketch on the scan")
ui.wait(500)
(() => { const b = window.selectionInfo; const top = Qt.vector3d(b.center[0], b.center[1], b.center[2] + b.sizeZ / 2); const v = viewport.viewPoint(top); const c = viewport.mapToItem(null, v.x, v.y); ui.click(c.x, c.y) })()
ui.wait(1500)
(() => { if (!window.activeSketch || !window.activeSketch.surfacePart) ui.fail("no sketch on the scan") })()
ui.key("R")
ui.wait(300)
(() => { const v = viewport.viewPoint(Qt.vector3d(window.activeSketch.origin[0], window.activeSketch.origin[1], window.activeSketch.origin[2])); const c = viewport.mapToItem(null, v.x, v.y); ui.drag(c.x - 60, c.y - 40, c.x + 60, c.y + 40, "left", "", 12) })()
ui.wait(600)
ui.clickText("Finish Sketch")
ui.wait(800)
ui.clickText("Not now")
ui.wait(500)
(() => { const info = window.selectionInfo; if (info.kind !== "imported") { ui.fail("the scan is not selected after Finish Sketch: " + info.kind); return } const g = contextActions.guide(info); const s = g.sections[0].steps; ui.log("STEPS " + JSON.stringify(s.map(t => [t.title, t.done, t.actions.map(a => a.id + (a.enabled ? "" : "-off"))]))); if (!s[0].done) ui.fail("outline step not done after drawing"); const p = s[1].actions[0]; if (!p.enabled || !p.primary) ui.fail("Part on surface is not the enabled next step"); if (contextActions.nextAction(info).id !== "partOnSurface") ui.fail("context bar does not suggest Part on surface"); if (p.params[0].key !== "sketch" || p.params[0].options.length !== 1) ui.fail("the drawn sketch is not offered") })()
ui.shot("scan-guide-after-outline.png")
(() => { const act = window.selectionActions.find(a => a.id === "partOnSurface"); actionPopup.request(act, window.selectionInfo, null) })()
ui.wait(400)
ui.key("Return")
ui.wait(4000)
(() => { const info = window.selectionInfo; if (info.kind !== "body") { ui.fail("the new part is not selected: " + info.kind); return } const n = contextActions.nextAction(info); ui.log("NEXT " + (n ? n.id : "none")); if (!n || n.id !== "sketchOnFace") ui.fail("Sketch on a face is not the next step of the part: " + (n ? n.id : "none")); if (window.currentRibbonTab !== "solid") ui.fail("the SOLID tab did not open for the new part: " + window.currentRibbonTab); const g = contextActions.guide(info); const titles = g.sections.map(x => x.title + (x.collapsed ? "*" : "")); ui.log("SECTIONS " + titles.join(" | ")); if (titles[0] !== "Design on this part" || !g.sections.some(x => x.collapsed)) ui.fail("the part guide is not the design guide with folded tools: " + titles) })()
# CAD-293: the part lies inside the scan, so the scan is hidden for the part to show (and be pickable).
(() => { const parts = controller.execute("document.parts").result.parts; const scan = parts.find(p => p.kind === "imported"); if (!scan || scan.visible) ui.fail("the scan still covers the new part") })()
ui.shot("part-on-scan-design.png")
ui.shot("/mnt/project-files/ux/part-design-centre.png")
# Create Sketch offers the part just made (CAD-268): its button starts a sketch on it.
(() => { if (!window.pickingSketchPlane) window.startCreateSketch(); if (!window.pickingSketchPlane) ui.fail("Create Sketch did not open") })()
ui.wait(300)
ui.shot("/mnt/project-files/ux/create-sketch-on-part.png")
(() => { const find = (it) => { if (it.objectName === "sketchOnPartButton") return it; for (const c of Array.from(it.children ?? [])) { const r = find(c); if (r) return r } return null }; const btn = find(window.contentItem); if (!btn || !btn.visible) ui.fail("no On part button"); const cb = (function f(it) { if (it.objectName === "sketchAcross") return it; for (const c of Array.from(it.children ?? [])) { const r = f(c); if (r) return r } return null })(window.contentItem); cb.checked = true; if (btn.visible) ui.fail("the On part button is offered for a fin"); cb.checked = false; if (!btn.visible) ui.fail("the On part button did not come back") })()
(() => { if (!ui.clickText("On Sketch1 part")) ui.fail("no 'On Sketch1 part' button in Create Sketch") })()
ui.wait(1200)
(() => { if (controller.statusMessage.indexOf("Sketch on Sketch1 part") !== 0) ui.fail("the status does not name the part: " + controller.statusMessage) })()
(() => { if (!window.activeSketch) ui.fail("the sketch on the part did not start") ; else { const n = window.activeSketch.normal, d = viewport.viewerDirection(); const dot = n[0] * d[0] + n[1] * d[1] + n[2] * d[2]; ui.log("SKETCH ON PART " + JSON.stringify(n) + " facing the viewer " + dot.toFixed(2)); if (dot <= 0) ui.fail("the sketch on the part faces away from the viewer") } })()
ui.key("R")
ui.wait(300)
(() => { const v = viewport.viewPoint(Qt.vector3d(window.activeSketch.origin[0], window.activeSketch.origin[1], window.activeSketch.origin[2])); const c = viewport.mapToItem(null, v.x, v.y); ui.drag(c.x - 30, c.y - 20, c.x + 30, c.y + 20, "left", "", 12) })()
ui.wait(600)
ui.clickText("Finish Sketch")
ui.wait(800)
# A sketch drawn on the part is for Extrude: no Part on surface offer (CAD-296), the sketch's
# guide leads with Extrude and keeps the wrap as the other way.
(() => { if (window.partOnSurfaceSketch) ui.fail("Part on surface is offered after a sketch on the part"); const sk = controller.execute("document.parts").result.parts.filter(p => p.kind === "sketch").pop(); const g = contextActions.guide(controller.partInfo(sk.id)); const next = contextActions.nextAction(controller.partInfo(sk.id)); ui.log("SKETCH GUIDE " + JSON.stringify(g.sections[0].steps.map(t => t.title)) + " next " + (next ? next.id : "none")); if (!next || next.id !== "extrude") ui.fail("the sketch on the part does not lead with Extrude: " + (next ? next.id : "none")); if (!g.sections[0].steps.some(t => t.actions.some(a => a.id === "partOnSurface"))) ui.fail("the wrap is not offered as the other way"); if (!g.sections[0].steps.some(t => t.actions.some(a => a.id === "partOnSurface" && a.text === "Extrude along surface"))) ui.fail("the wrap is not named Extrude along surface") })()
# The outline drawn on the part wraps onto its curved face (CAD-293): a new part that hugs the
# visible skin, outside it (to add an emboss or a rib).
(() => { const parts0 = controller.execute("document.parts").result.parts; const base = parts0.find(p => p.kind === "body"); const sk = controller.execute("timeline.list").result.features.filter(f => f.type === "sketch").pop(); const r = controller.execute("surface.part_from_sketch", { sketch: sk.id, thickness: 2, side: "outside" }); if (!r.ok) { ui.fail("the outline on the part did not wrap onto it: " + r.error); return } const b = r.result.bounds, bb = base.bounds; ui.log("WRAP " + JSON.stringify([b.min[2], b.max[2], bb.max[2]])); if (!(r.result.volume > 1) || !(b.max[2] > bb.max[2] - 1e-6)) ui.fail("the wrapped part is not on top of the part: " + JSON.stringify([b, bb])) })()
ui.log("create sketch on part done")
# A fin stands across the part's surface (CAD-298): Fin across the surface, click the part, draw
# the side view, Finish Sketch offers Fin on surface, and the fin is made on the part.
(() => { window.startCreateSketch(); const find = (it) => { if (it.objectName === "sketchAcross") return it; for (const c of Array.from(it.children ?? [])) { const r = find(c); if (r) return r } return null }; find(window.contentItem).checked = true })()
ui.wait(300)
(() => { const b = controller.execute("document.parts").result.parts.find(p => p.kind === "body" && p.name === "Sketch1 part"); const top = Qt.vector3d((b.bounds.min[0] + b.bounds.max[0]) / 2, (b.bounds.min[1] + b.bounds.max[1]) / 2, b.bounds.max[2]); const v = viewport.viewPoint(top); const c = viewport.mapToItem(null, v.x, v.y); ui.click(c.x, c.y) })()
ui.wait(1200)
(() => { if (!window.activeSketch || !window.activeSketch.across) ui.fail("no fin sketch on the part: " + JSON.stringify(window.activeSketch)) })()
ui.key("R")
ui.wait(300)
(() => { const o = window.activeSketch.origin, v = viewport.viewPoint(Qt.vector3d(o[0], o[1], o[2])); const c = viewport.mapToItem(null, v.x, v.y); ui.drag(c.x - 20, c.y - 40, c.x + 20, c.y + 5, "left", "", 12) })()
ui.wait(600)
ui.clickText("Finish Sketch")
ui.wait(800)
(() => { if (!window.partOnSurfaceSketch || !window.partOnSurfaceSketch.across) ui.fail("Fin on surface is not offered after the fin sketch on the part") })()
(() => { const sk = controller.execute("timeline.list").result.features.filter(f => f.type === "sketch").pop(); const f = controller.execute("surface.fin_from_sketch", { sketch: sk.id, thickness: 1.5 }); if (!f.ok) { ui.fail("no fin on the part: " + f.error); return } ui.log("FIN ON PART " + f.result.volume) })()
ui.wait(500)
# The wrapped part overlaps the part (the export check would ask): hide it, print the part.
(() => { for (const p of controller.execute("document.parts").result.parts) if (p.kind === "body" && p.name !== "Sketch1 part") controller.execute("part.set_visible", { id: p.id, visible: false }) })()
ui.wait(300)
# The guide's button opens the print folder picker; accept it with a folder (/tmp: Linux and macOS CI).
ui.clickText("Export for printing…")
ui.wait(500)
(() => { if (!printFolderDialog.visible) ui.fail("Export for printing did not open the folder picker") })()
printFolderDialog.selectedFolder = "file:///tmp/aerocad-scan-to-part-print"
printFolderDialog.accept()
ui.wait(2000)
(() => { const m = controller.statusMessage; ui.log("PRINT " + m); if (!/^1 part\(s\) written/.test(m)) ui.fail("the part was not exported for printing: " + m) })()
ui.log("scan to part next steps done")
