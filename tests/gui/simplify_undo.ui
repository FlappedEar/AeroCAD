# CAD-105: Simplify on a scan is undone in the same session with Ctrl+Z, also when the
# viewport draws the scan at a reduced level of detail (budget below the scan's size).
ui.wait(1200)
scan.triangleBudget = 5000
(() => { const p = controller.execute("document.parts").result.parts[0]; window.selectPart(p.id); ui.log("ORIGINAL " + p.triangles) })()
ui.wait(1500)
(() => { const p = controller.execute("document.parts").result.parts[0]; const d = scan.displayedTriangles(p.id); ui.log("DISPLAYED " + d); if (!d || d > 5000) ui.fail("expected a reduced display, got " + d) })()
(() => { const act = window.selectionActions.find(a => a.id === "simplify"); if (!act || !act.enabled) { ui.fail("Simplify not offered"); return } actionPopup.request(act, window.selectionInfo, null) })()
ui.wait(400)
(() => { if (!actionPopup.opened) ui.fail("Simplify asks for the triangle count") })()
ui.key("Return")
ui.wait(800)
(() => { const p = controller.execute("document.parts").result.parts[0]; ui.log("SIMPLIFIED " + p.triangles); if (p.triangles >= 9375) ui.fail("Simplify did not reduce the mesh"); if (controller.undoText.indexOf("Decimate") !== 0) ui.fail("undo offers " + controller.undoText) })()
ui.key("Z", "ctrl")
ui.wait(1500)
(() => { const p = controller.execute("document.parts").result.parts[0]; const d = scan.displayedTriangles(p.id); ui.log("UNDONE " + p.triangles + " displayed " + d); if (p.triangles !== 9375) ui.fail("Undo did not restore the full mesh: " + p.triangles); if (!d || d > 5000) ui.fail("display after Undo: " + d); const s = controller.execute("mesh.stats", {id: p.id}); if (!s.ok || s.result.triangles !== 9375) ui.fail("stats after Undo") })()
ui.shot("simplify-undone.png")
ui.key("Y", "ctrl")
ui.wait(800)
(() => { const p = controller.execute("document.parts").result.parts[0]; ui.log("REDONE " + p.triangles); if (p.triangles >= 9375) ui.fail("Redo did not simplify again") })()
ui.log("simplify undo done")
