# CAD-271: Modify > Scale on a body with Non-Uniform factors (Fusion). A 20 x 10 x 5 block
# scaled X 2, Z 0.5 is 40 x 10 x 2.5. Done through the Scale dialog (SOLID tab > Scale).
# Run: AeroCAD --ui-script <this file>
ui.wait(800)
(() => { let r = controller.execute("sketch.create", { plane: "XY", curves: [{ type: "rectangle", corner: [0, 0], width: 20, height: 10 }] }); if (!r.ok) ui.fail("sketch: " + r.error); r = controller.execute("feature.extrude", { sketch: r.result.id, distance: 5 }); if (!r.ok) ui.fail("extrude: " + r.error) })()
ui.wait(300)
(() => { viewport.restoreCameraState({ pivot: [10, 5, 2], pitch: -25, yaw: 30, distance: 140, orthographic: false }) })()
ui.wait(300)
(() => { if (!ui.clickText("SOLID")) ui.fail("no SOLID tab") })()
ui.wait(300)
(() => { if (!ui.clickText("MODIFY")) ui.log("no MODIFY caption (buttons are visible)") })()
ui.wait(300)
(() => { if (!ui.clickText("Scale")) ui.fail("no Scale button") })()
ui.wait(800)
(() => { featureDialog.setValue("scaleType", "non_uniform") })()
ui.wait(300)
(() => { featureDialog.setValue("factor_x", 2); featureDialog.setValue("factor_z", 0.5) })()
ui.wait(800)
ui.shot("scale-non-uniform.png")
(() => { if (!ui.clickText("OK")) ui.fail("no OK button") })()
ui.wait(800)
(() => { const tl = controller.execute("timeline.list").result; const b = tl.bodies[0]; ui.log("volume " + b.volume.toFixed(2)); if (Math.abs(b.volume - 1000) > 0.5) ui.fail("wrong scaled volume " + b.volume); const f = tl.features.find(x => x.type === "scale"); if (!f || Number(f.params.factor_x) !== 2 || f.params.factor !== undefined) ui.fail("the scale feature does not store factor_x 2 only: " + JSON.stringify(f && f.params)) })()
