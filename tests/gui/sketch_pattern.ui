# CAD-251: Sketch Circular and Rectangular Pattern (Fusion: Create > Circular / Rectangular Pattern)
# with real clicks:
#  - select a circle, CREATE > Circular Pattern on the ribbon, click the centre, raise the count to 6
#    with the Up key, OK: five copies around the centre (one undo);
#  - select the rectangle's sides, right-click > Rectangular Pattern, 3 columns 15 apart and
#    2 rows, Enter: five copies in rows and columns.
# Run: AeroCAD --ui-script <this file>
Qt.createQmlObject('import QtQuick; Item { objectName: "spTest"; visible: false; function find(i, name) { if (!i) return null; if (i.objectName === name && i.visible) return i; const ch = i.children || []; for (let k = 0; k < ch.length; ++k) { const r = find(ch[k], name); if (r) return r } return null } function at(q) { const o = viewport.sketchOverlay; const p = o.toScreen(q); return o.mapToItem(null, p.x, p.y) } function clickItem(name) { const f = find(viewport.sketchOverlay, name); if (!f) { ui.fail("no " + name); return } const p = f.mapToItem(null, f.width / 2, f.height / 2); ui.click(p.x, p.y) } function curves() { return controller.execute("sketch.curves", { sketch: activeSketch.id }).result.curves } }', window.contentItem)
ui.wait(800)
(() => { const r = controller.execute("sketch.create", { plane: "XY", curves: [{ type: "rectangle", corner: [-40, -30], width: 10, height: 8 }, { type: "circle", center: [30, 0], radius: 4 }, { type: "point", at: [0, 0] }] }); if (!r.ok) ui.fail("sketch: " + r.error) })()
ui.wait(300)
(() => { enterSketch(controller.execute("timeline.list").result.features[0].id) })()
ui.wait(800)
ui.key("Esc")
ui.wait(300)
(() => { viewport.restoreCameraState({ pivot: [0, -5, 0], pitch: -90, yaw: 0, distance: 220, orthographic: false }) })()
ui.wait(400)
# 1. Circular: select the circle, start from the ribbon, click the centre point.
(() => { const w = Array.from(window.contentItem.children).find(c => c.objectName === "spTest").at([34, 0]); ui.click(w.x, w.y) })()
ui.wait(300)
(() => { if (JSON.stringify(viewport.sketchOverlay.selectedCurves) !== "[4]") ui.fail("the circle was not selected: " + JSON.stringify(viewport.sketchOverlay.selectedCurves)) })()
(() => { if (!ui.clickText("CREATE")) ui.fail("no CREATE menu on the ribbon") })()
ui.wait(400)
(() => { if (!ui.clickText("Circular Pattern")) ui.fail("no Circular Pattern in the CREATE menu") })()
ui.wait(300)
(() => { const o = viewport.sketchOverlay; if (sketchTool !== "circular_pattern" || o.patternCurves.length !== 1) ui.fail("Circular Pattern did not start on the circle: " + sketchTool); const ok = Array.from(window.contentItem.children).find(c => c.objectName === "spTest").find(o, "sketchPatternOk"); if (!ok || ok.enabled) ui.fail("OK is enabled before the centre is picked") })()
(() => { const w = Array.from(window.contentItem.children).find(c => c.objectName === "spTest").at([0.4, 0.3]); ui.move(w.x, w.y); ui.wait(100); ui.click(w.x, w.y) })()
ui.wait(300)
(() => { const c = viewport.sketchOverlay.patternCenter; ui.log("centre " + JSON.stringify(c)); if (!c || Math.hypot(c[0], c[1]) > 1e-6) ui.fail("the centre did not snap to the point at the origin") })()
(() => { Array.from(window.contentItem.children).find(c => c.objectName === "spTest").clickItem("sketchPatternCount") })()
ui.wait(200)
ui.key("Up")
ui.key("Up")
ui.key("Up")
ui.wait(300)
(() => { ui.log("count " + viewport.sketchOverlay.patternCount); if (viewport.sketchOverlay.patternCount !== 6) ui.fail("the count did not go up to 6") })()
ui.shot("/mnt/project-files/ux/sketch-circular-pattern-preview.png")
(() => { Array.from(window.contentItem.children).find(c => c.objectName === "spTest").clickItem("sketchPatternOk") })()
ui.wait(600)
(() => { const c = Array.from(window.contentItem.children).find(c => c.objectName === "spTest").curves(); ui.log("curves " + c.length + ", first copy " + JSON.stringify(c[6] && c[6].points[0]) + ", undo '" + controller.undoText + "'"); if (c.length !== 6 + 5) ui.fail("expected 5 copies: " + c.length); if (Math.hypot(c[6].points[0][0] - 15, c[6].points[0][1] - 30 * Math.sin(Math.PI / 3)) > 1e-6) ui.fail("the first copy is not 60 degrees round"); if (sketchTool !== "") ui.fail("the tool stays after OK") })()
ui.shot("/mnt/project-files/ux/sketch-circular-pattern.png")
(() => { undoAction.trigger() })()
ui.wait(500)
(() => { const n = Array.from(window.contentItem.children).find(c => c.objectName === "spTest").curves().length; if (n !== 6) ui.fail("one undo did not remove the copies: " + n) })()
# 2. Rectangular: the rectangle's sides, right-click > Rectangular Pattern.
(() => { const t = Array.from(window.contentItem.children).find(c => c.objectName === "spTest"); [[-35, -30], [-30, -26], [-35, -22], [-40, -26]].forEach((q, i) => { const w = t.at(q); ui.click(w.x, w.y, "left", i ? "shift" : "") }) })()
ui.wait(300)
(() => { if (viewport.sketchOverlay.selectedCurves.length !== 4) ui.fail("expected the 4 sides selected: " + JSON.stringify(viewport.sketchOverlay.selectedCurves)) })()
(() => { const w = Array.from(window.contentItem.children).find(c => c.objectName === "spTest").at([-30, -26]); ui.click(w.x, w.y, "right") })()
ui.wait(400)
(() => { if (!ui.clickText("Rectangular Pattern")) ui.fail("no Rectangular Pattern in the sketch menu") })()
ui.wait(300)
(() => { const o = viewport.sketchOverlay; ui.log("spacing " + o.patternSpacingX + ", " + o.patternSpacingY); if (sketchTool !== "rectangular_pattern" || o.patternCurves.length !== 4) ui.fail("Rectangular Pattern did not start on the 4 sides: " + sketchTool); if (o.patternSpacingX !== 15 || o.patternSpacingY !== 12) ui.fail("the default spacing is not 1.5 times the size") })()
# Columns stay 3 (the default), 2 rows; Enter in the row spacing field applies.
(() => { Array.from(window.contentItem.children).find(c => c.objectName === "spTest").clickItem("sketchPatternRows") })()
ui.wait(200)
ui.key("Up")
ui.wait(200)
(() => { Array.from(window.contentItem.children).find(c => c.objectName === "spTest").clickItem("sketchPatternRowSpacing") })()
ui.wait(200)
ui.key("A", "ctrl")
ui.type("20")
ui.wait(300)
ui.shot("/mnt/project-files/ux/sketch-rectangular-pattern-preview.png")
ui.key("Return")
ui.wait(600)
(() => { const c = Array.from(window.contentItem.children).find(c => c.objectName === "spTest").curves(); ui.log("curves " + c.length + ", last copy starts " + JSON.stringify(c[c.length - 4] && c[c.length - 4].points[0])); if (c.length !== 6 + 5 * 4) ui.fail("expected 5 copies of the 4 sides: " + c.length); if (Math.hypot(c[c.length - 4].points[0][0] + 10, c[c.length - 4].points[0][1] + 10) > 1e-6) ui.fail("the last copy is not 2 columns right and 1 row up"); if (sketchTool !== "") ui.fail("the tool stays after Enter") })()
(() => { const p = controller.execute("sketch.profiles", { sketch: activeSketch.id }).result; ui.log("profiles " + p.profiles.length); if (p.profiles.length !== 7) ui.fail("expected 6 rectangles and the circle as profiles: " + p.profiles.length) })()
ui.shot("/mnt/project-files/ux/sketch-rectangular-pattern.png")
ui.log("sketch patterns OK")
