# Plane at Angle about a picked edge or construction axis (Fusion: Construct > Plane at Angle).
# Run: AeroCAD --ui-script <this file>
ui.wait(800)
(() => { const r = controller.execute("feature.box", { corner: [30, -5, 0], size: [10, 10, 10] }); if (!r.ok) ui.fail("box: " + r.error) })()
(() => { const r = controller.execute("feature.axis", { from: [0, 0, 0], to: [0, 0, 10] }); if (!r.ok) ui.fail("axis: " + r.error) })()
ui.wait(300)
(() => { viewport.restoreCameraState({ pivot: [10, 0, 5], pitch: -30, yaw: 20, distance: 220, orthographic: false }) })()
ui.wait(300)
(() => { featureDialog.open("plane") })()
ui.wait(500)
(() => { featureDialog.setValue("offset", 0); featureDialog.setValue("angle", 45); featureDialog.setValue("turnAbout", "pick") })()
ui.wait(300)
(() => { featureDialog.pickKey = "about" })()
ui.wait(300)
(() => { const p = viewport.viewPoint(Qt.vector3d(0, 0, 5)); const w = viewport.mapToItem(null, p.x, p.y); ui.click(w.x, w.y) })()
ui.wait(800)
(() => { const ax = controller.execute("timeline.list").result.features.find(x => x.type === "axis"); const v = featureDialog.values.about; ui.log("about pick " + JSON.stringify(v)); if (!v || v.feature !== ax.id) ui.fail("clicking the axis did not pick it") })()
(() => { if (featureDialog.error) ui.fail("plane error: " + featureDialog.error) })()
ui.shot("plane-about.png")
(() => { if (!ui.clickText("OK")) ui.fail("no OK button") })()
ui.wait(800)
(() => { const pl = controller.execute("timeline.list").result.features.find(x => x.type === "plane"); if (!pl) ui.fail("no plane in the timeline"); ui.log("plane " + JSON.stringify(pl)); if (pl.params.about === undefined || pl.params.axis !== undefined) ui.fail("the plane did not store the picked line: " + JSON.stringify(pl.params)) })()
# Reopening keeps the mode and the line.
(() => { const pl = controller.execute("timeline.list").result.features.find(x => x.type === "plane"); featureDialog.open("plane", pl.params, pl.id) })()
ui.wait(500)
(() => { if (featureDialog.values.turnAbout !== "pick") ui.fail("reopened plane lost its mode: " + featureDialog.values.turnAbout); if (featureDialog.error) ui.fail("edit error: " + featureDialog.error) })()
(() => { if (!ui.clickText("OK")) ui.fail("no OK button") })()
ui.wait(500)
(() => { controller.execute("edit.undo"); controller.execute("edit.undo"); const tl = controller.execute("timeline.list").result; if (tl.features.some(x => x.type === "plane")) ui.fail("undo did not remove the plane") })()
