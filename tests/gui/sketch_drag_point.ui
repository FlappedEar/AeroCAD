# CAD-123: in a sketch with no tool, dragging a point moves it and the solver moves what
# its constraints leave free (Fusion). A length dimension keeps holding; one undo step.
# Run: AeroCAD --ui-script <this file>
ui.wait(800)
(() => { const r = controller.execute("sketch.create", { plane: "XY", curves: [{ type: "rectangle", corner: [0, 0], width: 40, height: 20 }], constraints: [{ type: "length", curve: 0, value: 40 }] }); if (!r.ok) ui.fail("sketch: " + r.error) })()
ui.wait(300)
(() => { enterSketch(controller.execute("timeline.list").result.features[0].id) })()
ui.wait(800)
ui.key("Esc")
ui.wait(300)
(() => { if (sketchTool !== "") ui.fail("Esc kept the tool " + sketchTool) })()
# Drag the top-right corner (40, 20) up to (40, 30).
(() => { const o = viewport.sketchOverlay; const a = o.mapToItem(null, o.toScreen([40, 20]).x, o.toScreen([40, 20]).y); const b = o.mapToItem(null, o.toScreen([40, 30]).x, o.toScreen([40, 30]).y); ui.drag(a.x, a.y, b.x, b.y, "left", "", 10) })()
ui.wait(500)
(() => { const r = controller.execute("sketch.curves", { sketch: activeSketch.id }).result; const right = r.curves[1].points; const bottom = r.curves[0].points; ui.log("right side " + JSON.stringify(right) + " bottom " + JSON.stringify(bottom)); if (Math.abs(right[1][1] - 30) > 0.01) ui.fail("corner did not go to y = 30: " + right[1][1]); if (Math.abs(Math.abs(bottom[1][0] - bottom[0][0]) - 40) > 1e-4) ui.fail("the 40 mm length did not hold"); if (Math.abs(right[0][0] - right[1][0]) > 1e-6) ui.fail("the right side is no longer vertical") })()
ui.shot("sketch-drag-point.png")
# Dragging sideways: the length holds, so the whole rectangle moves.
(() => { const o = viewport.sketchOverlay; const a = o.mapToItem(null, o.toScreen([40, 30]).x, o.toScreen([40, 30]).y); const b = o.mapToItem(null, o.toScreen([50, 30]).x, o.toScreen([50, 30]).y); ui.drag(a.x, a.y, b.x, b.y, "left", "", 10) })()
ui.wait(500)
(() => { const r = controller.execute("sketch.curves", { sketch: activeSketch.id }).result; const bottom = r.curves[0].points; ui.log("bottom " + JSON.stringify(bottom)); if (Math.abs(bottom[1][0] - 50) > 0.01 || Math.abs(bottom[1][0] - bottom[0][0] - 40) > 1e-4) ui.fail("sideways drag: expected the rectangle at x 10..50, got " + JSON.stringify(bottom)); if (r.constraints.length !== 1) ui.fail("the drag left constraints: " + r.constraints.length) })()
# One undo step per drag.
(() => { controller.execute("edit.undo"); const r = controller.execute("sketch.curves", { sketch: activeSketch.id }).result; if (Math.abs(r.curves[0].points[1][0] - 40) > 0.01) ui.fail("undo did not take back one drag: " + JSON.stringify(r.curves[0].points)) })()
