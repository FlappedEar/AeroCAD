# CAD-284: Construction Axis (Fusion: Construct > Axis). The dialog makes an axis through two points,
# a Circular Pattern turns a box about it, and reopening the axis keeps its mode.
# Run: AeroCAD --ui-script <this file>
ui.wait(800)
(() => { const r = controller.execute("feature.box", { corner: [30, -5, 0], size: [10, 10, 10] }); if (!r.ok) ui.fail("box: " + r.error) })()
ui.wait(300)
(() => { viewport.restoreCameraState({ pivot: [10, 0, 5], pitch: -30, yaw: 20, distance: 220, orthographic: false }) })()
ui.wait(300)
(() => { if (!ui.clickText("SOLID")) ui.fail("no SOLID tab") })()
ui.wait(300)
(() => { if (!ui.clickText("Axis")) ui.fail("no Axis command in the CONSTRUCT group") })()
ui.wait(800)
(() => { if (featureDialog.type !== "axis") ui.fail("the Axis button did not open the dialog: " + featureDialog.type) })()
(() => { featureDialog.setValue("mode", "points"); featureDialog.setValue("from", [0, 0, 0]); featureDialog.setValue("to", [0, 0, 10]) })()
ui.wait(800)
ui.shot("axis-dialog.png")
(() => { if (featureDialog.error) ui.fail("dialog error: " + featureDialog.error) })()
(() => { if (!ui.clickText("OK")) ui.fail("no OK button") })()
ui.wait(800)
(() => { const f = controller.execute("timeline.list").result.features.find(x => x.type === "axis"); if (!f) ui.fail("no axis feature in the timeline"); ui.log("axis " + JSON.stringify(f)) })()
# A circular pattern turns the box about the new axis (picked in the dialog's list).
(() => { featureDialog.open("circular_pattern", { body: controller.execute("timeline.list").result.bodies[0].id }) })()
ui.wait(500)
(() => { const parts = controller.execute("document.parts").result.parts; if (!parts.some(p => p.kind === "axis")) ui.fail("the axis is not a part in the view: " + JSON.stringify(parts.map(p => p.kind))) })()
(() => { featureDialog.pickKey = "axis" })()
ui.wait(300)
# Click the axis itself (a thin bar from z = -25 to 25 at the origin).
(() => { const p = viewport.viewPoint(Qt.vector3d(0, 0, 5)); const w = viewport.mapToItem(null, p.x, p.y); ui.click(w.x, w.y) })()
ui.wait(800)
(() => { const ax = controller.execute("timeline.list").result.features.find(x => x.type === "axis"); const v = featureDialog.values.axis; ui.log("axis pick " + JSON.stringify(v)); if (!v || v.feature !== ax.id) ui.fail("clicking the axis did not pick it"); featureDialog.setValue("count", 4); featureDialog.setValue("operation", "new_body") })()
ui.wait(800)
(() => { if (featureDialog.error) ui.fail("pattern error: " + featureDialog.error) })()
ui.shot("axis-pattern.png")
(() => { if (!ui.clickText("OK")) ui.fail("no OK button") })()
ui.wait(800)
(() => { const tl = controller.execute("timeline.list").result; const last = tl.bodies[tl.bodies.length - 1]; ui.log("bounds " + JSON.stringify(last.bounds)); if (last.bounds.min.x > -39 || last.bounds.max.x < 39 || last.bounds.min.y > -39) ui.fail("the copies do not surround the axis") })()
# Reopening the axis keeps its mode (points) and values.
(() => { const ax = controller.execute("timeline.list").result.features.find(x => x.type === "axis"); featureDialog.open("axis", ax.params, ax.id) })()
ui.wait(500)
(() => { if (featureDialog.values.mode !== "points") ui.fail("reopened axis lost its mode: " + featureDialog.values.mode); if (featureDialog.error) ui.fail("edit error: " + featureDialog.error) })()
(() => { if (!ui.clickText("OK")) ui.fail("no OK button") })()
ui.wait(500)
(() => { controller.execute("edit.undo"); controller.execute("edit.undo"); controller.execute("edit.undo"); const tl = controller.execute("timeline.list").result; if (tl.features.some(x => x.type === "axis" || x.type === "circular_pattern")) ui.fail("undo did not remove the steps") })()

# Clicking a cylinder face in the Axis dialog keeps the face as the definition (the axis follows the body), and reopening it works.
(() => { let r = controller.execute("feature.cylinder", { center: [60, 0, 0], radius: 8, height: 30 }); if (!r.ok) ui.fail("cylinder: " + r.error) })()
ui.wait(300)
(() => { featureDialog.open("axis") })()
ui.wait(500)
(() => { featureDialog.pickKey = "line" })()
ui.wait(300)
(() => { const p = viewport.viewPoint(Qt.vector3d(68, 0, 15)); const w = viewport.mapToItem(null, p.x, p.y); ui.click(w.x, w.y) })()
ui.wait(1000)
(() => { const v = featureDialog.values; ui.log("face pick " + JSON.stringify(v)); if (!v.face || v.face.body === undefined) ui.fail("the clicked cylinder face was not kept as a face reference: " + JSON.stringify(v)) })()
(() => { if (!ui.clickText("OK")) ui.fail("no OK button") })()
ui.wait(800)
(() => { const f = controller.execute("timeline.list").result.features.filter(x => x.type === "axis").pop(); ui.log("face axis " + JSON.stringify(f)); if (!f.params.face || f.params.line !== undefined) ui.fail("the axis stored a snapshot instead of the face: " + JSON.stringify(f.params)); featureDialog.open("axis", f.params, f.id) })()
ui.wait(500)
(() => { if (featureDialog.error) ui.fail("reopen error: " + featureDialog.error) })()
(() => { if (!ui.clickText("OK")) ui.fail("no OK button") })()
ui.wait(800)
(() => { const f = controller.execute("timeline.list").result.features.filter(x => x.type === "axis").pop(); if (f.status !== "ok") ui.fail("the reopened axis is " + f.status) })()
