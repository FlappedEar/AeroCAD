# CAD-183: Sphere and Torus (Fusion: Create > Sphere / Torus) with real clicks:
#  - Create > Sphere opens the dialog; a typed diameter and OK make a ball (one undo step);
#  - Create > Torus makes a ring; a tube wider than the ring gives a clear error.
# Run: AeroCAD --ui-script <this file>
Qt.createQmlObject('import QtQuick; Item { objectName: "stTest"; visible: false; function vols() { return controller.execute("timeline.list").result.bodies.map(b => b.volume) } }', window.contentItem)
ui.wait(800)
(() => { if (!ui.clickText("Create")) ui.fail("no Create menu") })()
ui.wait(400)
(() => { if (!ui.clickText("Sphere")) ui.fail("no Sphere in the Create menu") })()
ui.wait(500)
(() => { ui.log("dialog " + featureDialog.visible + " type " + featureDialog.type + " diameter " + featureDialog.values.diameter); if (!featureDialog.visible || featureDialog.type !== "sphere") ui.fail("Sphere did not open"); if (Array.from(window.contentItem.children).find(c => c.objectName === "stTest").vols().length !== 1) ui.fail("no live preview") })()
(() => { featureDialog.setValue("diameter", 30) })()
ui.wait(600)
ui.shot("build/sphere-preview.png")
(() => { if (!ui.clickText("OK")) ui.fail("no OK button") })()
ui.wait(800)
(() => { const v = Array.from(window.contentItem.children).find(c => c.objectName === "stTest").vols(); const want = 4 / 3 * Math.PI * 15 * 15 * 15; ui.log("after OK: " + JSON.stringify(v) + " (want " + want + "), undo '" + controller.undoText + "'"); if (v.length !== 1 || Math.abs(v[0] - want) > 1) ui.fail("no ball of diameter 30") })()
(() => { viewport.fitAll() })()
ui.wait(300)
ui.shot("build/sphere.png")
(() => { undoAction.trigger() })()
ui.wait(500)
(() => { const v = Array.from(window.contentItem.children).find(c => c.objectName === "stTest").vols(); ui.log("Ctrl+Z: " + JSON.stringify(v)); if (v.length !== 0) ui.fail("one undo did not remove the ball") })()
(() => { if (!ui.clickText("Create")) ui.fail("no Create menu") })()
ui.wait(400)
(() => { if (!ui.clickText("Torus")) ui.fail("no Torus in the Create menu") })()
ui.wait(500)
(() => { ui.log("dialog " + featureDialog.type + " ring " + featureDialog.values.diameter + " tube " + featureDialog.values.tube_diameter); if (featureDialog.type !== "torus") ui.fail("Torus did not open") })()
(() => { featureDialog.setValue("tube_diameter", 50) })()
ui.wait(600)
(() => { ui.log("wide tube: '" + featureDialog.error + "'"); if (!/tube does not fit/.test(featureDialog.error)) ui.fail("no clear error for a tube wider than the ring") })()
(() => { featureDialog.setValue("tube_diameter", 10) })()
ui.wait(600)
(() => { if (!ui.clickText("OK")) ui.fail("no OK button") })()
ui.wait(800)
(() => { const v = Array.from(window.contentItem.children).find(c => c.objectName === "stTest").vols(); const want = 2 * Math.PI * Math.PI * 20 * 25; ui.log("torus: " + JSON.stringify(v) + " (want " + want + ")"); if (v.length !== 1 || Math.abs(v[0] - want) > 1) ui.fail("no ring 40 x 10") })()
(() => { viewport.fitAll() })()
ui.wait(300)
ui.shot("build/torus.png")
ui.log("sphere torus OK")
