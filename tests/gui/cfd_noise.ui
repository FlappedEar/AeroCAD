# CAD-191: Results show how far drag, lift and side still swing over the averaging window, and the
# A/B table marks a difference inside the swing of A plus B as "noise". Injected data, no engine.
Qt.createQmlObject('import QtQuick; Item { objectName: "cfTest"; visible: false; function find(i, name) { if (!i) return null; if (i.objectName === name) return i; const ch = i.children || []; for (let k = 0; k < ch.length; ++k) { const r = find(ch[k], name); if (r) return r } return null } }', window.contentItem)
ui.wait(800)
ui.clickText("SIMULATE")
ui.wait(300)
ui.clickText("Wind Tunnel")
ui.wait(800)
(() => { simulationPanel.tab = 1; simulationPanel.results = { summary: { dragN: 30, liftN: -96, sideN: 0.5, cd: 0.25, cl: -0.8, cs: 0.004, pressureDragN: 24, viscousDragN: 6, iterations: 500, spread: { dragN: 0.15, liftN: 0.4, sideN: 0.02, cd: 0.00125, cl: 0.0033, cs: 0.0002 } }, finalResults: { available: true, reasons: [] }, quality: { status: "ok", checks: {} }, conditions: { settings: { speed: 40, flowDirection: "+X", mesh: "coarse", ground: false }, referenceArea: 0.012, openfoam: "2406" }, fields: {}, history: { iteration: [1, 2], cd: [0.3, 0.25], cl: [-0.7, -0.8] } } })()
ui.wait(500)
(() => { const t = Array.from(window.contentItem.children).find(c => c.objectName === "cfTest"); const text = n => { const i = t.find(simulationPanel, n); if (!i || !i.visible) ui.fail(n + " is not shown"); ui.log(n + ": " + i.text); return i.text }; if (text("cfdSummaryDrag") !== "30.000 ± 0.150 N") ui.fail("drag swing"); if (text("cfdSummaryLift") !== "-96.000 ± 0.400 N (downforce)") ui.fail("lift swing") })()
ui.clickText("0.500 ± 0.020 N")
ui.shot("cfd-noise-results.png")
# Older runs without a spread: no ± at all.
(() => { const r = JSON.parse(JSON.stringify(simulationPanel.results)); delete r.summary.spread; simulationPanel.results = r })()
ui.wait(300)
(() => { const t = Array.from(window.contentItem.children).find(c => c.objectName === "cfTest"); const d = t.find(simulationPanel, "cfdSummaryDrag").text; if (d !== "30.000 N") ui.fail("drag without spread: " + d) })()
# A/B: the drag difference is inside the swing, the lift difference is not; equal steady values are no noise.
(() => { simulationPanel.runs = [{ id: "r2", created: "2026-11-09T01:32:17Z", state: "finished", source: { label: "B", partName: "box" } }, { id: "r1", created: "2026-11-09T01:31:31Z", state: "finished", source: { label: "A", partName: "box" } }]; simulationPanel.comparison = { a: "r1", b: "r2", verdict: "comparable", states: { a: "finished", b: "finished" }, forces: { dragN: { a: 30, b: 30.12, difference: 0.12, percent: 0.4, noise: 0.29, withinNoise: true }, liftN: { a: -96, b: -99, difference: -3, percent: -3.13, noise: 0.8, withinNoise: false }, sideN: { a: 0.5, b: 0.5, difference: 0, percent: 0, noise: 0, withinNoise: true } }, differingConditions: [], unknownConditions: [], reasons: [], notes: ["The drag difference (+0.12 N) is within the iteration swing of the runs (±0.29 N): it may be noise, not a real change."], meshSensitivity: { status: "not assessed", levels: [] }, quality: { a: { status: "ok" }, b: { status: "ok" } } }; simulationPanel.tab = 2 })()
ui.wait(600)
(() => { const d = simulationPanel.abRow("dragN"), l = simulationPanel.abRow("liftN"), s = simulationPanel.abRow("sideN"); ui.log("ROWS " + JSON.stringify([d, l, s])); if (!d.withinNoise || l.withinNoise || s.withinNoise) ui.fail("within-noise flags") })()
ui.clickText("noise")
ui.clickText("-3.1")
ui.clickText("⚠ The drag difference (+0.12 N) is within the iteration swing of the runs (±0.29 N): it may be noise, not a real change.")
ui.shot("cfd-noise-ab.png")
ui.log("cfd noise done")
