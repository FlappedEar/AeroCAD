# Loft to a point (Fusion: a sketch point ends a loft): a disk, and a sketch of one point 30 mm above it,
# drawn with the Point tool. The Loft dialog lists both sketches; ticking them in order gives a cone.
# The point is placed below the hint card (an oblique cone has the same volume, a third of base times height).
# Run: AeroCAD --ui-script <this file>
Qt.createQmlObject('import QtQuick; Item { objectName: "lpTest"; visible: false; function at(q) { const o = viewport.sketchOverlay; const p = o.toScreen(q); return o.mapToItem(null, p.x, p.y) } function clickAt(q) { const w = at(q); ui.move(w.x, w.y); ui.wait(80); ui.click(w.x, w.y); ui.wait(150) } }', window.contentItem)
ui.wait(800)
(() => { const r = controller.execute("sketch.create", { plane: "XY", curves: [{ type: "circle", center: [0, 0], radius: 10 }] }); if (!r.ok) ui.fail("disk: " + r.error) })()
ui.wait(300)
(() => { window.createSketch({ plane: "XY", offset: 30 }); if (!window.activeSketch) ui.fail("no sketch") })()
ui.wait(800)
(() => { viewport.restoreCameraState({ pivot: [0, 0, 30], pitch: -90, yaw: 0, distance: 120, orthographic: false }) })()
ui.wait(400)
(() => { window.sketchTool_("point") })()
ui.wait(200)
(() => { const t = Array.from(window.contentItem.children).find(c => c.objectName === "lpTest"); t.clickAt([0, -30]) })()
ui.wait(500)
(() => { const c = controller.execute("sketch.curves", { sketch: activeSketch.id }).result.curves; ui.log("curves " + JSON.stringify(c.map(k => [k.kind, k.points[0]]))); if (c.length !== 1 || c[0].kind !== "point") ui.fail("expected one point") })()
(() => { window.sketchTool_("") })()
(() => { window.finishSketch() })()
ui.wait(500)
(() => { viewport.restoreCameraState({ pivot: [0, 0, 15], pitch: -25, yaw: 30, distance: 120, orthographic: false }) })()
(() => { featureDialog.open("loft") })()
ui.wait(500)
(() => { if (featureDialog.type !== "loft") ui.fail("wrong dialog: " + featureDialog.type) })()
(() => { const sk = controller.execute("timeline.list").result.features.filter(f => f.type === "sketch"); ui.log("sketches " + JSON.stringify(sk.map(f => f.name))); if (!ui.clickText(sk[0].name)) ui.fail("no " + sk[0].name + " in the dialog"); })()
ui.wait(300)
(() => { const sk = controller.execute("timeline.list").result.features.filter(f => f.type === "sketch"); if (!ui.clickText(sk[1].name)) ui.fail("no " + sk[1].name + " in the dialog") })()
ui.wait(1000)
(() => { if (featureDialog.error) ui.fail("dialog error: " + featureDialog.error); ui.log("sections " + JSON.stringify(featureDialog.values.sections)) })()
(() => { const b = controller.execute("timeline.list").result.bodies[0]; const want = Math.PI * 100 * 30 / 3; ui.log("preview volume " + (b && b.volume) + " want " + want); if (!b || Math.abs(b.volume - want) > want * 0.01) ui.fail("preview volume " + (b && b.volume)) })()
ui.shot("build/loft-point.png")
(() => { if (!ui.clickText("OK")) ui.fail("no OK button") })()
ui.wait(800)
(() => { const tl = controller.execute("timeline.list").result; const f = tl.features.find(x => x.type === "loft"); if (!f || f.status !== "ok") ui.fail("no loft step: " + JSON.stringify(f)); if (tl.bodies.length !== 1) ui.fail("expected one body, got " + tl.bodies.length); const top = tl.bodies[0].bounds.max[2]; if (Math.abs(top - 30) > 0.01) ui.fail("the apex is at z " + top + ", expected 30 (the sketch plane offset)") })()
(() => { for (let i = 0; i < 4; ++i) controller.execute("edit.undo"); if (controller.execute("timeline.list").result.features.some(x => x.type === "loft")) ui.fail("undo did not remove the loft") })()
ui.log("Loft to a point OK")
