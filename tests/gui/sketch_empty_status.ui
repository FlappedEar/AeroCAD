# CAD-249: an empty sketch shows no "Fully constrained" status (as in Fusion); the
# degrees-of-freedom line appears once something is drawn.
# Run: AeroCAD --ui-script <this file>
Qt.createQmlObject('import QtQuick; Item { objectName: "seTest"; visible: false; function find(i, name) { if (!i) return null; if (i.objectName === name) return i; const ch = i.children || []; for (let k = 0; k < ch.length; ++k) { const r = find(ch[k], name); if (r) return r } return null } function status() { return find(viewport.sketchOverlay, "sketchDofStatus") } }', window.contentItem)
ui.wait(800)
(() => { window.createSketch({ plane: "XY" }); if (!window.activeSketch) ui.fail("no sketch") })()
ui.wait(800)
(() => { const s = Array.from(window.contentItem.children).find(c => c.objectName === "seTest").status(); if (!s) ui.fail("no status label"); ui.log("empty sketch: dof " + viewport.sketchOverlay.degreesOfFreedom + ", status visible " + s.visible + " '" + s.text + "'"); if (s.visible) ui.fail("an empty sketch shows a status: " + s.text) })()
ui.shot("/mnt/project-files/ux/sketch-empty-status.png")
# Draw a line: the status shows its degrees of freedom.
(() => { const r = controller.execute("sketch.add_curves", { sketch: activeSketch.id, curves: [{ type: "line", start: [-20, 0], end: [20, 0] }] }); if (!r.ok) ui.fail("add line: " + r.error) })()
ui.wait(600)
(() => { const s = Array.from(window.contentItem.children).find(c => c.objectName === "seTest").status(); ui.log("one line: status visible " + s.visible + " '" + s.text + "'"); if (!s.visible) ui.fail("no status after drawing a line"); if (s.text.indexOf("4") < 0) ui.fail("a free line should have 4 degrees of freedom: " + s.text) })()
# Fix it: "Fully constrained" now shows.
(() => { const r = controller.execute("sketch.add_constraints", { sketch: activeSketch.id, constraints: [{ type: "fix", curve: 0 }] }); if (!r.ok) ui.fail("fix: " + r.error) })()
ui.wait(600)
(() => { const s = Array.from(window.contentItem.children).find(c => c.objectName === "seTest").status(); ui.log("fixed line: status visible " + s.visible + " '" + s.text + "'"); if (!s.visible || s.text !== "Fully constrained") ui.fail("a fixed line is not shown as fully constrained: " + s.text) })()
ui.wait(200)
