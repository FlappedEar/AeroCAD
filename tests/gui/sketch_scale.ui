# CAD-253: Sketch Scale (Fusion: Modify > Sketch Scale) with real clicks and keys:
#  - select a dimensioned circle, right-click > Sketch Scale, type 2 (previewed), Enter: it
#    doubles about its middle and its diameter dimension follows (one undo);
#  - select the rectangle's sides, MODIFY > Sketch Scale on the ribbon, click a corner (it
#    snaps), type 0.5, Enter: the rectangle halves towards that corner.
# Run: AeroCAD --ui-script <this file>
Qt.createQmlObject('import QtQuick; Item { objectName: "ssTest"; visible: false; function at(q) { const o = viewport.sketchOverlay; const p = o.toScreen(q); return o.mapToItem(null, p.x, p.y) } function sketch() { return controller.execute("sketch.curves", { sketch: activeSketch.id }).result } }', window.contentItem)
ui.wait(800)
(() => { const r = controller.execute("sketch.create", { plane: "XY", curves: [{ type: "rectangle", corner: [-20, -10], width: 40, height: 20 }, { type: "circle", center: [40, 0], radius: 4 }], constraints: [{ type: "diameter", curve: 4, value: 8 }] }); if (!r.ok) ui.fail("sketch: " + r.error) })()
ui.wait(300)
(() => { enterSketch(controller.execute("timeline.list").result.features[0].id) })()
ui.wait(800)
ui.key("Esc")
ui.wait(300)
(() => { viewport.restoreCameraState({ pivot: [10, 0, 0], pitch: -90, yaw: 0, distance: 200, orthographic: false }) })()
ui.wait(400)
# 1. The circle: select it, right-click > Sketch Scale, type 2, Enter.
(() => { const w = Array.from(window.contentItem.children).find(c => c.objectName === "ssTest").at([44, 0]); ui.click(w.x, w.y) })()
ui.wait(300)
(() => { if (JSON.stringify(viewport.sketchOverlay.selectedCurves) !== "[4]") ui.fail("the circle was not selected: " + JSON.stringify(viewport.sketchOverlay.selectedCurves)) })()
(() => { const w = Array.from(window.contentItem.children).find(c => c.objectName === "ssTest").at([44, 0]); ui.click(w.x, w.y, "right") })()
ui.wait(400)
(() => { if (!ui.clickText("Sketch Scale")) ui.fail("no Sketch Scale in the sketch menu") })()
ui.wait(300)
(() => { if (sketchTool !== "scale" || viewport.sketchOverlay.scaleCurves.length !== 1) ui.fail("Sketch Scale did not start on the circle: " + sketchTool) })()
ui.type("2")
ui.wait(300)
(() => { ui.log("preview factor " + viewport.sketchOverlay.scaleFactor); if (viewport.sketchOverlay.scaleFactor !== 2) ui.fail("typing 2 did not preview a factor of 2") })()
ui.shot("/mnt/project-files/ux/sketch-scale-preview.png")
ui.key("Return")
ui.wait(600)
(() => { const s = Array.from(window.contentItem.children).find(c => c.objectName === "ssTest").sketch(); const c = s.curves[4]; const d = s.constraints[0]; ui.log("circle at " + JSON.stringify(c.points[0]) + " r " + c.radius + ", diameter " + d.value + ", undo '" + controller.undoText + "'"); if (Math.abs(c.radius - 8) > 1e-6) ui.fail("the circle did not double"); if (Math.hypot(c.points[0][0] - 40, c.points[0][1]) > 1e-6) ui.fail("the circle's middle moved"); if (Math.abs(d.value - 16) > 1e-9) ui.fail("the diameter dimension did not follow"); if (sketchTool !== "") ui.fail("the tool stays after Enter") })()
(() => { undoAction.trigger() })()
ui.wait(500)
(() => { const r = Array.from(window.contentItem.children).find(c => c.objectName === "ssTest").sketch().curves[4].radius; if (Math.abs(r - 4) > 1e-6) ui.fail("one undo did not bring the circle back: " + r) })()
# 2. The rectangle: its 4 sides, MODIFY > Sketch Scale, click the lower left corner, 0.5, Enter.
(() => { const t = Array.from(window.contentItem.children).find(c => c.objectName === "ssTest"); [[0, -10], [20, 0], [0, 10], [-20, 0]].forEach((q, i) => { const w = t.at(q); ui.click(w.x, w.y, "left", i ? "shift" : "") }) })()
ui.wait(300)
(() => { if (viewport.sketchOverlay.selectedCurves.length !== 4) ui.fail("expected the 4 sides selected: " + JSON.stringify(viewport.sketchOverlay.selectedCurves)) })()
(() => { if (!ui.clickText("MODIFY")) ui.fail("no MODIFY menu on the ribbon") })()
ui.wait(400)
(() => { if (!ui.clickText("Sketch Scale")) ui.fail("no Sketch Scale in the MODIFY menu") })()
ui.wait(300)
(() => { if (sketchTool !== "scale" || viewport.sketchOverlay.scaleCurves.length !== 4) ui.fail("Sketch Scale did not start on the 4 sides: " + sketchTool) })()
(() => { const w = Array.from(window.contentItem.children).find(c => c.objectName === "ssTest").at([-19.6, -9.7]); ui.move(w.x, w.y); ui.wait(100); ui.click(w.x, w.y) })()
ui.wait(300)
(() => { const p = viewport.sketchOverlay.scalePoint; ui.log("point " + JSON.stringify(p)); if (!p || Math.hypot(p[0] + 20, p[1] + 10) > 1e-6) ui.fail("the point did not snap to the corner") })()
ui.type("0.5")
ui.wait(300)
ui.key("Return")
ui.wait(600)
(() => { const c = Array.from(window.contentItem.children).find(c => c.objectName === "ssTest").sketch().curves; ui.log("sides " + JSON.stringify(c.slice(0, 4).map(k => k.points))); if (Math.hypot(c[0].points[0][0] + 20, c[0].points[0][1] + 10) > 1e-6) ui.fail("the corner that stays moved"); if (Math.hypot(c[1].points[1][0], c[1].points[1][1]) > 1e-6) ui.fail("the far corner is not halfway, at (0, 0)") })()
ui.shot("/mnt/project-files/ux/sketch-scale.png")
ui.log("Sketch Scale OK")
