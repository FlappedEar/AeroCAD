# CAD-42: consent belongs to one open project, including unnamed projects. Mouse clicks
# grant consent; commands and the same controller routes used by menus replace projects.
# CTest prepares isolated settings containing the legacy mcp/enabled=true preference.
# Run in a writable empty directory: AeroCAD --ui-script <this file>
ui.wait(300)
controller.autosaveSeconds = 0
if (controller.mcp.enabled || controller.mcp.listening || controller.mcp.clients.length) ui.fail("startup inherited a global grant")
ui.log("startup: disabled; target=" + controller.mcp.projectTarget)
ui.clickText("TOOLS")
ui.wait(150)
ui.clickText("Agent")
ui.wait(150)
ui.clickText("Allow AI agents to use this project")
ui.wait(150)
if (!controller.mcp.enabled) ui.fail("mouse consent was not granted")
ui.log("consent enabled; listening=" + controller.mcp.listening + "; error=" + controller.mcp.errorString)
mcpPanel.close()
(() => { const r = controller.execute("feature.box", {size: [30, 20, 10]}); if (!r.ok) ui.fail(r.error) })()
(() => { const r = controller.execute("project.save", {path: "CAD42-A.aerocad"}); if (!r.ok) ui.fail(r.error) })()
if (!controller.mcp.enabled || controller.mcp.projectTarget.indexOf("CAD42-A.aerocad") < 0) ui.fail("Save As lost consent or failed to rename its target")
(() => { const r = controller.execute("project.save", {path: "CAD42-recovery.aerocad", copy: true}); if (!r.ok) ui.fail(r.error) })()
if (controller.openPath("CAD42-missing.aerocad")) ui.fail("missing project unexpectedly opened")
if (!controller.mcp.enabled) ui.fail("failed Open revoked valid consent")
ui.log("Save As and failed Open retain consent for " + controller.mcp.projectTarget)
controller.newProject()
if (controller.mcp.enabled || controller.mcp.listening || controller.mcp.clients.length) ui.fail("New retained access")
ui.clickText("Agent")
ui.wait(150)
ui.log("after New: enabled=" + controller.mcp.enabled + "; target=" + controller.mcp.projectTarget)
ui.shot("cad42-after-new.png")
ui.clickText("Allow AI agents to use this project")
ui.wait(150)
if (!controller.mcp.enabled) ui.fail("new project cannot receive explicit consent")
mcpPanel.close()
if (!controller.openPath("CAD42-A.aerocad")) ui.fail("valid Open failed")
if (controller.mcp.enabled || controller.mcp.listening || controller.mcp.clients.length) ui.fail("Open retained access")
ui.clickText("Agent")
ui.wait(150)
ui.log("after Open: enabled=" + controller.mcp.enabled + "; target=" + controller.mcp.projectTarget)
ui.shot("cad42-after-open.png")
ui.clickText("Allow AI agents to use this project")
ui.wait(150)
mcpPanel.close()
if (!controller.recoverAutosave("CAD42-recovery.aerocad")) ui.fail("recovery failed")
if (controller.mcp.enabled || controller.mcp.listening || controller.mcp.clients.length) ui.fail("recovery retained access")
ui.clickText("Agent")
ui.wait(150)
ui.log("after recovery: enabled=" + controller.mcp.enabled + "; target=" + controller.mcp.projectTarget)
ui.shot("cad42-after-recovery.png")
ui.clickText("Allow AI agents to use this project")
ui.wait(150)
ui.clickText("Allow AI agents to use this project")
ui.wait(150)
if (controller.mcp.enabled || controller.mcp.listening || controller.mcp.clients.length) ui.fail("turning access off failed")
ui.clickText("Allow AI agents to use this project")
ui.wait(150)
if (!controller.mcp.enabled) ui.fail("manual off prevented explicit regrant")
controller.mcp.disconnectClients()
if (controller.mcp.enabled || controller.mcp.listening || controller.mcp.clients.length) ui.fail("Disconnect did not end consent")
ui.shot("cad42-after-disconnect.png")
ui.clickText("Allow AI agents to use this project")
ui.wait(150)
if (!controller.mcp.enabled) ui.fail("Disconnect prevented explicit regrant")
ui.clickText("Allow AI agents to use this project")
ui.wait(150)
if (controller.mcp.operationCount !== 0) ui.fail("access events were counted as agent operations")
if (!controller.mcp.log.some(entry => entry.message.indexOf("Project replaced") >= 0 && entry.project.indexOf("CAD42-A.aerocad") >= 0)) ui.fail("revocation log lost its original project target")
ui.log("manual off and Disconnect require fresh consent; access lifecycle PASS")
