# Hole type Countersink / Counterbore (Fusion: Hole > Hole type) from the SOLID tab: a 6 mm hole with a
# 12 mm, 90 degree countersink in a 30 x 30 x 12 block, then a 6 mm hole with a 10 mm counterbore 4 mm
# deep next to it; reopening the countersink keeps its type.
# Run: AeroCAD --ui-script <this file>
ui.wait(800)
(() => { const r = controller.execute("feature.box", { corner: [0, 0, 0], size: [40, 30, 12] }); if (!r.ok) ui.fail("box: " + r.error) })()
ui.wait(300)
(() => { viewport.restoreCameraState({ pivot: [20, 15, 6], pitch: -35, yaw: 20, distance: 150, orthographic: false }) })()
ui.wait(300)
(() => { if (!ui.clickText("SOLID")) ui.fail("no SOLID tab") })()
ui.wait(300)
(() => { if (!ui.clickText("Hole")) ui.fail("no Hole button") })()
ui.wait(800)
(() => { featureDialog.setValue("point", [10, 15, 12]); featureDialog.setValue("diameter", 6); featureDialog.setValue("depth", ""); featureDialog.setValue("hole_type", "countersink"); featureDialog.setValue("csink_diameter", 12) })()
ui.wait(1000)
ui.shot("hole-countersink.png")
(() => { if (featureDialog.error) ui.fail("dialog error: " + featureDialog.error) })()
(() => { if (!ui.clickText("OK")) ui.fail("no OK button") })()
ui.wait(1000)
(() => { const pi = Math.PI; const tl = controller.execute("timeline.list").result; const v = tl.bodies[0].volume; const frustum = pi * 3 / 3 * (36 + 18 + 9); const want = 40 * 30 * 12 - pi * 9 * 12 - (frustum - pi * 9 * 3); ui.log("countersunk volume " + v.toFixed(2) + " want " + want.toFixed(2)); if (Math.abs(v - want) > want * 0.001) ui.fail("countersink volume " + v); const f = tl.features.find(x => x.type === "hole"); featureDialog.open("hole", f.params, f.id) })()
ui.wait(500)
(() => { if (featureDialog.values.hole_type !== "countersink") ui.fail("the reopened hole lost its type: " + JSON.stringify(featureDialog.values)) })()
(() => { if (!ui.clickText("Cancel")) ui.fail("no Cancel button") })()
ui.wait(500)
(() => { if (!ui.clickText("Hole")) ui.fail("no Hole button the second time") })()
ui.wait(800)
(() => { featureDialog.setValue("point", [30, 15, 12]); featureDialog.setValue("diameter", 6); featureDialog.setValue("depth", ""); featureDialog.setValue("hole_type", "counterbore"); featureDialog.setValue("cbore_diameter", 10); featureDialog.setValue("cbore_depth", 4) })()
ui.wait(800)
(() => { if (!ui.clickText("OK")) ui.fail("no OK button for the counterbore") })()
ui.wait(1000)
(() => { const pi = Math.PI; const v = controller.execute("timeline.list").result.bodies[0].volume; const frustum = pi * 3 / 3 * (36 + 18 + 9); const want = 40 * 30 * 12 - 2 * pi * 9 * 12 - (frustum - pi * 9 * 3) - pi * 16 * 4; ui.log("both holes volume " + v.toFixed(2) + " want " + want.toFixed(2)); if (Math.abs(v - want) > want * 0.001) ui.fail("counterbore volume " + v) })()
