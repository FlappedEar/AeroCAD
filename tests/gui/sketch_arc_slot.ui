# CAD-273: Arc Slot (Fusion: Slot > Center Point Arc Slot) from the sketch CREATE menu with real clicks: the centre, the start and end of the centre line, then the width.
# Run: AeroCAD --ui-script <this file>
Qt.createQmlObject('import QtQuick; Item { objectName: "psTest"; visible: false; function find(i, name) { if (!i) return null; if (i.objectName === name && i.visible) return i; const ch = i.children || []; for (let k = 0; k < ch.length; ++k) { const r = find(ch[k], name); if (r) return r } return null } function at(q) { const o = viewport.sketchOverlay; const p = o.toScreen(q); return o.mapToItem(null, p.x, p.y) } function clickAt(q) { const w = at(q); ui.move(w.x, w.y); ui.wait(80); ui.click(w.x, w.y); ui.wait(150) } function moveTo(q) { const w = at(q); ui.move(w.x, w.y); ui.wait(150) } function curves() { return controller.execute("sketch.curves", { sketch: activeSketch.id }).result.curves } function pick(box, label) { const b = find(window.contentItem, box); if (!b) return false; const p = b.mapToItem(null, b.width / 2, b.height / 2); ui.click(p.x, p.y); ui.wait(300); return ui.clickText(label) } }', window.contentItem)
ui.wait(800)
(() => { window.createSketch({ plane: "XY" }); if (!window.activeSketch) ui.fail("no sketch") })()
ui.wait(800)
(() => { viewport.restoreCameraState({ pivot: [15, 15, 0], pitch: -90, yaw: 0, distance: 160, orthographic: false }) })()
ui.wait(400)
(() => { if (!ui.clickText("CREATE")) ui.fail("no CREATE menu on the ribbon") })()
ui.wait(400)
(() => { if (!ui.clickText("Arc Slot")) ui.fail("no Arc Slot in the CREATE menu") })()
ui.wait(300)
(() => { if (sketchTool !== "arc_slot") ui.fail("Arc Slot did not start: " + sketchTool) })()
# Centre (0,0); the centre line runs from (30,0) round to (0,30); the width is set by a click at radius 35 (10 wide).
(() => { const t = Array.from(window.contentItem.children).find(c => c.objectName === "psTest"); t.clickAt([0, 0]); t.clickAt([30, 0]); t.moveTo([0, 30]) })()
ui.shot("sketch-arc-slot-preview.png")
(() => { const t = Array.from(window.contentItem.children).find(c => c.objectName === "psTest"); t.clickAt([0, 30]); t.moveTo([35, 0]) })()
ui.shot("sketch-arc-slot-width-preview.png")
(() => { const t = Array.from(window.contentItem.children).find(c => c.objectName === "psTest"); t.clickAt([35, 0]) })()
ui.wait(600)
(() => { const t = Array.from(window.contentItem.children).find(c => c.objectName === "psTest"); const c = t.curves(); const r = controller.execute("sketch.profiles", { sketch: activeSketch.id }).result.profiles; const want = 2 * (Math.PI / 2) * 30 * 5 + Math.PI * 25; ui.log("arc slot: " + c.length + " curves, " + r.length + " profile(s), area " + (r.length ? r[0].area.toFixed(3) : "-") + " want " + want.toFixed(3)); if (c.length !== 4 || r.length !== 1 || Math.abs(r[0].area - want) > want * 0.01) ui.fail("the arc slot is not what was drawn") })()
ui.shot("sketch-arc-slot.png")
