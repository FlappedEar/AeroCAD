# SPDX-License-Identifier: GPL-3.0-or-later
# CAD-174: a run is renamed in place in the run list (✎, type, Enter; Esc cancels), also while
# the list refreshes under the typing, and the label is saved with the run. Prepared case only.
Qt.createQmlObject('import QtQuick; Item { objectName: "cfTest"; visible: false; function find(i, name) { if (!i) return null; if (i.objectName === name) return i; const ch = i.children || []; for (let k = 0; k < ch.length; ++k) { const r = find(ch[k], name); if (r) return r } return null } }', window.contentItem)
ui.wait(800)
(() => { for (const r of controller.execute("simulation.list").result.runs) controller.execute("simulation.delete", { run: r.id }) })()
(() => { const p = controller.execute("document.parts").result.parts[0]; window.selectPart(p.id); const r = controller.execute("simulation.run", { id: p.id, label: "typo", prepareOnly: true }); if (!r.ok) ui.fail("prepare: " + r.error) })()
ui.clickText("SIMULATE")
ui.wait(300)
ui.clickText("Wind Tunnel")
ui.wait(1000)
(() => { simulationPanel.refreshRuns(); simulationPanel.tab = 0 })()
ui.wait(500)
(() => { const t = Array.from(window.contentItem.children).find(c => c.objectName === "cfTest"); const id = simulationPanel.runs[0].id; const b = t.find(simulationPanel, "renameButton_" + id); if (!b || !b.visible) ui.fail("no rename button"); const p = b.mapToItem(null, b.width / 2, b.height / 2); ui.click(p.x, p.y) })()
ui.wait(400)
(() => { const t = Array.from(window.contentItem.children).find(c => c.objectName === "cfTest"); const f = t.find(simulationPanel, "runRenameField_" + simulationPanel.runs[0].id); if (!f || !f.visible || !f.activeFocus) ui.fail("the name field is not open and focused"); if (f.text !== "typo" || f.selectedText !== "typo") ui.fail("field text: " + f.text) })()
ui.type("long splitter")
# A correction in the middle: the list refreshes every few seconds, and typing goes on at the
# same place in the new row.
ui.key("Left")
ui.key("Left")
ui.key("Left")
ui.key("Left")
ui.key("Left")
ui.key("Left")
ui.key("Left")
ui.key("Left")
ui.key("Left")
ui.wait(5500)
ui.type("er")
ui.shot("cfd-rename-run.png")
ui.key("Return")
ui.wait(500)
(() => { const id = simulationPanel.runs[0].id; const s = controller.execute("simulation.status", { run: id }).result; ui.log("LABEL " + s.source.label); if (s.source.label !== "longer splitter") ui.fail("label: " + s.source.label); if (simulationPanel.renamingRun !== "") ui.fail("still renaming") })()
(() => { const t = Array.from(window.contentItem.children).find(c => c.objectName === "cfTest"); const f = t.find(simulationPanel, "runRenameField_" + simulationPanel.runs[0].id); const row = f.parent; const l = Array.from(row.children).find(c => c.visible && typeof c.text === "string" && c !== f); ui.log("ROW " + (l ? l.text : "none")); if (!l || l.text.indexOf("longer splitter · ") < 0) ui.fail("row title: " + (l ? l.text : "none")) })()
# Esc keeps the name.
(() => { const t = Array.from(window.contentItem.children).find(c => c.objectName === "cfTest"); const b = t.find(simulationPanel, "renameButton_" + simulationPanel.runs[0].id); const p = b.mapToItem(null, b.width / 2, b.height / 2); ui.click(p.x, p.y) })()
ui.wait(300)
ui.type("other")
ui.key("Escape")
ui.wait(300)
(() => { const s = controller.execute("simulation.status", { run: simulationPanel.runs[0].id }).result; if (s.source.label !== "longer splitter" || simulationPanel.renamingRun !== "") ui.fail("Esc changed the label: " + s.source.label) })()
# A click in another field applies the name and leaves the focus there, also after refreshes.
(() => { const t = Array.from(window.contentItem.children).find(c => c.objectName === "cfTest"); const b = t.find(simulationPanel, "renameButton_" + simulationPanel.runs[0].id); const p = b.mapToItem(null, b.width / 2, b.height / 2); ui.click(p.x, p.y) })()
ui.wait(300)
ui.type("wide")
(() => { const t = Array.from(window.contentItem.children).find(c => c.objectName === "cfTest"); const f = t.find(simulationPanel, "cfdSpeedField"); const p = f.mapToItem(null, f.width / 2, f.height / 2); ui.click(p.x, p.y) })()
ui.wait(5500)
(() => { const t = Array.from(window.contentItem.children).find(c => c.objectName === "cfTest"); const f = t.find(simulationPanel, "cfdSpeedField"); const s = controller.execute("simulation.status", { run: simulationPanel.runs[0].id }).result; ui.log("AFTER CLICK label " + s.source.label + ", renaming " + simulationPanel.renamingRun + ", speed focus " + f.activeFocus); if (s.source.label !== "wide" || simulationPanel.renamingRun !== "") ui.fail("a click elsewhere did not apply the name"); if (!f.activeFocus) ui.fail("the rename took the focus back from the speed field") })()
# Opening another run's name field applies the pending edit of the first one (the list is
# scrolled to the older run first; both rows are then on screen).
(() => { const p = controller.execute("document.parts").result.parts[0]; const r = controller.execute("simulation.run", { id: p.id, label: "second", prepareOnly: true }); if (!r.ok) ui.fail("prepare 2: " + r.error); simulationPanel.refreshRuns() })()
ui.wait(500)
(() => { const t = Array.from(window.contentItem.children).find(c => c.objectName === "cfTest"); const a = simulationPanel.runs.find(r => r.source.label === "wide"); const b = t.find(simulationPanel, "renameButton_" + a.id); let fl = b.parent; while (fl && fl.contentY === undefined) fl = fl.parent; if (fl) { const q = b.mapToItem(fl.contentItem, 0, 0); fl.contentY = Math.max(0, Math.min(fl.contentHeight - fl.height, q.y - fl.height / 2)) } const p = b.mapToItem(null, b.width / 2, b.height / 2); ui.click(p.x, p.y) })()
ui.wait(300)
ui.type("first")
(() => { const t = Array.from(window.contentItem.children).find(c => c.objectName === "cfTest"); const o = simulationPanel.runs.find(r => r.source.label === "second"); const b = t.find(simulationPanel, "renameButton_" + o.id); const p = b.mapToItem(null, b.width / 2, b.height / 2); ui.click(p.x, p.y) })()
ui.wait(500)
(() => { const labels = controller.execute("simulation.list").result.runs.map(r => controller.execute("simulation.status", { run: r.id }).result.source.label); ui.log("LABELS " + labels.join(", ")); if (labels.indexOf("first") < 0) ui.fail("switching runs discarded the edit"); const o = simulationPanel.runs.find(r => r.source.label === "second"); if (!o || simulationPanel.renamingRun !== o.id) ui.fail("the second run's field is not open") })()
ui.key("Escape")
# A click on another row button while a name is open applies the name and still does what the
# button does (here: B, compare).
(() => { const t = Array.from(window.contentItem.children).find(c => c.objectName === "cfTest"); const runs = simulationPanel.runs; simulationPanel.selectRun(runs[0].id); const b = t.find(simulationPanel, "renameButton_" + runs[0].id); const p = b.mapToItem(null, b.width / 2, b.height / 2); ui.click(p.x, p.y) })()
ui.wait(300)
ui.type("third")
(() => { const t = Array.from(window.contentItem.children).find(c => c.objectName === "cfTest"); const o = simulationPanel.runs[1]; const b = t.find(simulationPanel, "compareButton_" + o.id); let fl = b.parent; while (fl && fl.contentY === undefined) fl = fl.parent; if (fl) { const q = b.mapToItem(fl.contentItem, 0, 0); fl.contentY = Math.max(0, Math.min(fl.contentHeight - fl.height, q.y - fl.height / 2)) } const p = b.mapToItem(null, b.width / 2, b.height / 2); ui.click(p.x, p.y) })()
ui.wait(800)
(() => { const s = controller.execute("simulation.status", { run: simulationPanel.runs[0].id }).result; ui.log("B CLICK label " + s.source.label + ", compare " + simulationPanel.compareRun); if (s.source.label !== "third") ui.fail("the name was not applied: " + s.source.label); if (simulationPanel.compareRun !== simulationPanel.runs[1].id) ui.fail("the B click was lost") })()
ui.log("cfd rename run done")
