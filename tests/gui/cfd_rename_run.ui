# SPDX-License-Identifier: GPL-3.0-or-later
# CAD-174: a run is renamed in place in the run list (✎, type, Enter; Esc cancels), also while
# the list refreshes under the typing, and the label is saved with the run. Prepared case only.
Qt.createQmlObject('import QtQuick; Item { objectName: "cfTest"; visible: false; function find(i, name) { if (!i) return null; if (i.objectName === name) return i; const ch = i.children || []; for (let k = 0; k < ch.length; ++k) { const r = find(ch[k], name); if (r) return r } return null } }', window.contentItem)
ui.wait(800)
(() => { for (const r of controller.execute("simulation.list").result.runs) controller.execute("simulation.delete", { run: r.id }) })()
(() => { const p = controller.execute("document.parts").result.parts[0]; window.selectPart(p.id); const r = controller.execute("simulation.run", { id: p.id, label: "typo", prepareOnly: true }); if (!r.ok) ui.fail("prepare: " + r.error) })()
ui.clickText("SIMULATE")
ui.wait(300)
ui.clickText("Wind Tunnel")
ui.wait(1000)
(() => { simulationPanel.refreshRuns(); simulationPanel.tab = 0 })()
ui.wait(500)
(() => { const t = Array.from(window.contentItem.children).find(c => c.objectName === "cfTest"); const id = simulationPanel.runs[0].id; const b = t.find(simulationPanel, "renameButton_" + id); if (!b || !b.visible) ui.fail("no rename button"); const p = b.mapToItem(null, b.width / 2, b.height / 2); ui.click(p.x, p.y) })()
ui.wait(400)
(() => { const t = Array.from(window.contentItem.children).find(c => c.objectName === "cfTest"); const f = t.find(simulationPanel, "runRenameField_" + simulationPanel.runs[0].id); if (!f || !f.visible || !f.activeFocus) ui.fail("the name field is not open and focused"); if (f.text !== "typo" || f.selectedText !== "typo") ui.fail("field text: " + f.text) })()
ui.type("long splitter")
# A correction in the middle: the list refreshes every few seconds, and typing goes on at the
# same place in the new row.
ui.key("Left")
ui.key("Left")
ui.key("Left")
ui.key("Left")
ui.key("Left")
ui.key("Left")
ui.key("Left")
ui.key("Left")
ui.key("Left")
ui.wait(5500)
ui.type("er")
ui.shot("cfd-rename-run.png")
ui.key("Return")
ui.wait(500)
(() => { const id = simulationPanel.runs[0].id; const s = controller.execute("simulation.status", { run: id }).result; ui.log("LABEL " + s.source.label); if (s.source.label !== "longer splitter") ui.fail("label: " + s.source.label); if (simulationPanel.renamingRun !== "") ui.fail("still renaming") })()
(() => { const t = Array.from(window.contentItem.children).find(c => c.objectName === "cfTest"); const f = t.find(simulationPanel, "runRenameField_" + simulationPanel.runs[0].id); const row = f.parent; const l = Array.from(row.children).find(c => c.visible && typeof c.text === "string" && c !== f); ui.log("ROW " + (l ? l.text : "none")); if (!l || l.text.indexOf("longer splitter · ") < 0) ui.fail("row title: " + (l ? l.text : "none")) })()
# Esc keeps the name.
(() => { const t = Array.from(window.contentItem.children).find(c => c.objectName === "cfTest"); const b = t.find(simulationPanel, "renameButton_" + simulationPanel.runs[0].id); const p = b.mapToItem(null, b.width / 2, b.height / 2); ui.click(p.x, p.y) })()
ui.wait(300)
ui.type("other")
ui.key("Escape")
ui.wait(300)
(() => { const s = controller.execute("simulation.status", { run: simulationPanel.runs[0].id }).result; if (s.source.label !== "longer splitter" || simulationPanel.renamingRun !== "") ui.fail("Esc changed the label: " + s.source.label) })()
ui.log("cfd rename run done")
