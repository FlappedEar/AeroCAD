(() => { simulationPanel.refreshRuns(); const s = simulationPanel.activeStatus; ui.log("run " + (s ? s.id + " " + s.state : "missing")); if (!s || s.state !== "finished") ui.fail("the run did not finish") })()
ui.wait(1500)
(() => { const n = simulationPanel.viewportFields.length; ui.log("with the part: " + n + " fields, hidden parts " + JSON.stringify(simulationPanel.hiddenPartIds)); if (n === 0) ui.fail("no fields drawn for the run of the open part") })()
ui.shot("reset_1_results.png")
controller.execute("part.remove", { id: 1 })
ui.wait(800)
(() => { const n = simulationPanel.viewportFields.length; ui.log("part deleted: " + n + " fields"); if (n !== 0) ui.fail("fields still drawn after the part was deleted") })()
ui.shot("reset_2_part_deleted.png")
controller.execute("edit.undo")
ui.wait(800)
(() => { const n = simulationPanel.viewportFields.length; ui.log("after undo: " + n + " fields"); if (n === 0) ui.fail("fields not drawn again after undo") })()
# Leave everything on: section, heat map, measure, a selection tool.
sectionPanel.open()
heatMapPanel.open("thickness", 1)
ui.wait(300)
measurePanel.open("auto")
viewport.tool = "region"
ui.wait(800)
ui.shot("reset_3_before_new.png")
controller.newProject()
ui.wait(1500)
(() => { const bad = []; const parts = controller.execute("document.parts").result.parts; if (parts.length) bad.push(parts.length + " parts"); if (simulationPanel.viewportFields.length) bad.push("simulation fields"); if (simulationPanel.activeRun) bad.push("run " + simulationPanel.activeRun + " selected"); if (simulationPanel.results) bad.push("simulation results"); if (sectionPanel.active) bad.push("section"); if (measurePanel.active) bad.push("measure"); if (heatMapPanel.active || heatMapPanel.result) bad.push("heat map"); if (viewport.tool !== "navigate") bad.push("tool " + viewport.tool); if (window.selectedPartId) bad.push("selection"); if (controller.canUndo) bad.push("undo history"); if (window.activeSketch) bad.push("sketch"); const insp = controller.execute("inspect.state"); if (insp.ok && JSON.stringify(insp.result).indexOf("\"enabled\":true") >= 0) bad.push("inspect " + JSON.stringify(insp.result)); ui.log("after New: " + (bad.length ? bad.join(", ") : "nothing left")); if (bad.length) ui.fail("left after New: " + bad.join(", ")) })()
ui.shot("reset_4_after_new.png")
