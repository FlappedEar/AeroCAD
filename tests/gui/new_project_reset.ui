# Wind tunnel results follow their part, and File > New leaves nothing of the previous
# project on screen: no part, no simulation results, no section, no measurement, no heat
# map, no selection tool, no undo history. Runs a coarse OpenFOAM case (about a minute).
# Run: AEROCAD_CFD_DIR=<empty dir> AeroCAD tests/data/box_200x80x60.stl --ui-script <this file>
ui.wait(800)
window.simulationVisible = true
ui.wait(500)
(() => { const r = controller.execute("simulation.run", { id: 1, mesh: "coarse" }); if (!r.ok) ui.fail("simulation.run: " + r.error); else { simulationPanel.refreshRuns(); simulationPanel.selectRun(r.result.id) } })()
# Up to 3 minutes for the run.
(() => { simulationPanel.refreshRuns(); const s = simulationPanel.activeStatus; if (s && (s.state === "running" || s.state === "prepared")) ui.wait(5000) })()
(() => { simulationPanel.refreshRuns(); const s = simulationPanel.activeStatus; if (s && (s.state === "running" || s.state === "prepared")) ui.wait(5000) })()
