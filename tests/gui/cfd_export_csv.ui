# SPDX-License-Identifier: GPL-3.0-or-later
# CAD-167: Results > Export CSV… writes the run's conditions, values and full history to a CSV
# file. Uses tests/gui/fake-docker.sh with FAKE_DOCKER_HISTORY=1 (20 iterations, still running).
Qt.createQmlObject('import QtQuick; Item { objectName: "cfTest"; visible: false; function find(i, name) { if (!i) return null; if (i.objectName === name) return i; const ch = i.children || []; for (let k = 0; k < ch.length; ++k) { const r = find(ch[k], name); if (r) return r } return null } function read(url) { const x = new XMLHttpRequest(); x.open("GET", url, false); x.send(); return x.responseText } }', window.contentItem)
ui.wait(800)
(() => { for (const r of controller.execute("simulation.list").result.runs) controller.execute("simulation.delete", { run: r.id }) })()
(() => { const p = controller.execute("document.parts").result.parts[0]; window.selectPart(p.id) })()
ui.clickText("SIMULATE")
ui.wait(300)
ui.clickText("Wind Tunnel")
ui.wait(800)
ui.clickText("Run CFD")
ui.wait(2500)
(() => { simulationPanel.refreshRuns(); simulationPanel.tab = 1 })()
ui.wait(800)
(() => { simulationPanel.resultsDialog.currentFolder = "file://" + simulationPanel.activeStatus.caseDir.replace(/\/[^/]*$/, "") })()
(() => { const t = Array.from(window.contentItem.children).find(c => c.objectName === "cfTest"); const b = t.find(simulationPanel, "cfdExportCsv"); if (!b || !b.visible) ui.fail("no Export CSV button"); const p = b.mapToItem(null, b.width / 2, b.height / 2); ui.click(p.x, p.y) })()
ui.wait(800)
(() => { const d = simulationPanel.resultsDialog; if (!d.visible) ui.fail("the export dialog did not open"); const f = d.selectedFile.toString(); ui.log("suggested " + f); if (!f.endsWith(".csv") || f.indexOf(simulationPanel.activeRun) < 0) ui.fail("suggested file: " + f); d.accept() })()
ui.wait(600)
(() => { const t = Array.from(window.contentItem.children).find(c => c.objectName === "cfTest"); const n = t.find(simulationPanel, "cfdExportNote"); ui.log("NOTE " + n.text); if (n.text.indexOf("20 iteration(s) written to") !== 0) ui.fail("note: " + n.text) })()
(() => { const t = Array.from(window.contentItem.children).find(c => c.objectName === "cfTest"); const dir = simulationPanel.activeStatus.caseDir.replace(/\/[^/]*$/, ""); const csv = t.read("file://" + dir + "/" + simulationPanel.activeRun + ".csv"); const lines = csv.split("\r\n"); ui.log("CSV head " + JSON.stringify(lines.slice(0, 4))); if (lines[0] !== "Quantity,Value") ui.fail("first line: " + lines[0]); if (csv.indexOf("\r\nState,running\r\n") < 0 || csv.indexOf("\r\nCd (provisional),0.8\r\n") < 0) ui.fail("state or provisional Cd missing"); const h = lines.indexOf("Iteration,Cd,Cl,Cs,Drag (N),Lift (N),Side force (N),Pressure drag (N),Viscous drag (N)"); if (h < 0 || lines.length - h - 2 !== 20) ui.fail("history rows: " + (lines.length - h - 2)) })()
ui.shot("cfd-export-csv.png")
(() => { controller.execute("simulation.cancel", { run: simulationPanel.activeRun }) })()
ui.wait(1000)
ui.log("cfd export csv done")
