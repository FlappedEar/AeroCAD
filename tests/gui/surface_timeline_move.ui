# Run: AeroCAD tests/data/models/dome.stl --ui-script tests/gui/surface_timeline_move.ui
# Real browser context-menu and OK clicks must route a timeline surface to feature.move.
Qt.createQmlObject('import QtQuick; Item { objectName: "surfaceMoveTest"; visible: false; property var s: ({}); function run(name, params) { const r = controller.execute(name, params || {}); if (!r.ok) throw new Error(name + ": " + r.error); return r.result } function find(item, predicate) { if (predicate(item)) return item; for (const c of item.children || []) { const found = find(c, predicate); if (found) return found } return null } function upperZ() { return run("document.parts").parts.find(p => p.id === s.fit.id).bounds.max[2] } function setNumber(key, value, index) { const field = find(featureDialog, x => x.editingFinished !== undefined && (index === undefined ? x.field && x.field.key === key : x.parent && x.parent.field && x.parent.field.key === key && x.index === index)); if (!field) throw new Error("Missing field " + key); const p = field.mapToItem(null, field.width / 2, field.height / 2); ui.click(p.x, p.y); field.text = String(value); field.editingFinished() } }', window.contentItem)
ui.wait(500)
(() => { const t = Array.from(window.contentItem.children).find(x => x.objectName === "surfaceMoveTest"); const scan = t.run("document.parts").parts[0]; t.run("selection.brush", {id: scan.id, points: [[0, 0, scan.bounds.max[2]]], radius: 45}); t.s.fit = t.run("surface.fit_selection", {id: scan.id, tolerance: 0.5}); t.run("part.set_visible", {id: scan.id, visible: false}); window.selectPart(t.s.fit.id); viewport.fitAll(); t.s.before = t.upperZ(); })()
ui.wait(300)
(() => { const t = Array.from(window.contentItem.children).find(x => x.objectName === "surfaceMoveTest"); const label = t.find(window.contentItem, x => x.visible && x.text === t.s.fit.name); if (!label) throw new Error("No fitted surface in browser"); const p = label.mapToItem(null, label.width / 2, label.height / 2); ui.click(p.x, p.y, "right"); })()
ui.wait(150)
ui.clickText("Move / Rotate…")
ui.wait(300)
ui.shot("/tmp/aerocad-cad78-surface-move-dialog.png")
(() => { const t = Array.from(window.contentItem.children).find(x => x.objectName === "surfaceMoveTest"); if (!featureDialog.visible || featureDialog.type !== "move" || actionPopup.visible) { ui.fail("timeline surface opened imported-part transform popup instead of feature.move"); throw new Error("wrong Move/Rotate route") } if (featureDialog.values.body !== t.s.fit.feature) ui.fail("Move targets a different body"); t.setNumber("angle", 0); t.setNumber("translate", 10, 2); })()
ui.wait(300)
ui.clickText("OK")
ui.wait(200)
(() => { const t = Array.from(window.contentItem.children).find(x => x.objectName === "surfaceMoveTest"); const timeline = t.run("timeline.list"); if (timeline.features.length !== 2 || timeline.features[1].type !== "move") throw new Error("accepted move is not a timeline step"); if (Math.abs(t.upperZ() - t.s.before - 10) > 0.05) throw new Error("fitted surface did not move 10 mm"); t.run("edit.undo"); if (t.run("timeline.list").features.length !== 1 || Math.abs(t.upperZ() - t.s.before) > 0.05) throw new Error("one Undo did not restore the surface"); t.run("edit.redo"); if (Math.abs(t.upperZ() - t.s.before - 10) > 0.05) throw new Error("Redo did not restore the moved surface"); const info = controller.partInfo(t.s.fit.id); if (contextActions.role(info) !== "surface") throw new Error("surface-specific actions were lost"); const actions = contextActions.actions(info); for (const id of ["editStep", "trim", "offset", "thicken"]) if (!actions.some(a => a.id === id)) throw new Error("missing surface action " + id); if (actions.some(a => a.id === "scale" && a.enabled)) throw new Error("timeline surface offers imported-part Scale"); ui.log("CAD-78 timeline surface Move/Rotate passed: correct dialog, accepted transform, one-step undo/redo, surface actions retained"); })()
ui.wait(200)
ui.shot("/tmp/aerocad-cad78-surface-moved.png")
