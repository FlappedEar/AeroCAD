# CAD-126: Sketch Offset (Fusion): select a chain, Offset, type the distance, Enter.
# Run: AeroCAD --ui-script <this file>
ui.wait(800)
(() => { const r = controller.execute("sketch.create", { plane: "XY", curves: [{ type: "rectangle", corner: [0, 0], width: 40, height: 20 }] }); if (!r.ok) ui.fail("sketch: " + r.error) })()
ui.wait(300)
(() => { enterSketch(controller.execute("timeline.list").result.features[0].id) })()
ui.wait(800)
ui.key("Esc")
ui.wait(300)
(() => { const o = viewport.sketchOverlay; [[20, 0], [40, 10], [20, 20], [0, 10]].forEach((q, i) => { const p = o.toScreen(q); const w = o.mapToItem(null, p.x, p.y); ui.click(w.x, w.y, "left", i ? "shift" : "") }) })()
ui.wait(300)
(() => { if (viewport.sketchOverlay.selectedCurves.length !== 4) ui.fail("expected the 4 sides selected: " + JSON.stringify(viewport.sketchOverlay.selectedCurves)) })()
(() => { if (!ui.clickText("Offset")) ui.fail("no Offset button") })()
ui.wait(300)
(() => { if (sketchTool !== "offset") ui.fail("Offset did not start: " + sketchTool) })()
ui.type("3")
ui.key("Return")
ui.wait(600)
(() => { const r = controller.execute("sketch.curves", { sketch: activeSketch.id }).result; let minX = 1e9; for (const c of r.curves.slice(4)) for (const p of c.points) minX = Math.min(minX, p[0]); ui.log("curves " + r.curves.length + " min x " + minX); if (r.curves.length !== 12 || Math.abs(minX + 3) > 1e-6) ui.fail("the outline was not offset 3 mm outwards"); if (sketchTool !== "") ui.fail("the tool stays after the offset") })()
ui.shot("sketch-offset.png")
