# Plane Along Path (Fusion: Construct > Plane Along Path): a plane perpendicular to a sketch path.
# Run: AeroCAD --ui-script <this file>
ui.wait(800)
(() => { const r = controller.execute("sketch.create", { plane: "XY", curves: [{ type: "line", start: [0, 0], end: [40, 0] }, { type: "line", start: [40, 0], end: [40, 30] }] }); if (!r.ok) ui.fail("path sketch: " + r.error) })()
ui.wait(300)
(() => { viewport.restoreCameraState({ pivot: [20, 15, 0], pitch: -35, yaw: 25, distance: 160, orthographic: false }) })()
ui.wait(300)
(() => { featureDialog.open("plane_path") })()
ui.wait(500)
(() => { if (featureDialog.type !== "plane_path") ui.fail("wrong dialog: " + featureDialog.type) })()
(() => { const sk = controller.execute("timeline.list").result.features.filter(f => f.type === "sketch").pop(); featureDialog.setValue("path", { sketch: sk.id }); featureDialog.setValue("position", 0.5) })()
ui.wait(800)
ui.shot("plane-path.png")
(() => { if (featureDialog.error) ui.fail("dialog error: " + featureDialog.error) })()
(() => { if (!ui.clickText("OK")) ui.fail("no OK button") })()
ui.wait(800)
(() => { const pl = controller.execute("timeline.list").result.features.find(x => x.type === "plane"); if (!pl) ui.fail("no plane in the timeline"); ui.log("plane " + JSON.stringify(pl.params)); const parts = controller.execute("document.parts").result.parts; if (!parts.some(p => p.kind === "plane")) ui.fail("the plane is not a part in the view") })()
# Reopening the plane from the timeline gives the same dialog, with its values.
(() => { const pl = controller.execute("timeline.list").result.features.find(x => x.type === "plane"); featureDialog.open("plane", pl.params, pl.id) })()
ui.wait(500)
(() => { if (featureDialog.type !== "plane_path") ui.fail("reopened plane opened " + featureDialog.type); if (Number(featureDialog.values.position) !== 0.5) ui.fail("lost the position: " + JSON.stringify(featureDialog.values)) })()
(() => { featureDialog.setValue("position", 1) })()
ui.wait(500)
(() => { if (!ui.clickText("OK")) ui.fail("no OK button") })()
ui.wait(800)
(() => { const r = controller.execute("document.parts").result.parts.filter(p => p.kind === "plane"); if (r.length !== 1) ui.fail("editing the plane added another: " + r.length) })()
# A plane made by the command without `position` is at the path start; reopening and OK keeps it there.
(() => { const sk = controller.execute("timeline.list").result.features.filter(f => f.type === "sketch").pop(); const r = controller.execute("feature.plane", { path: { sketch: sk.id } }); if (!r.ok) ui.fail("command plane: " + r.error); const o = r.result.plane.origin; if (Math.abs(o[0]) > 1e-6) ui.fail("not at the start: " + JSON.stringify(o)); featureDialog.open("plane", { path: { sketch: sk.id } }, r.result.id) })()
ui.wait(500)
(() => { if (Number(featureDialog.values.position) !== 0) ui.fail("reopened plane got position " + featureDialog.values.position) })()
(() => { if (!ui.clickText("OK")) ui.fail("no OK button") })()
ui.wait(800)
(() => { const pls = controller.execute("timeline.list").result.features.filter(x => x.type === "plane"); const o = controller.execute("document.parts").result.parts.filter(p => p.kind === "plane"); ui.log("planes " + pls.length); const last = pls[pls.length - 1]; if (Number(last.params.position) !== 0) ui.fail("the edit moved the plane: " + JSON.stringify(last.params)) })()
(() => { for (let i = 0; i < 6; ++i) controller.execute("edit.undo"); const tl = controller.execute("timeline.list").result; if (tl.features.some(x => x.type === "plane")) ui.fail("undo did not remove the plane") })()
