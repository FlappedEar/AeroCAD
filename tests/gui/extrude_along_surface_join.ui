# CAD-303: Extrude along surface (outward) from a sketch on the part joins the layer to it, as one undo
# step, and the view frames the result. "Separate body" keeps it apart. Run: AeroCAD dome_scan.stl --ui-script <this file>
Qt.createQmlObject('import QtQuick; Item { objectName: "ejTest"; visible: false; property var s: ({}) }', window.contentItem)
ui.wait(1500)
(() => { const t = Array.from(window.contentItem.children).find(x => x.objectName === "ejTest"); const scan = controller.execute("document.parts").result.parts[0]; const b = scan.bounds; const top = [(b.min[0] + b.max[0]) / 2, (b.min[1] + b.max[1]) / 2, b.max[2]]; const sk = controller.execute("sketch.create", { surface: { part: scan.id, point: top }, curves: [{ type: "center_rectangle", center: [0, 0], width: 40, height: 20 }] }); if (!sk.ok) { ui.fail("sketch: " + sk.error); return } const p = controller.execute("surface.part_from_sketch", { sketch: sk.result.id, thickness: 3, side: "outside" }); if (!p.ok) { ui.fail("part: " + p.error); return } const part = controller.execute("document.parts").result.parts.find(x => x.kind === "body"); t.s.part = part.id; t.s.vol0 = controller.execute("timeline.list").result.bodies[0].volume; const c = [(part.bounds.min[0] + part.bounds.max[0]) / 2, (part.bounds.min[1] + part.bounds.max[1]) / 2, (part.bounds.min[2] + part.bounds.max[2]) / 2]; const s2 = controller.execute("sketch.create", { surface: { part: part.id, point: c, facing: [0, 0, 1] }, curves: [{ type: "center_rectangle", center: [0, 0], width: 8, height: 6 }] }); if (!s2.ok) { ui.fail("sketch on the part: " + s2.error); return } const skPart = controller.execute("document.parts").result.parts.filter(x => x.kind === "sketch").pop(); window.selectPart(skPart.id) })()
ui.wait(500)
(() => { const g = contextActions.guide(window.selectionInfo); const next = contextActions.nextAction(window.selectionInfo); if (!next || next.id !== "partOnSurface") ui.fail("Next is not Extrude along surface"); const a = g.sections[0].steps[0].actions[0]; if (!a.params.some(p => p.key === "join")) ui.fail("the pane has no Outward layer choice") })()
ui.clickText("Extrude along surface")
ui.wait(600)
ui.clickText("Apply")
ui.wait(3000)
(() => { const t = Array.from(window.contentItem.children).find(x => x.objectName === "ejTest"); const bodies = controller.execute("document.parts").result.parts.filter(x => x.kind === "body"); if (bodies.length !== 1) ui.fail("the layer is not joined: " + bodies.length + " bodies"); const tl = controller.execute("timeline.list").result; if (!tl.features.some(f => f.type === "combine" && f.params.operation === "join")) ui.fail("no join step"); if (!(tl.bodies[0].volume > t.s.vol0 + 5)) ui.fail("the joined part gained no volume (" + t.s.vol0 + " -> " + tl.bodies[0].volume + ")"); if (window.selectionInfo.id !== t.s.part) ui.fail("the part is not selected after the join (" + window.selectionInfo.name + ")"); ui.log("EJ joined volume " + t.s.vol0 + " -> " + tl.bodies[0].volume) })()
# One undo step: the layer and its join go together, the part is as before.
(() => { const t = Array.from(window.contentItem.children).find(x => x.objectName === "ejTest"); const u = controller.execute("edit.undo"); if (!u.ok) { ui.fail("undo: " + u.error); return } const tl = controller.execute("timeline.list").result; if (tl.features.some(f => f.type === "combine")) ui.fail("undo left the join step"); if (tl.features.filter(f => f.type === "part_on_surface").length !== 1) ui.fail("undo left the layer (" + tl.features.filter(f => f.type === "part_on_surface").length + " part steps)") })()
