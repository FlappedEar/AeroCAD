# CAD-161: right-click an Extrude in the timeline, Edit Profile Sketch opens its sketch (Fusion);
# finishing the edited sketch regenerates the extrude.
# Run: AeroCAD --ui-script <this file>
ui.wait(800)
(() => { const s = controller.execute("sketch.create", { plane: "XY", curves: [{ type: "rectangle", corner: [0, 0], width: 40, height: 20 }] }); if (!s.ok) ui.fail("sketch: " + s.error); const e = controller.execute("feature.extrude", { sketch: s.result.id, distance: 10 }); if (!e.ok) ui.fail("extrude: " + e.error); controller.execute("feature.box", { corner: [100, 0, 0], size: [10, 10, 10] }) })()
ui.wait(500)
(() => { const fs = controller.execute("timeline.list").result.features; if (timelineBar.profileSketch(fs[1]) === null || timelineBar.profileSketch(fs[1]).id !== fs[0].id) ui.fail("no profile sketch for the extrude"); if (timelineBar.profileSketch(fs[2]) !== null || timelineBar.profileSketch(fs[0]) !== null) ui.fail("a box or a sketch has a profile sketch") })()
(() => { const p = timelineBar.chipPoint(1); ui.click(p.x, p.y, "right") })()
ui.wait(400)
ui.shot("timeline-profile-sketch-menu.png")
(() => { ui.clickText("Edit Profile Sketch") })()
ui.wait(800)
(() => { const fs = controller.execute("timeline.list").result.features; if (!activeSketch || activeSketch.id !== fs[0].id) ui.fail("Edit Profile Sketch did not open the extrude's sketch") })()
# Change the rectangle in the sketch and finish: the extrude follows.
(() => { const r = controller.execute("sketch.curves", { sketch: activeSketch.id }).result; ui.log("curves " + r.curves.length) })()
(() => { const c = controller.execute("sketch.add_constraints", { sketch: activeSketch.id, constraints: [{ type: "length", curve: 0, value: 60 }] }); if (!c.ok) ui.fail("dimension: " + c.error) })()
ui.wait(300)
ui.key("Esc")
(() => { finishSketch(false) })()
ui.wait(800)
(() => { const tl = controller.execute("timeline.list").result; const b = tl.bodies[0]; ui.log("extrude volume " + b.volume); if (Math.abs(b.volume - 60 * 20 * 10) > 1) ui.fail("the extrude did not follow the edited sketch: " + b.volume) })()
