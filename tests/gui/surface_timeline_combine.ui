# SPDX-License-Identifier: GPL-3.0-or-later
# Run: AeroCAD tests/data/models/dome.stl --ui-script tests/gui/surface_timeline_combine.ui
# Select the fitted surface as tool, pick a solid target with a real viewport click,
# flip the retained side, accept the split and undo/redo it in one step.
Qt.createQmlObject('import QtQuick; Item { objectName: "surfaceCombineTest"; visible: false; property var s: ({}); function run(name, params) { const r = controller.execute(name, params || {}); if (!r.ok) throw new Error(name + ": " + r.error); return r.result } function find(item, predicate) { if (predicate(item)) return item; for (const c of item.children || []) { const found = find(c, predicate); if (found) return found } return null } function volume() { return run("timeline.list").bodies.find(b => b.id === s.box.id).volume } function check(value, message) { if (!value) throw new Error(message) } }', window.contentItem)
ui.wait(500)
(() => { const t = Array.from(window.contentItem.children).find(x => x.objectName === "surfaceCombineTest"); const scan = t.run("document.parts").parts[0]; t.run("selection.brush", {id: scan.id, points: [[0, 0, scan.bounds.max[2]]], radius: 45}); t.s.fit = t.run("surface.fit_selection", {id: scan.id, tolerance: 0.5}); t.s.box = t.run("feature.box", {corner: [-20, -20, 30], size: [40, 40, 40]}); t.s.boxPart = t.s.box.bodies.find(b => b.id === t.s.box.id).partId; t.run("part.set_visible", {id: scan.id, visible: false}); window.selectPart(t.s.fit.id); viewport.fitAll(); t.s.original = t.volume(); })()
ui.wait(300)
(() => { const t = Array.from(window.contentItem.children).find(x => x.objectName === "surfaceCombineTest"); const label = t.find(window.contentItem, x => x.visible && x.text === t.s.fit.name); t.check(!!label, "No fitted surface in browser"); const p = label.mapToItem(null, label.width / 2, label.height / 2); ui.click(p.x, p.y, "right"); })()
ui.wait(150)
ui.clickText("More")
ui.wait(150)
ui.clickText("Cut a part to this shape")
ui.wait(200)
(() => { const t = Array.from(window.contentItem.children).find(x => x.objectName === "surfaceCombineTest"); t.check(featureDialog.visible && featureDialog.type === "combine", "Combine dialog did not open"); t.check(featureDialog.values.target === undefined, "surface was selected as the solid target"); t.check(featureDialog.values.tools && featureDialog.values.tools[0] === t.s.fit.feature, "timeline surface was not a numeric tool"); const flip = featureDialog.spec.fields.find(f => f.key === "flip"); t.check(flip.showIf(featureDialog.values), "Flip side is hidden for a timeline surface"); const p = viewport.viewPoint(Qt.vector3d(0, 0, 70)); t.check(viewport.pickPart(p.x, p.y).partId === t.s.boxPart, "fixture target is not under the pointer"); const point = viewport.mapToItem(null, p.x, p.y); ui.click(point.x, point.y); })()
ui.wait(400)
(() => { const t = Array.from(window.contentItem.children).find(x => x.objectName === "surfaceCombineTest"); t.check(featureDialog.values.target === t.s.box.id, "viewport click did not select the solid target"); t.s.cut = t.volume(); t.check(t.s.cut > 0 && t.s.cut < t.s.original - 100, "numeric surface did not split the target"); })()
(() => { const t = Array.from(window.contentItem.children).find(x => x.objectName === "surfaceCombineTest"); const checkbox = t.find(featureDialog, x => x.field && x.field.key === "flip" && x.toggled !== undefined); t.check(!!checkbox, "No Flip checkbox"); const p = checkbox.mapToItem(null, checkbox.width / 2, checkbox.height / 2); ui.click(p.x, p.y); t.check(featureDialog.values.flip === true, "Flip checkbox did not toggle"); })()
ui.wait(400)
(() => { const t = Array.from(window.contentItem.children).find(x => x.objectName === "surfaceCombineTest"); t.s.flipped = t.volume(); t.check(Math.abs(t.s.flipped + t.s.cut - t.s.original) < 0.1, "Flip did not keep the complementary side"); t.check(featureDialog.values.keepTools === true, "reference surface was not retained"); })()
ui.shot("/tmp/aerocad-cad78-surface-combine-dialog.png")
ui.clickText("OK")
ui.wait(250)
(() => { const t = Array.from(window.contentItem.children).find(x => x.objectName === "surfaceCombineTest"); const features = t.run("timeline.list").features; t.check(features.length === 3 && features[2].type === "combine", "accepted split is not one timeline step"); t.check(Math.abs(t.volume() - t.s.flipped) < 0.1, "accepted split differs from preview"); t.check(controller.partInfo(t.s.fit.id).id === t.s.fit.id, "retained surface disappeared"); t.run("edit.undo"); t.check(t.run("timeline.list").features.length === 2 && Math.abs(t.volume() - t.s.original) < 0.1, "one Undo did not restore the original target"); t.run("edit.redo"); t.check(Math.abs(t.volume() - t.s.flipped) < 0.1, "Redo did not restore the split"); ui.log("CAD-78 surface Combine passed: numeric surface tool, solid target pick, Flip, retained tool, accepted split and Undo/Redo"); })()
ui.wait(200)
ui.shot("/tmp/aerocad-cad78-surface-combined.png")
(() => { const t = Array.from(window.contentItem.children).find(x => x.objectName === "surfaceCombineTest"); const feature = t.run("timeline.list").features.find(f => f.type === "combine"); t.run("feature.edit", {id: feature.id, params: {keepTools: false}}); t.check(!controller.partInfo(t.s.fit.id).id, "surface tool was not consumed"); const chip = t.find(window.contentItem, x => x.visible && x.text === feature.name); t.check(!!chip, "No Combine timeline chip"); const p = chip.mapToItem(null, chip.width / 2, chip.height / 2); ui.click(p.x, p.y, "right"); })()
ui.wait(150)
ui.clickText("Edit Feature")
ui.wait(400)
(() => { const t = Array.from(window.contentItem.children).find(x => x.objectName === "surfaceCombineTest"); t.check(featureDialog.visible && featureDialog.type === "combine", "Consumed-tool editor did not open"); const flip = featureDialog.spec.fields.find(f => f.key === "flip"); t.check(flip.showIf(featureDialog.values), "Flip side hidden when reopening consumed surface tool"); t.check(featureDialog.values.flip === true, "Reopened editor lost Flip side"); t.check(!!t.find(featureDialog, x => x.visible && x.text === t.s.fit.name), "Reopened editor lost the consumed surface name"); t.check(Math.abs(t.volume() - t.s.flipped) < 0.1, "Reopened preview changed the retained side"); })()
ui.shot("/tmp/aerocad-cad78-surface-combine-reopened.png")
ui.clickText("OK")
ui.wait(250)
(() => { const t = Array.from(window.contentItem.children).find(x => x.objectName === "surfaceCombineTest"); const feature = t.run("timeline.list").features.find(f => f.type === "combine"); t.check(feature.params.flip === true && feature.params.keepTools === false, "Unchanged Apply lost consumed-tool parameters"); t.check(Math.abs(t.volume() - t.s.flipped) < 0.1, "Unchanged Apply changed the retained side"); ui.log("CAD-78 consumed surface tool editor passed: Flip stays visible and unchanged Apply preserves the side"); })()
