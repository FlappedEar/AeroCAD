foreach(name blocked guard deleted empty)
    file(READ "@CAD92_DIR@/${name}.stl" actual)
    if(NOT actual STREQUAL "previous ${name} output")
        message(FATAL_ERROR "Rejected ${name} export changed the previous output")
    endif()
endforeach()
foreach(name approved.stl new-limit.stl print/Body1.stl print/Body1.step print/Body2.stl print/Body2.step)
    if(NOT EXISTS "@CAD92_DIR@/${name}")
        message(FATAL_ERROR "Approved export did not create ${name}")
    endif()
    file(SIZE "@CAD92_DIR@/${name}" size)
    if(size LESS 100)
        message(FATAL_ERROR "Approved export ${name} is empty or truncated")
    endif()
endforeach()
