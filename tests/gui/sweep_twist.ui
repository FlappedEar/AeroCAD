# Sweep options (Fusion: Create > Sweep: Twist Angle, Taper, Orientation): a square bar twisted by 90 degrees.
# Run: AeroCAD --ui-script <this file>
ui.wait(800)
(() => { let r = controller.execute("sketch.create", { plane: "XY", curves: [{ type: "center_rectangle", center: [0, 0], width: 10, height: 10 }] }); if (!r.ok) ui.fail("profile: " + r.error); r = controller.execute("sketch.create", { plane: "XZ", curves: [{ type: "line", start: [0, 0], end: [0, 40] }] }); if (!r.ok) ui.fail("path: " + r.error) })()
ui.wait(300)
(() => { viewport.restoreCameraState({ pivot: [0, 0, 20], pitch: -25, yaw: 30, distance: 140, orthographic: false }) })()
ui.wait(300)
(() => { featureDialog.open("sweep") })()
ui.wait(500)
(() => { if (featureDialog.type !== "sweep") ui.fail("wrong dialog: " + featureDialog.type) })()
(() => { const sk = controller.execute("timeline.list").result.features.filter(f => f.type === "sketch"); featureDialog.setValue("sketch", sk[0].id); featureDialog.setValue("path", { sketch: sk[1].id }); featureDialog.setValue("twist", 90) })()
ui.wait(1000)
(() => { if (featureDialog.error) ui.fail("dialog error: " + featureDialog.error) })()
(() => { const b = controller.execute("timeline.list").result.bodies[0]; ui.log("preview volume " + b.volume); if (!b || Math.abs(b.volume - 4000) > 40) ui.fail("preview volume " + (b && b.volume) + ", expected about 4000") })()
ui.shot("sweep-twist.png")
(() => { if (!ui.clickText("OK")) ui.fail("no OK button") })()
ui.wait(800)
(() => { const f = controller.execute("timeline.list").result.features.find(x => x.type === "sweep"); if (!f || f.status !== "ok") ui.fail("no sweep step: " + JSON.stringify(f)); ui.log("params " + JSON.stringify(f.params)); if (Number(f.params.twist) !== 90) ui.fail("twist not stored: " + JSON.stringify(f.params)) })()
# Reopening the step gives the same dialog; a parallel orientation is a change of one field.
(() => { const f = controller.execute("timeline.list").result.features.find(x => x.type === "sweep"); featureDialog.open("sweep", f.params, f.id) })()
ui.wait(500)
(() => { if (featureDialog.type !== "sweep" || featureDialog.error) ui.fail("edit dialog " + featureDialog.type + " error " + featureDialog.error); if (Number(featureDialog.values.twist) !== 90) ui.fail("twist not reopened: " + JSON.stringify(featureDialog.values)) })()
(() => { featureDialog.setValue("twist", 0); featureDialog.setValue("end_scale", 0.5) })()
ui.wait(800)
(() => { if (!ui.clickText("OK")) ui.fail("no OK button") })()
ui.wait(800)
(() => { const tl = controller.execute("timeline.list").result; const want = 100 * 40 * (1 - 0.5 + 0.25 / 3); ui.log("volume " + tl.bodies[0].volume + " want " + want); if (Math.abs(tl.bodies[0].volume - want) > want * 0.02) ui.fail("volume after edit " + tl.bodies[0].volume) })()
(() => { for (let i = 0; i < 8; ++i) controller.execute("edit.undo"); const tl = controller.execute("timeline.list").result; if (tl.features.some(x => x.type === "sweep")) ui.fail("undo did not remove the sweep") })()
