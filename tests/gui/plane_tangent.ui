# Tangent Plane (Fusion: Construct > Tangent Plane): a plane touching a cylinder where it is clicked.
# Run: AeroCAD --ui-script <this file>
ui.wait(800)
(() => { const r = controller.execute("feature.cylinder", { center: [0, 0, 0], radius: 10, height: 30 }); if (!r.ok) ui.fail("cylinder: " + r.error) })()
ui.wait(300)
(() => { viewport.restoreCameraState({ pivot: [0, 0, 15], pitch: -20, yaw: 0, distance: 160, orthographic: false }) })()
ui.wait(300)
(() => { featureDialog.open("plane_tangent") })()
ui.wait(500)
(() => { if (featureDialog.type !== "plane_tangent") ui.fail("wrong dialog: " + featureDialog.type); featureDialog.pickKey = "tangent" })()
ui.wait(300)
(() => { const p = viewport.viewPoint(Qt.vector3d(0, -10, 15)); const w = viewport.mapToItem(null, p.x, p.y); ui.click(w.x, w.y) })()
ui.wait(800)
(() => { const v = featureDialog.values.tangent; ui.log("tangent pick " + JSON.stringify(v)); if (!v || v.body === undefined) ui.fail("the click did not pick the cylinder: " + JSON.stringify(v)) })()
(() => { if (featureDialog.error) ui.fail("dialog error: " + featureDialog.error) })()
ui.shot("plane-tangent.png")
(() => { if (!ui.clickText("OK")) ui.fail("no OK button") })()
ui.wait(800)
(() => { const pl = controller.execute("timeline.list").result.features.find(x => x.type === "plane"); if (!pl) ui.fail("no plane in the timeline"); ui.log("plane " + JSON.stringify(pl.params)); if (!pl.params.tangent || pl.params.tangent.relative === undefined && pl.params.tangent.point === undefined) ui.fail("no face reference stored: " + JSON.stringify(pl.params)) })()
# Reopening gives the same dialog.
(() => { const pl = controller.execute("timeline.list").result.features.find(x => x.type === "plane"); featureDialog.open("plane", pl.params, pl.id) })()
ui.wait(500)
(() => { if (featureDialog.type !== "plane_tangent") ui.fail("reopened plane opened " + featureDialog.type); if (featureDialog.error) ui.fail("edit error: " + featureDialog.error) })()
(() => { if (!ui.clickText("OK")) ui.fail("no OK button") })()
ui.wait(800)
(() => { const r = controller.execute("document.parts").result.parts.filter(p => p.kind === "plane"); if (r.length !== 1) ui.fail("expected one plane, got " + r.length) })()
(() => { for (let i = 0; i < 6; ++i) controller.execute("edit.undo"); const tl = controller.execute("timeline.list").result; if (tl.features.some(x => x.type === "plane")) ui.fail("undo did not remove the plane") })()
