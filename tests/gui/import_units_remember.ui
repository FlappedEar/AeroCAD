# CAD-12: run before import_file_units.ui, with the same settings directory and cwd.
ui.wait(500)
(() => { const r = controller.execute("feature.box", {size: [1, 2, 3]}); if (!r.ok) ui.fail(r.error); const out = controller.execute("document.export", {path: "@OUTPUT_DIR@/unitless.stl"}); if (!out.ok) ui.fail(out.error); controller.execute("project.new") })()
(() => { const r = controller.execute("feature.box", {size: [10, 20, 30]}); if (!r.ok) ui.fail(r.error); for (const path of ["@OUTPUT_DIR@/file-units.3mf", "@OUTPUT_DIR@/file-units.step"]) { const out = controller.execute("document.export", {path}); if (!out.ok) ui.fail(out.error) } controller.execute("project.new") })()
scanToolsAction.trigger()
ui.wait(300)
(() => { function find(item) { if (item.objectName === "unitlessImportUnits") return item; for (const child of Array.from(item.children || [])) { const hit = find(child); if (hit) return hit } return null } const combo = find(scanPanel); if (!combo) ui.fail("unitless import selector missing"); else { const p = combo.mapToItem(null, combo.width / 2, combo.height / 2); ui.click(p.x, p.y) } })()
ui.wait(200)
ui.clickText("cm")
ui.wait(200)
(() => { if (scan.importUnits !== "cm") ui.fail("unitless import selector did not save cm") })()
ui.log("Saved unitless-file preference: " + scan.importUnits)
ui.shot("import-units-preference.png")
ui.wait(250)
