# CAD-94: exercise the actual controller/viewport filters and ordinary mesh/B-rep picks.
# Run with tests/data/models/dome_scan.stl (dense enough for a real fitted surface).
ui.wait(1000)
Qt.createQmlObject('import QtQuick; Item { objectName: "pickTest"; visible: false; property var s: ({}); function run(name, params) { const r = controller.execute(name, params || {}); if (!r.ok) throw new Error(name + ": " + r.error); return r.result } function check(hit, id, label) { if ((hit.partId || 0) !== id) ui.fail(label + ": got " + (hit.partId || 0) + ", expected " + id) } function clickPoint(x, y, z) { const p = viewport.viewPoint(Qt.vector3d(x, y, z)); const q = viewport.mapToItem(null, p.x, p.y); ui.click(q.x, q.y) } }', window.contentItem)
(() => { const t = Array.from(window.contentItem.children).find(c => c.objectName === "pickTest"); t.s.scan = t.run("document.parts").parts[0].id; const o = Qt.vector3d(0, 0, 200), d = Qt.vector3d(0, 0, -1); t.check(controller.pickSurface(o, d), t.s.scan, "ordinary scan"); t.check(controller.pickSurface(o, d, {kind: "solid"}), 0, "scan excluded by solid filter"); t.check(controller.pickSurface(o, d, {hiddenPartIds: [t.s.scan]}), 0, "hidden scan exact"); t.check(controller.pickNearSurface(o, d, 30, {hiddenPartIds: [t.s.scan]}), 0, "hidden scan fallback"); t.run("selection.brush", {id: t.s.scan, points: [[0, 0, 45.7]], radius: 20}); t.s.surface = t.run("surface.fit_selection", {id: t.s.scan, tolerance: 0.5}).id; t.check(controller.pickSurface(o, d, {kind: "solid"}), t.s.surface, "fitted exact surface"); t.check(controller.pickNearSurface(o, d, 30, {kind: "solid"}), t.s.surface, "fitted exact surface fallback"); ui.log("scan and fitted surface picking passed") })()
(() => { const t = Array.from(window.contentItem.children).find(c => c.objectName === "pickTest"); t.run("feature.box", {size: [20, 20, 10], corner: [500, 0, 0]}); t.s.body = t.run("document.parts").parts.find(p => p.kind === "body").id; const o = Qt.vector3d(510, 10, 100), d = Qt.vector3d(0, 0, -1); t.check(controller.pickSurface(o, d, {kind: "body"}), t.s.body, "body exact"); t.check(controller.pickNearSurface(o, d, 20, {kind: "body"}), t.s.body, "body fallback"); t.run("inspect.section", {plane: "xy", offset: 5, parts: [t.s.body]}); const hit = controller.pickSurface(o, d, {kind: "body"}); t.check(hit, t.s.body, "section kept skin"); if (!hit.point || hit.point.z > 5.0001) ui.fail("section picked removed skin"); t.run("inspect.section", {enabled: false}); t.s.plane = t.run("feature.plane", {base: "XY", offset: 70}).id; const plane = t.run("document.parts").parts.find(p => p.kind === "plane"); t.check(controller.pickSurface(Qt.vector3d(0, 0, 200), d, {kind: "plane"}), plane.id, "construction plane"); t.check(controller.pickSurface(Qt.vector3d(0, 0, 200), d, {kind: "plane", unpickablePlane: t.s.plane}), 0, "own plane excluded"); t.check(controller.pickNearSurface(Qt.vector3d(0, 0, 200), d, 45, {kind: "plane", unpickablePlane: t.s.plane}), 0, "own plane fallback excluded"); t.run("part.set_visible", {id: plane.id, visible: false}); ui.log("body, construction plane and section picking passed") })()
(() => { const t = Array.from(window.contentItem.children).find(c => c.objectName === "pickTest"); t.s.sketch = t.run("sketch.create", {plane: "XY", curves: [{type: "center_rectangle", center: [220, 15], width: 40, height: 30}]}).id; t.run("feature.extrude", {sketch: t.s.sketch, distance: 10}); const sk = t.run("document.parts").parts.find(p => p.kind === "sketch"); t.s.sketchPart = sk.id; if (sk.visible) ui.fail("consumed sketch is not hidden in the fixture"); const o = Qt.vector3d(220, 15, 100), d = Qt.vector3d(0, 0, -1), opt = {kind: "sketch", shownSketch: t.s.sketch}; t.check(controller.pickSurface(o, d, {kind: "sketch"}), 0, "ordinary hidden sketch"); t.check(controller.pickSurface(o, d, opt), sk.id, "shown consumed sketch"); t.check(controller.pickNearSurface(o, d, 30, opt), sk.id, "shown sketch fallback"); t.check(controller.pickSketchLine(Qt.vector3d(200, 15, 100), d, 1, opt), sk.id, "shown sketch line"); opt.hiddenPartIds = [sk.id]; t.check(controller.pickSurface(o, d, opt), 0, "explicit hide beats shown sketch"); t.check(controller.pickNearSurface(o, d, 30, opt), 0, "hidden sketch fallback"); t.check(controller.pickSketchLine(Qt.vector3d(200, 15, 100), d, 1, opt), 0, "hidden sketch line"); t.check(controller.pickSketchLine(Qt.vector3d(200, 15, 100), d, 1, {kind: "body", shownSketch: t.s.sketch}), 0, "body filter excludes sketch line"); ui.log("exact, fallback and line filters passed") })()
# Actual mouse selection remains available for the body, fitted surface and original scan.
viewport.setView(-90, 0)
ui.wait(400)
viewport.frameAround([510, 10, 5], 25)
ui.wait(300)
(() => { const t = Array.from(window.contentItem.children).find(c => c.objectName === "pickTest"); t.clickPoint(510, 10, 10) })()
ui.wait(250)
(() => { const t = Array.from(window.contentItem.children).find(c => c.objectName === "pickTest"); if (window.selectedPartId !== t.s.body) ui.fail("mouse did not select body") })()
ui.shot("cad94_normal_body_pick.png")
viewport.frameAround([0, 0, 45.7], 25)
ui.wait(300)
(() => { const t = Array.from(window.contentItem.children).find(c => c.objectName === "pickTest"); t.clickPoint(0, 0, 45.7) })()
ui.wait(250)
(() => { const t = Array.from(window.contentItem.children).find(c => c.objectName === "pickTest"); if (window.selectedPartId !== t.s.surface) ui.fail("mouse did not select fitted surface"); t.run("part.set_visible", {id: t.s.surface, visible: false}); t.run("part.set_visible", {id: t.s.scan, visible: true}) })()
ui.wait(300)
(() => { const t = Array.from(window.contentItem.children).find(c => c.objectName === "pickTest"); t.clickPoint(0, 0, 45.7) })()
ui.wait(250)
(() => { const t = Array.from(window.contentItem.children).find(c => c.objectName === "pickTest"); if (window.selectedPartId !== t.s.scan) ui.fail("mouse did not select scan"); ui.log("normal body, fitted surface and scan mouse picks passed") })()
ui.shot("cad94_normal_scan_pick.png")
