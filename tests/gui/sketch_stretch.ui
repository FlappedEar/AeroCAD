# CAD-274: Stretch (Fusion: Sketch > Modify > Stretch) with real clicks: a window round the top edge of a
# rectangle, a base point and where it goes make the rectangle taller; the bottom stays.
# Run: AeroCAD --ui-script <this file>
ui.wait(800)
Qt.createQmlObject('import QtQuick; Item { objectName: "stTest"; visible: false; function at(u, v) { const o = viewport.sketchOverlay; const q = o.toScreen([u, v]); return o.mapToItem(null, q.x, q.y) } function clickAt(u, v) { const p = at(u, v); ui.click(p.x, p.y) } function curves() { return controller.execute("sketch.curves", { sketch: activeSketch.id }).result.curves } }', window.contentItem)
(() => { const r = controller.execute("sketch.create", { plane: "XY", curves: [{ type: "rectangle", corner: [0, 0], width: 40, height: 20 }] }); if (!r.ok) ui.fail("sketch: " + r.error) })()
ui.wait(300)
(() => { enterSketch(controller.execute("timeline.list").result.features[0].id) })()
ui.wait(800)
(() => { viewport.restoreCameraState({ pivot: [20, 15, 0], pitch: -90, yaw: 0, distance: 140, orthographic: false }) })()
ui.wait(400)
(() => { if (!ui.clickText("MODIFY")) ui.fail("no MODIFY menu on the ribbon") })()
ui.wait(400)
(() => { if (!ui.clickText("Stretch")) ui.fail("no Stretch command"); if (sketchTool !== "stretch") ui.fail("Stretch did not start: " + sketchTool) })()
ui.wait(300)
(() => { const t = Array.from(window.contentItem.children).find(c => c.objectName === "stTest"); t.clickAt(-8, 14); t.clickAt(48, 26); const p = t.at(20, 20); ui.move(p.x, p.y) })()
ui.wait(300)
ui.shot("sketch-stretch-window.png")
(() => { const t = Array.from(window.contentItem.children).find(c => c.objectName === "stTest"); t.clickAt(20, 20); const p = t.at(20, 30); ui.move(p.x, p.y) })()
ui.wait(300)
ui.shot("sketch-stretch-preview.png")
(() => { const t = Array.from(window.contentItem.children).find(c => c.objectName === "stTest"); t.clickAt(20, 30) })()
ui.wait(600)
(() => { const t = Array.from(window.contentItem.children).find(c => c.objectName === "stTest"); let lo = 1e9, hi = -1e9, left = 1e9, right = -1e9; for (const c of t.curves()) for (const q of c.points) { lo = Math.min(lo, q[1]); hi = Math.max(hi, q[1]); left = Math.min(left, q[0]); right = Math.max(right, q[0]) } ui.log("stretched bounds x " + left + ".." + right + " y " + lo + ".." + hi); if (Math.abs(lo) > 1e-6 || Math.abs(hi - 30) > 1e-6 || Math.abs(left) > 1e-6 || Math.abs(right - 40) > 1e-6) ui.fail("expected the rectangle 40 wide and 30 tall, got x " + left + ".." + right + " y " + lo + ".." + hi); if (sketchTool !== "") ui.fail("the tool did not end: " + sketchTool) })()
