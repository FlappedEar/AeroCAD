# Replace Face (Fusion: Modify > Replace Face): the top face of a box moves up onto a construction plane.
# Run: AeroCAD --ui-script <this file>
ui.wait(800)
(() => { let r = controller.execute("feature.box", { corner: [0, 0, 0], size: [40, 40, 20] }); if (!r.ok) ui.fail("box: " + r.error); r = controller.execute("feature.plane", { base: "XY", offset: 30 }); if (!r.ok) ui.fail("plane: " + r.error) })()
ui.wait(300)
(() => { viewport.restoreCameraState({ pivot: [20, 20, 20], pitch: -35, yaw: 20, distance: 180, orthographic: false }) })()
ui.wait(300)
(() => { featureDialog.open("replace_face") })()
ui.wait(500)
(() => { if (featureDialog.type !== "replace_face") ui.fail("wrong dialog: " + featureDialog.type); featureDialog.pickKey = "faces" })()
ui.wait(300)
(() => { const p = viewport.viewPoint(Qt.vector3d(20, 5, 20)); const w = viewport.mapToItem(null, p.x, p.y); ui.click(w.x, w.y) })()
ui.wait(800)
(() => { const v = featureDialog.values.faces; ui.log("faces " + JSON.stringify(v)); if (!v || v.length !== 1) ui.fail("the click did not pick the top face: " + JSON.stringify(v)) })()
(() => { featureDialog.pickKey = "to" })()
ui.wait(300)
(() => { const p = viewport.viewPoint(Qt.vector3d(20, 20, 30)); const w = viewport.mapToItem(null, p.x, p.y); ui.click(w.x, w.y) })()
ui.wait(800)
(() => { const v = featureDialog.values.to; ui.log("to " + JSON.stringify(v)); if (!v || v.plane === undefined) ui.fail("the click did not pick the plane: " + JSON.stringify(v)) })()
(() => { if (featureDialog.error) ui.fail("dialog error: " + featureDialog.error) })()
(() => { const b = controller.execute("timeline.list").result.bodies[0]; ui.log("preview volume " + b.volume); if (Math.abs(b.volume - 48000) > 1) ui.fail("preview volume " + b.volume + ", expected 48000") })()
ui.shot("replace-face.png")
(() => { if (!ui.clickText("OK")) ui.fail("no OK button") })()
ui.wait(800)
(() => { const tl = controller.execute("timeline.list").result; const f = tl.features.find(x => x.type === "replace_face"); if (!f) ui.fail("no replace_face in the timeline"); if (f.status !== "ok") ui.fail("step status " + f.status); ui.log("params " + JSON.stringify(f.params)); if (!f.params.faces[0].relative) ui.fail("no topology hint stored: " + JSON.stringify(f.params)); if (Math.abs(tl.bodies[0].volume - 48000) > 1) ui.fail("volume " + tl.bodies[0].volume) })()
# Reopening the step gives the same dialog and OK keeps the result.
(() => { const f = controller.execute("timeline.list").result.features.find(x => x.type === "replace_face"); featureDialog.open("replace_face", f.params, f.id) })()
ui.wait(500)
(() => { if (featureDialog.type !== "replace_face") ui.fail("reopened as " + featureDialog.type); if (featureDialog.error) ui.fail("edit error: " + featureDialog.error) })()
(() => { if (!ui.clickText("OK")) ui.fail("no OK button") })()
ui.wait(800)
(() => { const tl = controller.execute("timeline.list").result; if (Math.abs(tl.bodies[0].volume - 48000) > 1) ui.fail("volume after edit " + tl.bodies[0].volume) })()
(() => { for (let i = 0; i < 6; ++i) controller.execute("edit.undo"); const tl = controller.execute("timeline.list").result; if (tl.features.some(x => x.type === "replace_face")) ui.fail("undo did not remove the step") })()
