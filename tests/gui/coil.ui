# CAD-271: Coil (Fusion: Create > Coil) from the SOLID tab: a 30 mm outer diameter spring of 4 mm
# wire, 5 turns at 8 mm pitch, is one solid of about 2 * pi * 13 * 5 * pi * 4 mm3.
# Run: AeroCAD --ui-script <this file>
ui.wait(800)
(() => { viewport.restoreCameraState({ pivot: [0, 0, 20], pitch: -25, yaw: 30, distance: 160, orthographic: false }) })()
ui.wait(300)
(() => { if (!ui.clickText("SOLID")) ui.fail("no SOLID tab") })()
ui.wait(300)
(() => { if (!ui.clickText("CREATE")) ui.log("no CREATE caption menu") })()
ui.wait(300)
(() => { if (!ui.clickText("Coil")) ui.fail("no Coil command") })()
ui.wait(800)
ui.shot("coil.png")
(() => { if (featureDialog.error) ui.fail("dialog error: " + featureDialog.error) })()
(() => { if (!ui.clickText("OK")) ui.fail("no OK button") })()
ui.wait(1000)
ui.shot("coil-done.png")
(() => { const tl = controller.execute("timeline.list").result; const b = tl.bodies[0]; const want = 2 * Math.PI * 13 * 5 * Math.PI * 4; ui.log("volume " + b.volume.toFixed(2) + " want " + want.toFixed(2)); if (tl.bodies.length !== 1 || Math.abs(b.volume - want) > want * 0.003) ui.fail("expected one coil of " + want + " mm3, got " + b.volume); if (!tl.features.find(x => x.type === "coil")) ui.fail("no coil feature in the timeline") })()
# Codex review of #239: a coil sized by height and pitch keeps its size when reopened and confirmed.
(() => { const c = controller.execute("feature.coil", { diameter: 30, section_size: 4, height: 60, pitch: 20, axis: "Z", operation: "new_body" }); if (!c.ok) ui.fail("coil by height/pitch: " + c.error); const tl = controller.execute("timeline.list").result; const f = tl.features.filter(x => x.type === "coil").pop(); const before = tl.bodies[tl.bodies.length - 1].volume; featureDialog.open("coil", f.params, f.id); featureDialog.apply(); const after = controller.execute("timeline.list").result; const stored = after.features.find(x => x.id === f.id).params; ui.log("reopened coil params " + JSON.stringify(stored)); if (stored.height !== 60 || stored.pitch !== 20 || stored.revolutions !== undefined) ui.fail("reopening changed the coil sizing: " + JSON.stringify(stored)); const v = after.bodies[after.bodies.length - 1].volume; if (Math.abs(v - before) > before * 1e-6) ui.fail("coil volume changed from " + before + " to " + v) })()
