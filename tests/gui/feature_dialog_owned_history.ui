# CAD-86: a modelling dialog undoes (Cancel) or joins (OK) only its own undo steps. Picking
# the imported STEP solid as the Combine target makes it editable (feature.base_body); an
# MCP client then renames another part while the dialog is open.
#   AeroCAD tests/data/models/dome.step --ui-script <this file>
ui.wait(1500)
(() => { const r = controller.execute("feature.box", {size: [20, 20, 20], corner: [-10, -10, 30]}); if (!r.ok) ui.fail("box: " + r.error) })()
(() => { const parts = controller.execute("document.parts").result.parts; ui.log("parts: " + parts.map(p => p.id + " " + p.name).join(", ")) })()
# The dome is the part whose name starts with "dome", the box the other one.
# 1. Cancel after an unrelated MCP rename: the rename stays, the dome stays editable.
(() => { featureDialog.open("combine", {}, 0); featureDialog.addPick(controller.partInfo(controller.execute("document.parts").result.parts.find(p => p.name.indexOf("dome") === 0).id), Qt.vector3d(0, 0, 40)); ui.log("after pick: base_body steps " + controller.execute("timeline.list").result.features.filter(f => f.type === "base_body").length + ", owned " + JSON.stringify(featureDialog.ownedSteps)); if (featureDialog.ownedSteps.length !== 1) ui.fail("picking the solid did not convert it") })()
(() => { if (!controller.execute("part.rename", {id: controller.execute("document.parts").result.parts.find(p => p.name.indexOf("dome") !== 0).id, name: "box renamed by MCP"}).ok) ui.fail("rename failed") })()
ui.wait(300)
ui.shot("owned_1_dialog_open.png")
(() => { featureDialog.close() })()
ui.wait(300)
(() => { ui.log("after Cancel: box " + controller.execute("document.parts").result.parts.find(p => p.name.indexOf("dome") !== 0).name + ", base_body steps " + controller.execute("timeline.list").result.features.filter(f => f.type === "base_body").length + ", status: " + controller.statusMessage + ", history " + JSON.stringify(controller.execute("edit.history").result)); if (controller.execute("document.parts").result.parts.find(p => p.name.indexOf("dome") !== 0).name !== "box renamed by MCP") ui.fail("Cancel undid the MCP rename"); if (controller.execute("timeline.list").result.features.filter(f => f.type === "base_body").length !== 1 || controller.statusMessage.indexOf("stays editable") < 0) ui.fail("Cancel did not keep the conversion and say so") })()
ui.shot("owned_2_cancel_kept_rename.png")
(() => { controller.execute("edit.undo"); controller.execute("edit.undo"); ui.log("undid rename and conversion: box " + controller.execute("document.parts").result.parts.find(p => p.name.indexOf("dome") !== 0).name + ", conversions " + controller.execute("timeline.list").result.features.filter(f => f.type === "base_body").length); if (controller.execute("timeline.list").result.features.filter(f => f.type === "base_body").length !== 0) ui.fail("could not get back to the imported dome") })()
# 2. Cancel without anything in between undoes the conversion.
(() => { featureDialog.open("combine", {}, 0); featureDialog.addPick(controller.partInfo(controller.execute("document.parts").result.parts.find(p => p.name.indexOf("dome") === 0).id), Qt.vector3d(0, 0, 40)); featureDialog.close(); ui.log("plain Cancel: conversions " + controller.execute("timeline.list").result.features.filter(f => f.type === "base_body").length); if (controller.execute("timeline.list").result.features.filter(f => f.type === "base_body").length !== 0) ui.fail("Cancel did not undo the dialog's own conversion") })()
# 3. OK after an unrelated MCP rename: Combine is its own undo step, the rename is not in it.
(() => { featureDialog.open("combine", {operation: "join"}, 0); featureDialog.addPick(controller.partInfo(controller.execute("document.parts").result.parts.find(p => p.name.indexOf("dome") === 0).id), Qt.vector3d(0, 0, 40)) })()
(() => { controller.execute("part.rename", {id: controller.execute("document.parts").result.parts.find(p => p.name.indexOf("dome") !== 0).id, name: "renamed again"}) })()
(() => { featureDialog.addPick(controller.partInfo(controller.execute("document.parts").result.parts.find(p => p.name.indexOf("dome") !== 0).id), Qt.vector3d(0, 0, 40)); featureDialog.apply(); ui.log("after OK: dialog open " + (featureDialog.type !== "") + ", error " + featureDialog.error + ", history " + JSON.stringify(controller.execute("edit.history").result)); if (featureDialog.type !== "") ui.fail("Combine failed: " + featureDialog.error) })()
(() => { controller.execute("edit.undo"); const b = controller.execute("document.parts").result.parts.find(p => p.name.indexOf("dome") !== 0); ui.log("undo after OK: box " + (b ? b.name : "none")); if (!b || b.name !== "renamed again") ui.fail("undoing Combine also undid the MCP rename") })()
(() => { controller.execute("edit.undo"); controller.execute("edit.undo"); ui.log("back to the start: base_body steps " + controller.execute("timeline.list").result.features.filter(f => f.type === "base_body").length); if (controller.execute("timeline.list").result.features.filter(f => f.type === "base_body").length !== 0) ui.fail("could not undo the conversion") })()
# 4. OK with nothing in between: making the solid editable and Combine are one undo step.
(() => { featureDialog.open("combine", {operation: "join"}, 0); featureDialog.addPick(controller.partInfo(controller.execute("document.parts").result.parts.find(p => p.name.indexOf("dome") === 0).id), Qt.vector3d(0, 0, 40)); featureDialog.addPick(controller.partInfo(controller.execute("document.parts").result.parts.find(p => p.name.indexOf("dome") !== 0).id), Qt.vector3d(0, 0, 40)); featureDialog.apply(); ui.log("plain OK: base_body steps " + controller.execute("timeline.list").result.features.filter(f => f.type === "base_body").length + ", history " + JSON.stringify(controller.execute("edit.history").result)) })()
(() => { controller.execute("edit.undo"); ui.log("one undo after plain OK: base_body steps " + controller.execute("timeline.list").result.features.filter(f => f.type === "base_body").length); if (controller.execute("timeline.list").result.features.filter(f => f.type === "base_body").length !== 0) ui.fail("OK did not join the conversion with Combine") })()
