# CAD-285: Web (Fusion: Create > Web): every curve of a sketch becomes a wall, curves may cross.
# Two 50 mm lines in a cross give a plus-shaped wall, 4 mm thick and 12 mm tall, in one body.
# Run: AeroCAD --ui-script <this file>
ui.wait(800)
(() => { const r = controller.execute("sketch.create", { plane: "XY", curves: [{ type: "line", start: [-25, 0], end: [25, 0] }, { type: "line", start: [0, -25], end: [0, 25] }] }); if (!r.ok) ui.fail("curve sketch: " + r.error) })()
ui.wait(300)
(() => { viewport.restoreCameraState({ pivot: [0, 0, 5], pitch: -35, yaw: 25, distance: 160, orthographic: false }) })()
ui.wait(300)
(() => { if (!ui.clickText("SOLID")) ui.fail("no SOLID tab") })()
ui.wait(300)
(() => { if (!ui.clickText("CREATE")) ui.log("no CREATE caption menu") })()
ui.wait(300)
(() => { if (!ui.clickText("Web")) ui.fail("no Web command") })()
ui.wait(800)
(() => { if (featureDialog.type !== "web") ui.fail("the Web button did not open the Web dialog: " + featureDialog.type) })()
(() => { const sk = controller.execute("timeline.list").result.features.filter(f => f.type === "sketch").pop(); featureDialog.setValue("path", { sketch: sk.id }); featureDialog.setValue("thickness", 4); featureDialog.setValue("depth", 12) })()
ui.wait(800)
ui.shot("web.png")
(() => { if (featureDialog.error) ui.fail("dialog error: " + featureDialog.error) })()
(() => { if (!ui.clickText("OK")) ui.fail("no OK button") })()
ui.wait(800)
(() => { const tl = controller.execute("timeline.list").result; const b = tl.bodies[0]; const want = 2 * 50 * 4 * 12 - 4 * 4 * 12; ui.log("volume " + b.volume.toFixed(2) + " want " + want); if (tl.bodies.length !== 1 || Math.abs(b.volume - want) > 1) ui.fail("expected one web of " + want + " mm3, got " + b.volume); if (!tl.features.find(x => x.type === "rib")) ui.fail("no rib step in the timeline") })()
(() => { const f = controller.execute("timeline.list").result.features.find(x => x.type === "rib"); featureDialog.open("rib", f.params, f.id) })()
ui.wait(500)
(() => { if (featureDialog.error) ui.fail("edit error: " + featureDialog.error) })()
(() => { if (!ui.clickText("OK")) ui.fail("no OK button") })()
ui.wait(500)
