# CAD-152: Fillet, Chamfer and Shell show a drag arrow (Fusion), on the first picked
# edge or face; dragging it sets Radius / Distance / Thickness with the live preview following.
# Run: AeroCAD --ui-script <this file>
ui.wait(800)
(() => { const r = controller.execute("feature.box", { corner: [0, 0, 0], size: [40, 30, 20] }); if (!r.ok) ui.fail("box: " + r.error) })()
ui.wait(300)
(() => { viewport.restoreCameraState({ pivot: [20, 5, 15], pitch: -30, yaw: 25, distance: 70, orthographic: false }) })()
ui.wait(300)
(() => { if (!ui.clickText("SOLID")) ui.fail("no SOLID tab") })()
ui.wait(300)
(() => { if (!ui.clickText("Fillet")) ui.fail("no Fillet button") })()
ui.wait(500)
# Pick the top front edge (y = 0, z = 20) with a real click.
(() => { const s = viewport.modelToScreen(Qt.vector3d(28, 0, 20)); const w = viewport.mapToItem(null, s.x, s.y); ui.click(w.x, w.y) })()
ui.wait(800)
(() => { const a = viewport.distanceArrow; ui.log("fillet arrow " + JSON.stringify(a)); if (!a) ui.fail("no fillet arrow"); const k = Math.SQRT1_2; if (Math.abs(a.base[0] - 20) > 1e-6 || Math.abs(a.base[1]) > 1e-6 || Math.abs(a.base[2] - 20) > 1e-6) ui.fail("the arrow is not on the middle of the picked edge"); if (Math.abs(a.direction[1] - k) > 1e-6 || Math.abs(a.direction[2] + k) > 1e-6) ui.fail("the arrow does not point into the corner") })()
ui.shot("fillet-arrow-start.png")
(() => { const a = viewport.distanceArrow; const g = t => { const q = Qt.vector3d(a.base[0] + a.direction[0] * t, a.base[1] + a.direction[1] * t, a.base[2] + a.direction[2] * t); const p = viewport.viewPoint(q); return viewport.mapToItem(null, p.x, p.y) }; const p0 = g(a.distance), p1 = g(6); ui.drag(p0.x, p0.y, p1.x, p1.y, "left", "", 12) })()
ui.wait(800)
(() => { const v = featureDialog.values; ui.log("radius after drag " + v.radius); if (Math.abs(v.radius - 6) > 0.6) ui.fail("dragging the arrow did not set the radius to about 6") })()
(() => { const a = viewport.distanceArrow; if (!a || Math.abs(a.base[0] - 20) > 1e-6 || Math.abs(a.base[2] - 20) > 1e-6) ui.fail("the arrow moved off the edge while the preview is shown") })()
ui.shot("fillet-arrow-dragged.png")
(() => { if (!ui.clickText("OK")) ui.fail("no OK button") })()
ui.wait(800)
(() => { const b = controller.execute("timeline.list").result.bodies.slice(-1)[0]; const f = controller.execute("timeline.list").result.features.find(x => x.type === "fillet"); const r = Number(f.params.radius); if (Math.abs(r - 6) > 0.6) ui.fail("the fillet step does not have the dragged radius: " + r); const want = 40 * 30 * 20 - 40 * r * r * (1 - Math.PI / 4); ui.log("filleted volume " + b.volume.toFixed(2) + ", want " + want.toFixed(2)); if (Math.abs(b.volume - want) > 1e-3 * want) ui.fail("the fillet does not have the dragged radius") })()
# Shell: the arrow is on the removed face, into the body.
(() => { if (!ui.clickText("Shell")) ui.fail("no Shell button") })()
ui.wait(500)
(() => { const s = viewport.modelToScreen(Qt.vector3d(20, 15, 20)); const w = viewport.mapToItem(null, s.x, s.y); ui.click(w.x, w.y) })()
ui.wait(800)
(() => { const a = viewport.distanceArrow; ui.log("shell arrow " + JSON.stringify(a)); if (!a || Math.abs(a.direction[2] + 1) > 1e-6) ui.fail("no shell arrow into the body") })()
(() => { const a = viewport.distanceArrow; const g = t => { const p = viewport.viewPoint(Qt.vector3d(a.base[0], a.base[1], a.base[2] - t)); return viewport.mapToItem(null, p.x, p.y) }; const p0 = g(a.distance), p1 = g(4); ui.drag(p0.x, p0.y, p1.x, p1.y, "left", "", 12) })()
ui.wait(800)
(() => { const v = featureDialog.values; ui.log("thickness after drag " + v.thickness); if (Math.abs(v.thickness - 4) > 0.6) ui.fail("dragging the arrow did not set the thickness to about 4") })()
(() => { if (featureDialog.error) ui.fail("shell preview failed: " + featureDialog.error) })()
ui.shot("shell-arrow-dragged.png")
# OK: the filleted box is shelled (OCCT alone could not open a face next to a fillet).
(() => { if (!ui.clickText("OK")) ui.fail("no OK button") })()
ui.wait(800)
(() => { const tl = controller.execute("timeline.list").result; const f = tl.features.find(x => x.type === "shell"); if (!f || f.status !== "ok") ui.fail("no shell step: " + JSON.stringify(f)); const t = Number(f.params.thickness), r = 6; const b = tl.bodies.slice(-1)[0]; const rounded = 40 * 30 * 20 - 40 * r * r * (1 - Math.PI / 4); const section = (30 - 2 * t) * (20 - t) - ((r - t) * r - Math.PI * (r - t) * (r - t) / 4); const want = rounded - (40 - 2 * t) * section; ui.log("shell t " + t + " volume " + b.volume.toFixed(2) + ", want " + want.toFixed(2)); if (Math.abs(b.volume - want) > 1e-3 * want) ui.fail("the shell does not have the dragged thickness") })()
ui.shot("shell-arrow-done.png")
# Editing the fillet: the arrow is on the picked edge of the body before the fillet (Fusion
# rolls back), and after an earlier step changes the body it follows the resized edge
# (Codex on PR #125: not where it was placed last time).
(() => { const tl = controller.execute("timeline.list").result; const f = tl.features.find(x => x.type === "fillet"); editFeature(f) })()
ui.wait(800)
(() => { const a = viewport.distanceArrow; const k = Math.SQRT1_2; ui.log("edited fillet arrow " + JSON.stringify(a)); if (!a || Math.abs(a.base[0] - 20) > 1e-6 || Math.abs(a.base[1]) > 1e-6 || Math.abs(a.base[2] - 20) > 1e-6) ui.fail("edited fillet: arrow not on the middle of the picked edge"); if (Math.abs(a.direction[1] - k) > 1e-6 || Math.abs(a.direction[2] + k) > 1e-6) ui.fail("edited fillet: the arrow does not point into the corner") })()
(() => { featureDialog.close() })()
ui.wait(300)
(() => { const tl = controller.execute("timeline.list").result; const box = tl.features.find(x => x.type === "box"); const r = controller.execute("feature.edit", { id: box.id, params: { size: [60, 30, 20] } }); if (!r.ok) ui.fail("box edit: " + r.error) })()
ui.wait(800)
(() => { const tl = controller.execute("timeline.list").result; const f = tl.features.find(x => x.type === "fillet"); editFeature(f) })()
ui.wait(800)
(() => { const a = viewport.distanceArrow; ui.log("reopened fillet arrow " + JSON.stringify(a)); if (!a || Math.abs(a.base[0] - 30) > 1e-6 || Math.abs(a.base[1]) > 1e-6 || Math.abs(a.base[2] - 20) > 1e-6) ui.fail("reopened fillet after the box grew: arrow not on the middle x = 30 of the longer edge") })()
(() => { const tl = controller.execute("timeline.list").result; if (tl.marker !== undefined && tl.marker !== tl.features.length) ui.fail("placing the arrow moved the timeline marker: " + tl.marker) })()
(() => { featureDialog.close() })()
