# SPDX-License-Identifier: GPL-3.0-or-later
# CAD-77: an imported source edit must rebuild its timeline body in the live GUI.
# Run from the repository root:
#   AeroCAD tests/data/tetrahedron.stl --ui-script tests/gui/source_regeneration.ui
# Uses the actual ribbon, Move / Rotate / Scale panel and Edit menu; command queries assert geometry.
# Output: docs/images/audit/cad-77-regenerated-source.png and build/source-regeneration.aerocad.
window.width = 1440; window.height = 900
ui.wait(500)
(() => { const p = controller.execute("document.parts").result.parts; if (p.length !== 1 || p[0].kind !== "imported") ui.fail("expected the imported tetrahedron"); else window.selectPart(p[0].id) })()
ui.clickText("MESH")
ui.clickText("To Body")
ui.wait(300)
(() => { const b = controller.execute("document.parts").result.parts.find(p => p.kind === "body"); if (!b || Math.abs(b.bounds.size[0] - 10) > 0.001) ui.fail("initial body is not 10 mm"); else ui.log("Initial body: " + JSON.stringify(b.bounds.size)) })()
(() => { const source = controller.execute("document.parts").result.parts.find(p => p.kind === "imported"); window.selectPart(source.id) })()
(() => { const find = i => i.actionId === "scale" && i.visible && i.enabled ? i : Array.from(i.children).map(find).find(Boolean); const button = find(window.contentItem.parent); if (!button) ui.fail("no enabled Scale ribbon command"); else { const p = button.mapToItem(null, button.width / 2, button.height / 2); ui.click(p.x, p.y) } })()
ui.wait(200)
(() => { if (!transformPanel.visible) ui.fail("Scale did not start the Move / Rotate / Scale tool"); const find = i => i.objectName === "scale" && i.visible ? i : Array.from(i.children).map(find).find(Boolean); const field = find(transformPanel.contentItem); if (!field) ui.fail("Scale input was not shown"); else { const p = field.mapToItem(null, field.width / 2, field.height / 2); ui.click(p.x, p.y); field.selectAll(); field.text = "200"; field.typed = true; field.apply() } })()
(() => { if (Math.abs(viewport.transformScale - 2) > 1e-9) ui.fail("Scale input is not 200 percent") })()
ui.clickText("Done")
ui.wait(300)
(() => { const p = controller.execute("document.parts").result.parts; for (const part of p) if (Math.abs(part.bounds.size[0] - 20) > 0.001) ui.fail(part.kind + " stayed stale after Scale"); ui.log("After Scale: " + JSON.stringify(p.map(v => ({ id: v.id, kind: v.kind, size: v.bounds.size })))) })()
ui.clickText("&Edit")
ui.clickText(undoAction.text)
ui.wait(200)
(() => { const p = controller.execute("document.parts").result.parts; for (const part of p) if (Math.abs(part.bounds.size[0] - 10) > 0.001) ui.fail(part.kind + " did not undo in one step"); ui.log("Undo restored source and body to 10 mm") })()
ui.clickText("&Edit")
ui.clickText(redoAction.text)
ui.wait(200)
(() => { const p = controller.execute("document.parts").result.parts; for (const part of p) if (Math.abs(part.bounds.size[0] - 20) > 0.001) ui.fail(part.kind + " did not redo in one step"); const b = p.find(p => p.kind === "body"); window.selectPart(b.id); ui.log("Redo restored source and body to 20 mm") })()
viewport.fitAll()
ui.wait(500)
(() => { if (Math.abs(window.selectionInfo.sizeX - 20) > 0.001) ui.fail("the selected body's properties did not update to 20 mm") })()
ui.shot("docs/images/audit/cad-77-regenerated-source.png")
(() => { const r = controller.execute("project.save", { path: "build/source-regeneration.aerocad" }); if (!r.ok) ui.fail("Save: " + r.error) })()
(() => { const r = controller.execute("project.open", { path: "build/source-regeneration.aerocad" }); if (!r.ok) ui.fail("Open: " + r.error) })()
ui.wait(300)
(() => { const p = controller.execute("document.parts").result.parts; for (const part of p) if (Math.abs(part.bounds.size[0] - 20) > 0.001) ui.fail(part.kind + " changed after reopening"); ui.log("Save/reopen kept source and body at 20 mm") })()
