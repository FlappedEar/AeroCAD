# CAD-94: actual mouse clicks must reach a sketch behind the live Extrude preview.
# The fixture has two disjoint profiles. No profile is selected through addPick or metadata.
ui.wait(800)
(() => { const r = controller.execute("sketch.create", {plane: "XY", curves: [{type: "center_rectangle", center: [20, 15], width: 40, height: 30}, {type: "center_rectangle", center: [70, 15], width: 40, height: 30}]}); if (!r.ok) ui.fail("sketch: " + r.error); window.selectPart(controller.execute("document.parts").result.parts.find(p => p.kind === "sketch").id); viewport.setView(-90, 0); viewport.fitAll() })()
ui.wait(300)
ui.clickText("SOLID")
ui.clickText("Extrude")
ui.wait(800)
viewport.frameAround([20, 15, 0], 55)
ui.wait(300)
# A wheel gesture still anchors on the visible preview body while clicks target the sketch.
(() => { const p = viewport.viewPoint(Qt.vector3d(20, 15, 0)); const nav = viewport.pickPart(p.x, p.y, true), pick = viewport.pickPart(p.x, p.y); if (!nav || controller.partInfo(nav.partId).kind !== "body" || !pick || controller.partInfo(pick.partId).kind !== "sketch") ui.fail("navigation and profile picks did not use their own filters"); const before = viewport.scenePointUnder(p.x, p.y, true); const q = viewport.mapToItem(null, p.x, p.y); ui.mouseWheel(q.x, q.y, 1); const after = viewport.scenePointUnder(p.x, p.y, true); const drift = before && after ? before.minus(after).length() : -1; ui.log("preview navigation anchor drift: " + drift); if (drift < 0 || drift > 0.05) ui.fail("wheel lost the visible preview anchor") })()
(() => { ui.log("preview: " + featureDialog.previewApplied + ", kind: " + viewport.pickKind + ", shown sketch: " + viewport.shownSketch); if (!featureDialog.previewApplied || viewport.pickKind !== "sketch") ui.fail("Extrude profile picking is not active"); const p = viewport.viewPoint(Qt.vector3d(20, 15, 0)); const q = viewport.mapToItem(null, p.x, p.y); ui.click(q.x, q.y) })()
ui.wait(600)
(() => { ui.log("first profile: " + JSON.stringify(featureDialog.values.points) + ", selected: " + window.selectedInfo().name); if (!featureDialog.values.points || featureDialog.values.points.length !== 1) ui.fail("preview body intercepted the first profile click") })()
ui.shot("cad94_first_profile.png")
(() => { const p = viewport.viewPoint(Qt.vector3d(70, 15, 0)); const q = viewport.mapToItem(null, p.x, p.y); ui.click(q.x, q.y) })()
ui.wait(600)
(() => { ui.log("both profiles: " + JSON.stringify(featureDialog.values.points)); const p = featureDialog.values.points || []; if (p.length !== 2 || Math.abs(p[0][0] - 20) > 0.05 || Math.abs(p[0][1] - 15) > 0.05 || Math.abs(p[1][0] - 70) > 0.05 || Math.abs(p[1][1] - 15) > 0.05) ui.fail("both rectangle profiles were not picked") })()
ui.shot("cad94_two_profiles.png")
ui.clickText("Cancel")
ui.wait(400)
(() => { const f = controller.execute("timeline.list").result.features; if (f.length !== 1 || f[0].type !== "sketch") ui.fail("Cancel left an Extrude feature"); window.selectPart(controller.execute("document.parts").result.parts.find(p => p.kind === "sketch").id) })()
ui.clickText("Extrude")
ui.wait(600)
(() => { const p = viewport.viewPoint(Qt.vector3d(20, 15, 0)); const q = viewport.mapToItem(null, p.x, p.y); ui.click(q.x, q.y) })()
ui.wait(500)
ui.clickText("OK")
ui.wait(500)
(() => { const f = controller.execute("timeline.list").result.features; ui.log("committed: " + JSON.stringify(f.map(x => ({type: x.type, points: x.params.points})))); if (featureDialog.type !== "" || f.length !== 2 || f[1].params.points.length !== 1) ui.fail("OK did not commit the selected profile"); controller.execute("edit.undo"); if (controller.execute("timeline.list").result.features.length !== 1) ui.fail("Undo did not remove Extrude"); controller.execute("edit.redo"); const redo = controller.execute("timeline.list").result.features; if (redo.length !== 2 || redo[1].params.points.length !== 1) ui.fail("Redo did not restore the selected profile") })()
ui.shot("cad94_committed_redone.png")
