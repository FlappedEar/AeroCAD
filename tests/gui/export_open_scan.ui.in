# Real GUI: an open scan and a fitted surface can each be exported after warning consent.
ui.wait(1200)
(() => { const scan = controller.execute("document.parts").result.parts[0]; if (!scan) { ui.fail("scan missing"); return } window.selectPart(scan.id) })()
ui.clickText("Selected")
ui.wait(300)
exportDialog.selectedFile = "file://@CAD92_DIR@/dome-scan.stl"; exportDialog.accepted(); exportDialog.close()
ui.wait(300)
(() => { const c=exportCheckDialog.check; ui.log("SCAN_CHECK " + JSON.stringify(c)); if (!exportCheckDialog.visible || !c.canExport || !c.warnings) ui.fail("open scan did not offer warning consent") })()
ui.clickText("Export Anyway")
ui.wait(500)
(() => { if (exportCheckDialog.visible || exportMessage.visible || controller.statusMessage.indexOf("Exported") < 0) ui.fail("open scan export failed"); const scan=controller.execute("document.parts").result.parts[0]; const b=controller.execute("selection.brush", {id:scan.id,points:[[0,0,45.7]],radius:20}); if (!b.ok) { ui.fail(b.error); return } const fit=controller.execute("surface.fit_selection", {id:scan.id,tolerance:0.5}); if (!fit.ok) { ui.fail(fit.error); return } window.selectPart(fit.result.id); ui.log("FITTED_SURFACE " + fit.result.id) })()
ui.wait(500)
ui.clickText("Selected")
ui.wait(300)
exportDialog.selectedFile = "file://@CAD92_DIR@/fitted-surface.3mf"; exportDialog.accepted(); exportDialog.close()
ui.wait(300)
(() => { const c=exportCheckDialog.check; ui.log("FITTED_CHECK " + JSON.stringify(c)); if (!exportCheckDialog.visible || !c.canExport || !c.warnings) ui.fail("fitted surface did not offer warning consent") })()
ui.shot("@CAD92_DIR@/fitted-surface-warning.png")
ui.clickText("Export Anyway")
ui.wait(500)
(() => { if (exportCheckDialog.visible || exportMessage.visible || controller.statusMessage.indexOf("Exported") < 0) ui.fail("fitted surface export failed") })()
