# SPDX-License-Identifier: GPL-3.0-or-later
# CAD-136: the Wind Tunnel run list belongs to the open design. Runs of parts that are not in
# the document (other designs) are folded under "Runs from other designs" and never picked as
# A on first show. Prepared runs only (no solver).
ui.wait(1000)
(() => { for (const r of controller.execute("simulation.list").result.runs) controller.execute("simulation.delete", { run: r.id }) })()
# A run of another design: its part is removed afterwards.
(() => { const p = controller.execute("document.parts").result.parts[0]; const d = controller.execute("part.duplicate", { id: p.id }); if (!d.ok) ui.fail("duplicate: " + d.error); const other = d.result.id; const r = controller.execute("simulation.run", { id: other, prepareOnly: true, label: "other design", speed: 30 }); if (!r.ok) ui.fail("other run: " + r.error); controller.execute("part.remove", { id: other }) })()
(() => { const p = controller.execute("document.parts").result.parts[0]; const r = controller.execute("simulation.run", { id: p.id, prepareOnly: true, label: "this design" }); if (!r.ok) ui.fail("own run: " + r.error); window.selectPart(p.id) })()
ui.clickText("SIMULATE")
ui.wait(300)
ui.clickText("Wind Tunnel")
ui.wait(1500)
(() => { const own = simulationPanel.ownRuns.map(r => r.source.label), other = simulationPanel.otherRuns.map(r => r.source.label); ui.log("OWN " + own + " OTHER " + other); if (own.join() !== "this design" || other.join() !== "other design") ui.fail("run split") })()
(() => { const a = simulationPanel.runs.find(r => r.id === simulationPanel.activeRun); ui.log("A " + (a ? a.source.label : "none")); if (!a || a.source.label !== "this design") ui.fail("first-show A must be this design's run") })()
ui.clickText("[A] this design · " + simulationPanel.ownRuns[0].source.partName)
ui.clickText("▸ Runs from other designs (1)")
ui.wait(400)
ui.clickText("other design · " + simulationPanel.otherRuns[0].source.partName)
ui.shot("cfd-run-list.png")
ui.log("cfd run list done")
