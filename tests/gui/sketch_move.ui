# CAD-244: Sketch Move/Copy (Fusion: Sketch > Move/Copy, M) with real clicks:
#  - select a circle, M, click its centre and where it goes: the circle moves (one undo);
#  - select the rectangle's sides, right-click > Move/Copy, tick Copy, type a 90 degree turn,
#    Enter: a turned copy is added about the rectangle's middle and the original stays.
# Run: AeroCAD --ui-script <this file>
Qt.createQmlObject('import QtQuick; Item { objectName: "smTest"; visible: false; function find(i, name) { if (!i) return null; if (i.objectName === name && i.visible) return i; const ch = i.children || []; for (let k = 0; k < ch.length; ++k) { const r = find(ch[k], name); if (r) return r } return null } function at(q) { const o = viewport.sketchOverlay; const p = o.toScreen(q); return o.mapToItem(null, p.x, p.y) } function curves() { return controller.execute("sketch.curves", { sketch: activeSketch.id }).result.curves } }', window.contentItem)
ui.wait(800)
(() => { const r = controller.execute("sketch.create", { plane: "XY", curves: [{ type: "rectangle", corner: [-20, -10], width: 40, height: 20 }, { type: "circle", center: [30, 0], radius: 4 }] }); if (!r.ok) ui.fail("sketch: " + r.error) })()
ui.wait(300)
(() => { enterSketch(controller.execute("timeline.list").result.features[0].id) })()
ui.wait(800)
ui.key("Esc")
ui.wait(300)
# Select the circle (click its edge), M, base point at its centre, then where it goes.
(() => { const w = Array.from(window.contentItem.children).find(c => c.objectName === "smTest").at([34, 0]); ui.click(w.x, w.y) })()
ui.wait(300)
(() => { ui.log("selected " + JSON.stringify(viewport.sketchOverlay.selectedCurves)); if (JSON.stringify(viewport.sketchOverlay.selectedCurves) !== "[4]") ui.fail("the circle was not selected") })()
ui.key("M")
ui.wait(300)
(() => { if (sketchTool !== "move") ui.fail("Move/Copy did not start: " + sketchTool) })()
(() => { const w = Array.from(window.contentItem.children).find(c => c.objectName === "smTest").at([30, 0]); ui.move(w.x, w.y); ui.click(w.x, w.y) })()
ui.wait(300)
(() => { const w = Array.from(window.contentItem.children).find(c => c.objectName === "smTest").at([40, 10]); ui.move(w.x, w.y) })()
ui.wait(300)
ui.shot("/mnt/project-files/ux/sketch-move-preview.png")
(() => { const w = Array.from(window.contentItem.children).find(c => c.objectName === "smTest").at([40, 10]); ui.click(w.x, w.y) })()
ui.wait(600)
(() => { const c = Array.from(window.contentItem.children).find(c => c.objectName === "smTest").curves(); ui.log("circle at " + JSON.stringify(c[4].points[0]) + ", undo '" + controller.undoText + "'"); if (Math.hypot(c[4].points[0][0] - 40, c[4].points[0][1] - 10) > 1e-6) ui.fail("the circle did not move to (40, 10)"); if (sketchTool !== "") ui.fail("the tool stays after the move") })()
(() => { undoAction.trigger() })()
ui.wait(500)
(() => { const c = Array.from(window.contentItem.children).find(c => c.objectName === "smTest").curves(); if (Math.hypot(c[4].points[0][0] - 30, c[4].points[0][1]) > 1e-6) ui.fail("one undo did not bring the circle back: " + JSON.stringify(c[4].points[0])) })()
# The rectangle's sides, right-click > Move/Copy, Copy, a 90 degree turn, Enter.
(() => { const t = Array.from(window.contentItem.children).find(c => c.objectName === "smTest"); [[0, -10], [20, 0], [0, 10], [-20, 0]].forEach((q, i) => { const w = t.at(q); ui.click(w.x, w.y, "left", i ? "shift" : "") }) })()
ui.wait(300)
(() => { if (viewport.sketchOverlay.selectedCurves.length !== 4) ui.fail("expected the 4 sides selected: " + JSON.stringify(viewport.sketchOverlay.selectedCurves)) })()
(() => { const w = Array.from(window.contentItem.children).find(c => c.objectName === "smTest").at([20, 0]); ui.click(w.x, w.y, "right") })()
ui.wait(400)
(() => { if (!ui.clickText("Move/Copy (M)")) ui.fail("no Move/Copy in the sketch menu") })()
ui.wait(300)
(() => { if (sketchTool !== "move" || viewport.sketchOverlay.moveCurves.length !== 4) ui.fail("Move/Copy did not start on the 4 sides: " + sketchTool) })()
(() => { const t = Array.from(window.contentItem.children).find(c => c.objectName === "smTest"); const b = t.find(viewport.sketchOverlay, "sketchMoveCopy"); if (!b) ui.fail("no Copy box"); const p = b.mapToItem(null, b.width / 2, b.height / 2); ui.click(p.x, p.y) })()
ui.wait(200)
(() => { const t = Array.from(window.contentItem.children).find(c => c.objectName === "smTest"); const f = t.find(viewport.sketchOverlay, "sketchMoveAngle"); if (!f) ui.fail("no Angle field"); const p = f.mapToItem(null, f.width / 2, f.height / 2); ui.click(p.x, p.y) })()
ui.wait(200)
ui.type("90")
ui.wait(300)
ui.shot("/mnt/project-files/ux/sketch-copy-preview.png")
ui.key("Return")
ui.wait(600)
(() => { const c = Array.from(window.contentItem.children).find(c => c.objectName === "smTest").curves(); ui.log("curves " + c.length + ", copy starts " + JSON.stringify(c[5] && c[5].points[0]) + ", original " + JSON.stringify(c[0].points[0])); if (c.length !== 9) ui.fail("no copy of the 4 sides: " + c.length); if (Math.hypot(c[5].points[0][0] - 10, c[5].points[0][1] + 20) > 1e-6) ui.fail("the copy is not turned 90 degrees about the middle"); if (Math.hypot(c[0].points[0][0] + 20, c[0].points[0][1] + 10) > 1e-6) ui.fail("the original moved") })()
ui.shot("build/sketch-move.png")
ui.log("sketch Move/Copy OK")
