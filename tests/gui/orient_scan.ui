# Lay on Face on a real scan (dome_scan: curved, 0.05 mm noise): the normal comes from the
# patch around the click, so the clicked spot ends up as the lowest point, on the ground.
# Run: AeroCAD tests/data/models/dome_scan.stl --ui-script <this file>
Qt.createQmlObject('import QtQuick; Item { objectName: "tfTest"; visible: false; property var s: ({}); function win(p) { const q = viewport.mapToItem(null, p.x, p.y); return Qt.point(q.x, q.y) } function lerp(a, b, t) { return Qt.point(a.x + (b.x - a.x) * t, a.y + (b.y - a.y) * t) } function part() { return controller.execute("document.parts").result.parts.find(p => p.kind === "imported") } function centre(b) { return [0, 1, 2].map(i => (b.min[i] + b.max[i]) / 2) } function find(i, name) { if (!i) return null; if (i.objectName === name) return i; const ch = i.children || []; for (let k = 0; k < ch.length; ++k) { const r = find(ch[k], name); if (r) return r } return null } }', window.contentItem)
ui.wait(800)
(() => { const parts = controller.execute("document.parts").result.parts; viewport.restoreCameraState({ pivot: [0, 0, 0], pitch: -45, yaw: 30, distance: 1, orthographic: false }); viewport.fitAll(); window.selectPart(parts[0].id); window.startTransform(parts[0].id); viewport.transformPickMode = "lay" })()
ui.wait(300)
(() => { const t = Array.from(window.contentItem.children).find(c => c.objectName === "tfTest"); const b = t.part().bounds; const c = t.centre(b); let hit = null, s = null; for (const f of [0.3, 0.25, 0.35, 0.2]) { s = viewport.modelToScreen(Qt.vector3d(c[0] + f * b.size[0], c[1], b.max[2])); const g = Qt.point(s.x, s.y + 0); hit = viewport.pickPart(g.x, g.y); if (hit) break } if (!hit) { ui.fail("no scan under the test point"); return } t.s.local = hit.localPoint; const n = controller.surfaceNormalAt(hit.partId, hit.localPoint, hit.triangle, 7); ui.log("picked " + [hit.point.x, hit.point.y, hit.point.z].map(v => v.toFixed(1)) + ", patch normal " + [n.x, n.y, n.z].map(v => v.toFixed(3))); const w = t.win(s); ui.click(w.x, w.y) })()
ui.wait(200)
(() => { const t = Array.from(window.contentItem.children).find(c => c.objectName === "tfTest"); const pb = viewport.previewBounds(); const p = viewport.previewPoint(viewport.transformTarget.partId, t.s.local); ui.log("laid scan: min z " + pb.min[2].toFixed(3) + ", clicked spot at z " + p.z.toFixed(3)); if (Math.abs(pb.min[2]) > 1e-3) ui.fail("scan not on the ground"); if (p.z > 0.5) ui.fail("the clicked spot is not where it lies: z " + p.z) })()
ui.shot("build/orient-2-scan.png")
