ui.wait(3000)
(() => { const t = Array.from(window.contentItem.children).find(c => c.objectName === "perf"); viewport.setView(-90, 0); viewport.fitAll() })()
ui.wait(500)
(() => { const t = Array.from(window.contentItem.children).find(c => c.objectName === "perf"); const ms = t.avgMs(k => viewport.pickPart(viewport.width / 2 + k, viewport.height / 2, true), 20); ui.log("pick: " + ms.toFixed(3) + " ms"); if (!viewport.pickPart(viewport.width / 2, viewport.height / 2, true)) ui.fail("nothing picked at the centre"); if (ms > 3) ui.fail("a pick on 1.5 M triangles takes " + ms.toFixed(1) + " ms (ray hierarchy not used?)"); const clip = t.avgMs(k => viewport.updateClipping(), 200); ui.log("clipping update: " + clip.toFixed(4) + " ms"); if (clip > 0.3) ui.fail("each camera move costs " + clip.toFixed(2) + " ms of bounds work") })()
(() => { const t = Array.from(window.contentItem.children).find(c => c.objectName === "perf"); const w = t.win(viewport.width / 2, viewport.height / 2); const c0 = ui.uiThreadCpu(); for (let k = 0; k < 20; ++k) ui.mouseWheel(w.x + k * 4, w.y, 1); const cpu = (ui.uiThreadCpu() - c0) / 20; ui.log("wheel zoom: " + cpu.toFixed(2) + " ms UI thread CPU per notch"); if (c0 >= 0 && cpu > 6) ui.fail("a wheel notch costs " + cpu.toFixed(1) + " ms of UI thread time") })()
ui.wait(300)
