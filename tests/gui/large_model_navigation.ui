(() => { const t = Array.from(window.contentItem.children).find(c => c.objectName === "perf"); if (!t.done) ui.fail("cube drag did not finish"); ui.log("ViewCube drag: " + t.cpu.toFixed(2) + " ms UI thread CPU per move"); if (t.hoveredOnCube) ui.fail("model hover picks ran during the ViewCube drag"); if (Math.abs(viewport.yaw - t.yaw0) < 5) ui.fail("dragging the ViewCube did not turn the view"); if (t.cpu > 12) ui.fail("a ViewCube drag step costs " + t.cpu.toFixed(1) + " ms of UI thread time") })()
(() => { const t = Array.from(window.contentItem.children).find(c => c.objectName === "perf"); const w = t.win(viewport.width * 0.4, viewport.height * 0.5); ui.move(w.x, w.y); ui.move(w.x + 3, w.y + 2) })()
ui.wait(400)
(() => { const t = Array.from(window.contentItem.children).find(c => c.objectName === "perf"); if (!viewport.hoveredPartId) ui.fail("hover highlight does not come back off the ViewCube") })()
(() => { const t = Array.from(window.contentItem.children).find(c => c.objectName === "perf"); const id = controller.execute("document.parts").result.parts[0].id; const parts = t.avgMs(k => controller.execute("document.parts"), 20); ui.log("document.parts: " + parts.toFixed(3) + " ms"); if (parts > 1) ui.fail("document.parts takes " + parts.toFixed(2) + " ms on one scan (bounds not cached?)"); const info = t.avgMs(k => controller.partInfo(id), 20); ui.log("partInfo: " + info.toFixed(3) + " ms"); if (info > 1) ui.fail("partInfo takes " + info.toFixed(2) + " ms"); ui.startClock(); const r = controller.execute("part.transform", { id: id, translate: [5, 0, 0] }); ui.log("move: " + ui.elapsedPrecise().toFixed(1) + " ms"); if (!r.ok) ui.fail("move: " + r.error) })()
(() => { const id = controller.execute("document.parts").result.parts[0].id; if (!(scan.displayedTriangles(id) > 0)) ui.fail("after a move the scan is not drawn until it is simplified again"); ui.startClock(); const r = controller.execute("part.transform", { id: id, angle: 30, axis: [0, 0, 1], scale: 1.5 }); ui.log("turn + scale: " + ui.elapsedPrecise().toFixed(1) + " ms"); if (!r.ok) ui.fail("turn: " + r.error) })()
(() => { const id = controller.execute("document.parts").result.parts[0].id; if (!(scan.displayedTriangles(id) > 0)) ui.fail("after a turn and scale the scan is not drawn until it is simplified again"); controller.execute("edit.undo") })()
(() => { const t = Array.from(window.contentItem.children).find(c => c.objectName === "perf"); const id = controller.execute("document.parts").result.parts[0].id; ui.startClock(); const r = controller.execute("edit.undo"); const ms = ui.elapsedPrecise(); ui.log("undo: " + ms.toFixed(1) + " ms"); if (!r.ok) ui.fail("undo: " + r.error); if (!(scan.displayedTriangles(id) > 0)) ui.fail("after Undo the scan is not drawn until it is simplified again"); ui.startClock(); controller.execute("edit.redo"); ui.log("redo: " + ui.elapsedPrecise().toFixed(1) + " ms"); if (!(scan.displayedTriangles(id) > 0)) ui.fail("after Redo the scan is not drawn until it is simplified again") })()

