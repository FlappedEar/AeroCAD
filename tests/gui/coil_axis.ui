# Coil about a construction axis: the dialog's Axis field picks the axis, the coil starts on it.
# Run: AeroCAD --ui-script <this file>
ui.wait(800)
(() => { const r = controller.execute("feature.box", { corner: [30, -5, 0], size: [10, 10, 10] }); if (!r.ok) ui.fail("box: " + r.error) })()
(() => { const r = controller.execute("feature.axis", { from: [0, 0, 0], to: [0, 0, 10] }); if (!r.ok) ui.fail("axis: " + r.error) })()
ui.wait(300)
(() => { viewport.restoreCameraState({ pivot: [10, 0, 5], pitch: -30, yaw: 20, distance: 220, orthographic: false }) })()
ui.wait(300)
(() => { featureDialog.open("coil") })()
ui.wait(500)
(() => { featureDialog.pickKey = "axis" })()
ui.wait(300)
(() => { const p = viewport.viewPoint(Qt.vector3d(0, 0, 5)); const w = viewport.mapToItem(null, p.x, p.y); ui.click(w.x, w.y) })()
ui.wait(800)
(() => { const ax = controller.execute("timeline.list").result.features.find(x => x.type === "axis"); const v = featureDialog.values.axis; ui.log("axis pick " + JSON.stringify(v)); if (!v || v.feature !== ax.id) ui.fail("clicking the axis did not pick it") })()
(() => { featureDialog.setValue("diameter", 10); featureDialog.setValue("section_size", 2) })()
ui.wait(800)
(() => { if (featureDialog.error) ui.fail("coil error: " + featureDialog.error) })()
ui.shot("coil-axis.png")
(() => { if (!ui.clickText("OK")) ui.fail("no OK button") })()
ui.wait(800)
(() => { const tl = controller.execute("timeline.list").result; const c = tl.features.find(x => x.type === "coil"); if (!c) ui.fail("no coil in the timeline"); const b = tl.bodies[tl.bodies.length - 1].bounds; ui.log("coil bounds " + JSON.stringify(b)); if (Math.abs((b.min.x + b.max.x) / 2) > 1 || Math.abs((b.min.y + b.max.y) / 2) > 1) ui.fail("the coil does not sit on the axis") })()
# Reopening keeps the picked axis.
(() => { const c = controller.execute("timeline.list").result.features.find(x => x.type === "coil"); featureDialog.open("coil", c.params, c.id) })()
ui.wait(500)
(() => { const v = featureDialog.values.axis; if (!v || v.feature === undefined) ui.fail("reopened coil lost its axis: " + JSON.stringify(v)); if (featureDialog.error) ui.fail("edit error: " + featureDialog.error) })()
(() => { if (!ui.clickText("OK")) ui.fail("no OK button") })()
ui.wait(500)
(() => { controller.execute("edit.undo"); controller.execute("edit.undo"); const tl = controller.execute("timeline.list").result; if (tl.features.some(x => x.type === "coil")) ui.fail("undo did not remove the coil") })()
