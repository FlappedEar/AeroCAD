# Rib with Extent "To Next Body" (Fusion: Create > Rib): the wall grows from the sketch up to the picked body
# instead of a typed height. A 60 mm line, 4 mm thick, under a plate whose underside (picked from below) is at z = 30.
# Run: AeroCAD --ui-script <this file>
ui.wait(800)
(() => { let r = controller.execute("feature.box", { corner: [-10, -20, 30], size: [80, 40, 5] }); if (!r.ok) ui.fail("plate: " + r.error); r = controller.execute("sketch.create", { plane: "XY", curves: [{ type: "line", start: [0, 0], end: [60, 0] }] }); if (!r.ok) ui.fail("curve sketch: " + r.error) })()
ui.wait(300)
(() => { viewport.restoreCameraState({ pivot: [30, 0, 15], pitch: 35, yaw: 20, distance: 220, orthographic: false }) })()
ui.wait(300)
(() => { if (!ui.clickText("SOLID")) ui.fail("no SOLID tab") })()
ui.wait(300)
(() => { if (!ui.clickText("CREATE")) ui.log("no CREATE caption menu") })()
ui.wait(300)
(() => { if (!ui.clickText("Rib")) ui.fail("no Rib command") })()
ui.wait(800)
(() => { const sk = controller.execute("timeline.list").result.features.filter(f => f.type === "sketch").pop(); featureDialog.setValue("path", { sketch: sk.id }); featureDialog.setValue("thickness", 4); featureDialog.setValue("extent", "to_object"); if (featureDialog.pickKey !== "to") ui.fail("To Next Body did not start picking: " + featureDialog.pickKey) })()
ui.wait(300)
(() => { const p = viewport.viewPoint(Qt.vector3d(30, 12, 30)); const w = viewport.mapToItem(null, p.x, p.y); ui.click(w.x, w.y) })()
ui.wait(1000)
(() => { const v = featureDialog.values; ui.log("to " + JSON.stringify(v.to) + " error '" + featureDialog.error + "'"); if (!v.to || v.to.body === undefined) ui.fail("clicking the plate underside did not pick it") })()
ui.shot("rib-to-next.png")
(() => { if (!ui.clickText("OK")) ui.fail("no OK button") })()
ui.wait(800)
(() => { const tl = controller.execute("timeline.list").result; const b = tl.bodies.find(x => x.name !== "Body1"); const want = 60 * 4 * 30; ui.log("volume " + b.volume.toFixed(2) + " want " + want); if (tl.bodies.length !== 2 || Math.abs(b.volume - want) > 1) ui.fail("expected a rib of " + want + " mm3 up to the plate, got " + b.volume) })()
(() => { controller.execute("edit.undo"); const tl = controller.execute("timeline.list").result; if (tl.bodies.length !== 1) ui.fail("undo did not remove the rib") })()
