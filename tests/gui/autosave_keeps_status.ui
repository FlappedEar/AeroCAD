# CAD-250: a recovery copy saved in the background keeps the status line (it showed
# "Recovery copy saved" over a fit's deviation result).
# Run: AeroCAD tests/data/tetrahedron.stl --ui-script <this file> (the import leaves unsaved changes)
ui.wait(1500)
(() => { if (!controller.projectDirty) ui.fail("the imported part left no unsaved changes") })()
(() => { controller.showStatus("Surface fitted: max deviation 0.2 mm"); if (!controller.autosaveNow()) ui.fail("no recovery copy saved"); if (!controller.hasAutosave()) ui.fail("no recovery copy on disk"); if (controller.statusMessage !== "Surface fitted: max deviation 0.2 mm") ui.fail("the recovery copy replaced the status: " + controller.statusMessage) })()
