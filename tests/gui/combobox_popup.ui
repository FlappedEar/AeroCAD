# Opens a ComboBox popup for each kind of model the app uses and checks that every row
# shows its text (rows were empty in the AeroCAD style). Run: AeroCAD --ui-script <this file>
Qt.createQmlObject('import QtQuick; import QtQuick.Controls; import AeroCAD; Item { objectName: "comboTest"; anchors.fill: parent; z: 1000; property var combos: [c0, c1, c2, c3]; property var want: [["mm", "cm", "m"], ["Into the surface", "Out of the surface"], Preferences.themes.map(t => t.label), ["Part A", "Part B"]]; ComboBox { id: c0; x: 40; y: 120; width: 200; model: ["mm", "cm", "m"] } ComboBox { id: c1; x: 260; y: 120; width: 200; textRole: "label"; valueRole: "value"; model: [{ value: "inside", label: "Into the surface" }, { value: "outside", label: "Out of the surface" }] } ComboBox { id: c2; x: 480; y: 120; width: 200; textRole: "label"; valueRole: "value"; model: Preferences.themes } ComboBox { id: c3; x: 700; y: 120; width: 200; textRole: "name"; model: ListModel { ListElement { name: "Part A" } ListElement { name: "Part B" } } } function rows(c) { const out = []; const lv = c.popup.contentItem; for (let i = 0; i < lv.count; ++i) { const d = lv.itemAtIndex(i); out.push(d ? d.contentItem.text : null) } return out } function check() { combos.forEach((c, i) => { const got = rows(c); ui.log("combo " + i + ": " + JSON.stringify(got)); if (JSON.stringify(got) !== JSON.stringify(want[i])) ui.fail("combo " + i + " rows " + JSON.stringify(got) + ", expected " + JSON.stringify(want[i])) }) } }', window.contentItem)
Array.from(window.contentItem.children).find(c => c.objectName === "comboTest").combos.forEach(c => c.popup.open())
ui.wait(500)
Array.from(window.contentItem.children).find(c => c.objectName === "comboTest").check()
