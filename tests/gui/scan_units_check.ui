# CAD-140: a scan saved in metres comes in a thousand times too small. Its guide starts with
# "Check the size", whose button converts it from metres; a scan of plausible size has no
# such step.
ui.wait(1200)
(() => { const p = controller.execute("document.parts").result.parts[0]; window.selectPart(p.id); if (contextActions.guide(window.selectionInfo).sections[0].title === "Check the size") ui.fail("size check on a plausible scan") })()
# Make it the size it has when the file was saved in metres.
(() => { const p = controller.execute("document.parts").result.parts[0]; const r = controller.execute("part.convert_units", { id: p.id, from: "mm", to: "m" }); if (!r.ok) ui.fail(r.error) })()
ui.wait(500)
(() => { const g = contextActions.guide(window.selectionInfo); ui.log("SECTION " + g.sections[0].title + ": " + g.sections[0].steps[0].title); if (g.sections[0].title !== "Check the size") ui.fail("no size check for a scan in metres"); const n = contextActions.nextAction(window.selectionInfo); if (!n || n.id !== "convertUnits" || n.text.indexOf("metres") < 0) ui.fail("converting from metres is not the next step") })()
ui.shot("scan-units-check.png")
ui.clickText("It is in metres (×1000)")
ui.wait(800)
(() => { const info = window.selectionInfo; ui.log("SIZE " + info.sizeX); if (Math.abs(info.sizeX - 234) > 1) ui.fail("not converted back to millimetres: " + info.sizeX); if (contextActions.guide(info).sections[0].title === "Check the size") ui.fail("size check still shown after converting") })()
# CAD-239: a mm file imported with "Unitless files in" = m is 234 m long. The guide says it was
# imported as metres and saved in millimetres (not "micrometres"), and the button fixes it.
(() => { const src = window.selectionInfo.source; controller.newProject(); scan.importUnits = "m"; scan.importFile("file://" + src) })()
ui.wait(2500)
(() => { const p = controller.execute("document.parts").result.parts[0]; window.selectPart(p.id); const info = window.selectionInfo; ui.log("IMPORTED AS M " + info.sizeX + " " + info.importUnits); if (info.importUnits !== "m") ui.fail("the part does not remember its import unit: " + info.importUnits); const g = contextActions.guide(info); const step = g.sections[0].steps[0]; ui.log("STEP " + step.title + " | " + step.text); if (g.sections[0].title !== "Check the size") ui.fail("no size check for a 234 m scan"); if (step.text.indexOf("imported as metres") < 0 || step.text.indexOf("saved in millimetres") < 0) ui.fail("guide names the wrong unit: " + step.text); const n = contextActions.nextAction(info); if (!n || n.text !== "It is in millimetres (×0.001)") ui.fail("next action: " + (n ? n.text : "none")) })()
ui.shot("scan-units-imported-as-m-guide.png")
ui.clickText("It is in millimetres (×0.001)")
ui.wait(800)
(() => { const info = window.selectionInfo; ui.log("FIXED " + info.sizeX + " | " + controller.statusMessage); if (Math.abs(info.sizeX - 234) > 1) ui.fail("not converted to its real size: " + info.sizeX); if (controller.statusMessage.indexOf("read as millimetres instead of metres") < 0) ui.fail("status: " + controller.statusMessage); scan.importUnits = "mm" })()
ui.shot("scan-units-imported-as-m.png")
ui.log("scan units check done")
