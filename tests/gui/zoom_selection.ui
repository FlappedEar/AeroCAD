# Zoom to selection, with real mouse input:
#  - a double click on a part fills the view with it, on empty space fits everything;
#  - a middle button double click fits everything (Fusion);
#  - with an area of a part selected, the navigation bar button (and View > Zoom to
#    Selection) fills the view with that area; the button is off with nothing selected;
#  - a part being moved is framed where it is shown; a double click while picking a face
#    for Lay on Face does not zoom.
# Run: AeroCAD tests/data/box_200x80x60.stl --ui-script <this file>
Qt.createQmlObject('import QtQuick; Item { objectName: "zsTest"; visible: false; property var s: ({}); function win(p) { const q = viewport.mapToItem(null, p.x, p.y); return Qt.point(q.x, q.y) } function scene(m) { return [m[0], m[2], -m[1]] } function near(a, b, tol) { return a.every((v, i) => Math.abs(v - b[i]) <= tol) } function expected(r) { return viewport.frameDistance(Math.max(r, 1)) } function corners(b) { const out = []; for (let i = 0; i < 8; ++i) out.push(Qt.vector3d(i & 1 ? b.max[0] : b.min[0], i & 2 ? b.max[1] : b.min[1], i & 4 ? b.max[2] : b.min[2])); return out } function frames(b, label) { const q = corners(b).map(c => viewport.modelToScreen(c)); const xs = q.map(p => p.x), ys = q.map(p => p.y); const w = Math.max(...xs) - Math.min(...xs), h = Math.max(...ys) - Math.min(...ys); const inside = Math.min(...xs) >= 0 && Math.max(...xs) <= viewport.width && Math.min(...ys) >= 0 && Math.max(...ys) <= viewport.height; const fill = Math.max(w / viewport.width, h / viewport.height); ui.log(label + ": on screen " + inside + ", fills " + (fill * 100).toFixed(0) + " %"); if (!inside) ui.fail(label + ": not all of it is on screen"); if (fill < 0.4) ui.fail(label + ": does not fill the view (" + (fill * 100).toFixed(0) + " %)") } function find(i, name) { if (!i) return null; if (i.objectName === name) return i; const ch = i.children || []; for (let k = 0; k < ch.length; ++k) { const r = find(ch[k], name); if (r) return r } return null } function part() { return controller.execute("document.parts").result.parts.find(p => p.id === s.id) } }', window.contentItem)
ui.wait(800)
# A copy of the box 1 m along X, so that the whole scene is not just the box.
(() => { const t = Array.from(window.contentItem.children).find(c => c.objectName === "zsTest"); t.s.id = controller.execute("document.parts").result.parts[0].id; const d = controller.execute("part.duplicate", { id: t.s.id }); if (!d.ok) { ui.fail("duplicate: " + d.error); return } const copy = controller.execute("document.parts").result.parts.find(p => p.id !== t.s.id); const m = controller.execute("part.transform", { id: copy.id, translate: [1000, 0, 0] }); if (!m.ok) ui.fail("move the copy: " + m.error) })()
ui.wait(300)
(() => { const t = Array.from(window.contentItem.children).find(c => c.objectName === "zsTest"); viewport.restoreCameraState({ pivot: [0, 0, 0], pitch: -30, yaw: 45, distance: 1, orthographic: false }); viewport.fitAll(); t.s.fit = viewport.cameraState(); window.selectPart(0); const nav = t.s.nav = t.find(viewport, "fitSelection"); if (!nav) ui.fail("no Zoom to selection button in the navigation bar"); else if (nav.enabled) ui.fail("Zoom to selection is on with nothing selected") })()
# 1. Far away and off to the side, a real double click on the part fills the view with it.
(() => { const t = Array.from(window.contentItem.children).find(c => c.objectName === "zsTest"); viewport.restoreCameraState({ pivot: [400, 0, 300], pitch: -30, yaw: 45, distance: t.s.fit.distance * 6, orthographic: false }); const c = viewport.modelToScreen(Qt.vector3d(100, 40, 30)); if (!viewport.pickPart(c.x, c.y)) ui.fail("the part is not under its centre"); const w = t.win(c); ui.doubleClick(w.x, w.y) })()
ui.wait(300)
(() => { const t = Array.from(window.contentItem.children).find(c => c.objectName === "zsTest"); const st = viewport.cameraState(); const b = t.part().bounds; ui.log("double click on part: pivot " + JSON.stringify(st.pivot.map(v => +v.toFixed(2))) + ", distance " + st.distance.toFixed(1)); if (!t.near(st.pivot, t.scene([100, 40, 30]), 1e-3)) ui.fail("double click did not centre the part"); if (Math.abs(st.distance - t.expected(Math.hypot(200, 80, 60) / 2)) > 1e-3) ui.fail("double click did not frame the part"); t.frames(b, "part"); if (window.selectedPartId !== t.part().id) ui.fail("double click did not select the part"); if (!t.s.nav.enabled) ui.fail("Zoom to selection is off with a part selected") })()
ui.shot("build/zoom-selection-1-part.png")
# 2. A real double click on empty space fits everything.
(() => { const t = Array.from(window.contentItem.children).find(c => c.objectName === "zsTest"); const e = [[0.05, 0.1], [0.95, 0.1], [0.05, 0.6], [0.95, 0.6]].map(f => Qt.point(viewport.width * f[0], viewport.height * f[1])).find(q => !viewport.pickPart(q.x, q.y)); if (!e) { ui.fail("no empty spot"); return } t.s.empty = e; const w = t.win(e); ui.doubleClick(w.x, w.y) })()
ui.wait(300)
(() => { const t = Array.from(window.contentItem.children).find(c => c.objectName === "zsTest"); const st = viewport.cameraState(); ui.log("double click on empty space: distance " + st.distance.toFixed(1) + " (fit all " + t.s.fit.distance.toFixed(1) + ")"); if (Math.abs(st.distance - t.s.fit.distance) > 1e-3 || !t.near(st.pivot, t.s.fit.pivot, 1e-3)) ui.fail("double click on empty space did not fit all") })()
# 3. Middle button double click fits everything; a middle drag still pans.
(() => { const t = Array.from(window.contentItem.children).find(c => c.objectName === "zsTest"); viewport.restoreCameraState({ pivot: [300, 0, 0], pitch: -20, yaw: 30, distance: t.s.fit.distance * 3, orthographic: false }); const e = [[0.05, 0.1], [0.95, 0.1], [0.05, 0.9], [0.95, 0.9]].map(f => Qt.point(viewport.width * f[0], viewport.height * f[1])).find(q => !viewport.pickPart(q.x, q.y)); const w = t.win(e); ui.doubleClick(w.x, w.y, "middle") })()
ui.wait(300)
(() => { const t = Array.from(window.contentItem.children).find(c => c.objectName === "zsTest"); const st = viewport.cameraState(); ui.log("middle double click: distance " + st.distance.toFixed(1)); if (Math.abs(st.distance - t.s.fit.distance) > 1e-3 || !t.near(st.pivot, t.s.fit.pivot, 1e-3)) ui.fail("middle double click did not fit all"); const p0 = st.pivot; const c = t.win(Qt.point(viewport.width / 2, viewport.height / 2)); ui.drag(c.x, c.y, c.x + 80, c.y, "middle", "", 8); const p1 = viewport.cameraState().pivot; if (t.near(p0, p1, 1e-6)) ui.fail("middle drag no longer pans") })()
ui.wait(200)
# 4. An area selected: the navigation bar button fills the view with that area.
(() => { const t = Array.from(window.contentItem.children).find(c => c.objectName === "zsTest"); const id = t.part().id; window.selectPart(id); const r = controller.execute("selection.pick_region", { id: id, point: [100, 40, 60] }); if (!r.ok) { ui.fail("pick region: " + r.error); return } t.s.sel = r.result.bounds; if (!t.s.sel || Math.abs(t.s.sel.min[2] - 60) > 1e-6) ui.fail("selection bounds missing: " + JSON.stringify(r.result)); viewport.restoreCameraState({ pivot: [0, 0, 0], pitch: -60, yaw: 20, distance: t.s.fit.distance * 4, orthographic: false }); const n = t.s.nav; const p = n.mapToItem(null, n.width / 2, n.height / 2); ui.click(p.x, p.y) })()
ui.wait(300)
(() => { const t = Array.from(window.contentItem.children).find(c => c.objectName === "zsTest"); const st = viewport.cameraState(); const b = t.s.sel; ui.log("zoom to selected area: pivot " + JSON.stringify(st.pivot.map(v => +v.toFixed(2))) + ", distance " + st.distance.toFixed(1)); if (!t.near(st.pivot, t.scene(b.center), 1e-3)) ui.fail("the selected area is not centred"); if (Math.abs(st.distance - t.expected(b.diagonal / 2)) > 1e-3) ui.fail("the selected area is not framed"); t.frames(b, "selected area") })()
ui.shot("build/zoom-selection-2-area.png")
# 5. View > Zoom to Selection with the selection cleared frames the whole part.
(() => { const t = Array.from(window.contentItem.children).find(c => c.objectName === "zsTest"); controller.execute("selection.clear", { id: t.part().id }); zoomSelectionAction.trigger(); const st = viewport.cameraState(); if (!t.near(st.pivot, t.scene([100, 40, 30]), 1e-3)) ui.fail("Zoom to Selection without an area did not frame the part"); window.selectPart(0); if (t.s.nav.enabled || zoomSelectionAction.enabled) ui.fail("Zoom to Selection stays on with nothing selected") })()
# 6. A part being moved (or scaled) is framed where and as large as it is shown, and stays
#    between the clipping planes; a double click while picking a face
#    for Lay on Face picks the face, it does not zoom.
(() => { const t = Array.from(window.contentItem.children).find(c => c.objectName === "zsTest"); const id = t.part().id; window.selectPart(id); window.startTransform(id); viewport.transformMove = Qt.vector3d(500, 0, 0); zoomSelectionAction.trigger(); const st = viewport.cameraState(); ui.log("moved part: pivot " + JSON.stringify(st.pivot.map(v => +v.toFixed(2)))); if (!t.near(st.pivot, t.scene([600, 40, 30]), 1e-3)) ui.fail("a part being moved was not framed where it is shown"); if (!viewport.transformActive) ui.fail("zooming ended the move"); viewport.transformScale = 30; zoomSelectionAction.trigger(); const big = viewport.cameraState(); const clip = viewport.clipRange(); const R = Math.hypot(200, 80, 60) / 2 * 30; ui.log("scaled x30: distance " + big.distance.toFixed(0) + ", clipping " + clip.near.toFixed(0) + " to " + clip.far.toFixed(0) + ", part radius " + R.toFixed(0)); if (Math.abs(big.distance - t.expected(R)) > 1e-3) ui.fail("a scaled preview was not framed at its size"); if (clip.near > big.distance - R || clip.far < big.distance + R) ui.fail("the scaled preview is clipped"); viewport.transformScale = 1; zoomSelectionAction.trigger(); viewport.transformPickMode = "lay"; t.s.before = viewport.cameraState(); const c = viewport.modelToScreen(Qt.vector3d(600, 40, 60)); const w = t.win(c); ui.doubleClick(w.x, w.y) })()
ui.wait(300)
(() => { const t = Array.from(window.contentItem.children).find(c => c.objectName === "zsTest"); const st = viewport.cameraState(); if (Math.abs(st.distance - t.s.before.distance) > 1e-6 || !t.near(st.pivot, t.s.before.pivot, 1e-6)) ui.fail("a double click while picking a face zoomed"); viewport.finishTransform(false) })()
