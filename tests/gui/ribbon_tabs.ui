# Opens every toolbar tab and checks that it shows its own groups only, and that the
# guided SURFACE/MESH commands follow the selection (a scan enables the MESH commands).
# Run: AeroCAD <scan.stl> --ui-script <this file>
ui.wait(500)
(() => { const find = (item, pred, out) => { if (pred(item)) out.push(item); for (let k = 0; k < item.children.length; ++k) find(item.children[k], pred, out); return out }; const groups = () => find(window.contentItem.parent, i => i.caption !== undefined && i.maxVisible !== undefined && i.visible, []).map(g => g.caption); const enabledCommands = () => find(window.contentItem.parent, i => i.actionId !== undefined && i.visible && i.enabled, []).map(c => c.actionId); const want = { solid: ["CREATE", "MODIFY", "CONSTRUCT", "INSERT", "VARIANT", "EXPORT"], surface: ["CREATE", "SKETCH", "MODIFY", "PART", "CHECK"], mesh: ["INSERT", "SELECT", "PREPARE", "DESIGN ON SCAN", "CONVERT", "EXPORT"], inspect: ["MEASURE", "ANALYSIS"], simulate: ["AERODYNAMICS"], tools: ["AI", "UTILITIES"] }; for (const t of Object.keys(want)) { window.ribbonTab = t; const got = groups(); ui.log(t + ": " + JSON.stringify(got)); if (JSON.stringify(got) !== JSON.stringify(want[t])) ui.fail(t + " shows " + JSON.stringify(got)) } })()
window.ribbonTab = "mesh"; window.selectPart(0)
ui.wait(300)
(() => { const find = (item, pred, out) => { if (pred(item)) out.push(item); for (let k = 0; k < item.children.length; ++k) find(item.children[k], pred, out); return out }; const groups = () => find(window.contentItem.parent, i => i.caption !== undefined && i.maxVisible !== undefined && i.visible, []).map(g => g.caption); const enabledCommands = () => find(window.contentItem.parent, i => i.actionId !== undefined && i.visible && i.enabled, []).map(c => c.actionId); const on = enabledCommands(); ui.log("nothing selected: " + JSON.stringify(on)); if (on.length) ui.fail("guided commands enabled without a selection: " + on) })()
(() => { const find = (item, pred, out) => { if (pred(item)) out.push(item); for (let k = 0; k < item.children.length; ++k) find(item.children[k], pred, out); return out }; const groups = () => find(window.contentItem.parent, i => i.caption !== undefined && i.maxVisible !== undefined && i.visible, []).map(g => g.caption); const enabledCommands = () => find(window.contentItem.parent, i => i.actionId !== undefined && i.visible && i.enabled, []).map(c => c.actionId); const scan = controller.execute("document.parts").result.parts.find(p => p.kind === "imported"); if (!scan) ui.fail("no scan loaded"); else window.selectPart(scan.id) })()
ui.wait(300)
(() => { const find = (item, pred, out) => { if (pred(item)) out.push(item); for (let k = 0; k < item.children.length; ++k) find(item.children[k], pred, out); return out }; const groups = () => find(window.contentItem.parent, i => i.caption !== undefined && i.maxVisible !== undefined && i.visible, []).map(g => g.caption); const enabledCommands = () => find(window.contentItem.parent, i => i.actionId !== undefined && i.visible && i.enabled, []).map(c => c.actionId); const on = enabledCommands(); ui.log("mesh tab, scan selected: " + JSON.stringify(on)); for (const id of ["repair", "simplify", "sketchOnScan", "fitWhole", "toBody"]) if (on.indexOf(id) < 0) ui.fail(id + " not enabled for a scan"); if (on.indexOf("fitSurface") >= 0) ui.fail("fitSurface enabled without a selected area") })()
window.ribbonTab = "surface"
ui.wait(300)
(() => { const find = (item, pred, out) => { if (pred(item)) out.push(item); for (let k = 0; k < item.children.length; ++k) find(item.children[k], pred, out); return out }; const groups = () => find(window.contentItem.parent, i => i.caption !== undefined && i.maxVisible !== undefined && i.visible, []).map(g => g.caption); const enabledCommands = () => find(window.contentItem.parent, i => i.actionId !== undefined && i.visible && i.enabled, []).map(c => c.actionId); const on = enabledCommands(); ui.log("surface tab, scan selected: " + JSON.stringify(on)); if (on.indexOf("thicken") >= 0) ui.fail("thicken enabled for a scan") })()
