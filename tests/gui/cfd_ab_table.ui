# SPDX-License-Identifier: GPL-3.0-or-later
# CAD-117: the A/B table names the runs (label and start time), explains "check quality", and
# shows no percentage for a force at noise level. The comparison is the one of two real coarse
# OpenFOAM v2506 runs of the same box (labels "A" and "B"; the newer one became A).
# The convergence chart (CAD-179) uses injected histories.
ui.wait(1000)
(() => { const p = controller.execute("document.parts").result.parts[0]; window.selectPart(p.id) })()
ui.clickText("SIMULATE")
ui.wait(300)
ui.clickText("Wind Tunnel")
ui.wait(1000)
(() => { simulationPanel.runs = [{ id: "r2", created: "2026-11-08T14:32:17Z", state: "finished", source: { label: "B", partName: "box" } }, { id: "r1", created: "2026-11-08T14:31:31Z", state: "finished", source: { label: "", partName: "box" } }]; simulationPanel.comparison = { a: "r2", b: "r1", verdict: "check quality", states: { a: "finished", b: "running" }, forces: { dragN: { a: 3.083, b: 3.082, difference: -0.001, percent: -0.03 }, liftN: { a: -0.153, b: -0.154, difference: -0.001, percent: -0.4 }, sideN: { a: 0.002, b: 0.008, difference: 0.006, percent: 316.3 } }, differingConditions: [], unknownConditions: [], reasons: [], notes: [], meshSensitivity: { status: "not assessed", levels: [] }, quality: { a: { status: "ok" }, b: { status: "warnings" } } }; simulationPanel.tab = 2 })()
ui.wait(600)
(() => { const t = simulationPanel.runTitle("r2", "finished"); const u = simulationPanel.runTitle("r1", "running"); ui.log("TITLES " + t + " | " + u); if (!/^B \(\d\d:\d\d\)$/.test(t)) ui.fail("run A title: " + t); if (!/^box \(\d\d:\d\d\), running$/.test(u)) ui.fail("run B title: " + u) })()
(() => { ui.log("NOISE side " + simulationPanel.noiseLevel(0.002) + " lift " + simulationPanel.noiseLevel(-0.153)); if (!simulationPanel.noiseLevel(0.002) || simulationPanel.noiseLevel(-0.153)) ui.fail("noise level") })()
ui.clickText("B has quality warnings (see Results), so the difference may not be reliable.")
(() => { const t = simulationPanel.checkQualityText({ verdict: "check quality", quality: { a: { status: "ok" }, b: { status: "ok" } }, meshSensitivity: { status: "check quality", message: "A run on the fine mesh has quality warnings: check it before reading the mesh check." } }); ui.log("MESH " + t); if (t !== "Mesh check: A run on the fine mesh has quality warnings: check it before reading the mesh check.") ui.fail("mesh check text: " + t) })()
ui.clickText("0.0")
# Cd / Cl / Cs on A's reference area and the pressure / friction drag split (CAD-171).
(() => { const c = Object.assign({}, simulationPanel.comparison); c.forces = Object.assign({}, c.forces, { pressureDragN: { a: 2.9, b: 2.85, difference: -0.05, percent: -1.72 }, viscousDragN: { a: 0.183, b: 0.232, difference: 0.049, percent: 26.8 } }); c.coefficientsOnReferenceAreaOfA = { cd: { a: 0.817, b: 0.805, difference: -0.012 }, cl: { a: -0.041, b: -0.040, difference: 0.001 }, cs: { a: 0.0005, b: 0.002, difference: 0.0015 } }; simulationPanel.comparison = c })()
ui.wait(400)
(() => { const cd = simulationPanel.abRow("cd"); const cs = simulationPanel.abRow("cs"); ui.log("CD " + JSON.stringify(cd) + " CS " + JSON.stringify(cs)); if (!cd || Math.abs(cd.percent + 1.4688) > 0.01) ui.fail("Cd row: " + JSON.stringify(cd)); if (!cs || cs.percent !== null) ui.fail("Cs at noise level has a percentage: " + JSON.stringify(cs)) })()
ui.clickText("Pressure drag N")
ui.clickText("Friction drag N")
ui.clickText("0.8170")
ui.clickText("-0.0120")
ui.clickText("-1.5")
ui.clickText("+26.8")
ui.clickText("Coefficients on the reference area of A")
# L/D of A and B (CAD-187), 2 decimals, never at force noise level.
(() => { const c = Object.assign({}, simulationPanel.comparison); c.efficiency = { a: 2.4, b: 2.71, difference: 0.31, percent: 12.92 }; simulationPanel.comparison = c })()
ui.wait(400)
ui.clickText("L/D")
ui.clickText("2.40")
ui.clickText("+0.31")
ui.clickText("+12.9")
ui.shot("cfd-ab-efficiency.png")
(() => { const e = simulationPanel.abRow("efficiency"); if (!e || e.percent !== 12.92) ui.fail("L/D row: " + JSON.stringify(e)); const c = Object.assign({}, simulationPanel.comparison); delete c.efficiency; simulationPanel.comparison = c; if (simulationPanel.abRow("efficiency") !== null) ui.fail("L/D row without efficiency") })()
ui.wait(300)
ui.shot("cfd-ab-table.png")
# The mesh check names its runs still solving, with their progress (CAD-120).
(() => { const r = simulationPanel.runs.slice(); r.push({ id: "r3", created: "2026-11-08T14:54:51Z", state: "running", progress: 0.42, source: { label: "B", partName: "box" } }); simulationPanel.runs = r; const c = Object.assign({}, simulationPanel.comparison); c.meshSensitivity = { status: "pending", levels: [], message: "Waiting for the runs on the other mesh level.", runningRuns: ["r3"] }; simulationPanel.comparison = c })()
ui.wait(400)
ui.clickText("42 %")
# A and B convergence on the same axes (CAD-179); B's Cd on the reference area of A, like the table.
(() => { simulationPanel.results = { history: { iteration: [1, 2, 3, 4], cd: [0.9, 0.84, 0.82, 0.817] }, conditions: { referenceArea: 0.012 } }; simulationPanel.resultsB = { history: { iteration: [1, 2, 3, 4, 5], cd: [0.45, 0.42, 0.41, 0.403, 0.4025] }, conditions: { referenceArea: 0.024 } } })()
ui.wait(400)
(() => { const find = (i, n) => { if (!i) return null; if (i.objectName === n) return i; const ch = i.children || []; for (let k = 0; k < ch.length; ++k) { const r = find(ch[k], n); if (r) return r } return null }; const c = find(simulationPanel, "cfdChartAB"); if (!c || !c.visible) ui.fail("no A/B chart"); const s = c.series; ui.log("AB CHART " + JSON.stringify(s.map(x => ({ name: x.name, y: x.y })))); if (s.length !== 2 || s[0].name !== "Cd A" || s[1].name !== "Cd B") ui.fail("series: " + s.map(x => x.name)); if (s[0].y[3] !== 0.817 || Math.abs(s[1].y[4] - 0.805) > 1e-12 || s[1].x.length !== 5) ui.fail("values") })()
ui.shot("cfd-ab-convergence.png")
# Hovering where only B has data (A ended at iteration 4): A gives no value, B its own (CAD-179).
(() => { const find = (i, n) => { if (!i) return null; if (i.objectName === n) return i; const ch = i.children || []; for (let k = 0; k < ch.length; ++k) { const r = find(ch[k], n); if (r) return r } return null }; const c = find(simulationPanel, "cfdChartAB"); let fl = c.parent; while (fl && fl.contentY === undefined) fl = fl.parent; if (fl) { const q = c.mapToItem(fl.contentItem, 0, 0); fl.contentY = Math.max(0, Math.min(fl.contentHeight - fl.height, q.y + c.height / 2 - fl.height / 2)) } })()
ui.wait(300)
(() => { const find = (i, n) => { if (!i) return null; if (i.objectName === n) return i; const ch = i.children || []; for (let k = 0; k < ch.length; ++k) { const r = find(ch[k], n); if (r) return r } return null }; const c = find(simulationPanel, "cfdChartAB"); const p = c.layoutPlot(c.width, c.height - 20); const q = c.mapToItem(null, p.left + p.w - 1, c.height / 2); ui.move(q.x, q.y) })()
ui.wait(300)
(() => { const find = (i, n) => { if (!i) return null; if (i.objectName === n) return i; const ch = i.children || []; for (let k = 0; k < ch.length; ++k) { const r = find(ch[k], n); if (r) return r } return null }; const c = find(simulationPanel, "cfdChartAB"); const r = c.readout; ui.log("AB HOVER END " + JSON.stringify(r && { x: r.x, v: r.values.map(v => [v.name, v.value, v.ownX]) })); if (!r || r.x !== 5) ui.fail("readout x: " + (r && r.x)); if (r.values[0].value !== null || Math.abs(r.values[1].value - 0.805) > 1e-12) ui.fail("A must have no value past its end, B 0.805") })()
(() => { const find = (i, n) => { if (!i) return null; if (i.objectName === n) return i; const ch = i.children || []; for (let k = 0; k < ch.length; ++k) { const r = find(ch[k], n); if (r) return r } return null }; const c = find(simulationPanel, "cfdChartAB"); const p = c.layoutPlot(c.width, c.height - 20); const q = c.mapToItem(null, p.px(4), c.height / 2); ui.move(q.x, q.y) })()
ui.wait(300)
(() => { const find = (i, n) => { if (!i) return null; if (i.objectName === n) return i; const ch = i.children || []; for (let k = 0; k < ch.length; ++k) { const r = find(ch[k], n); if (r) return r } return null }; const c = find(simulationPanel, "cfdChartAB"); const r = c.readout; ui.log("AB HOVER 4 " + JSON.stringify(r && { x: r.x, v: r.values.map(v => [v.name, v.value, v.ownX]) })); if (!r || r.x !== 4 || r.values[0].value !== 0.817 || Math.abs(r.values[1].value - 0.806) > 1e-12 || r.values[1].ownX !== null) ui.fail("readout at 4") })()
# Differently sampled series: a series without a point at the readout x names its own x.
(() => { const find = (i, n) => { if (!i) return null; if (i.objectName === n) return i; const ch = i.children || []; for (let k = 0; k < ch.length; ++k) { const r = find(ch[k], n); if (r) return r } return null }; const c = find(simulationPanel, "cfdChartAB"); c.series = [{ name: "a", color: "#ff0000", x: [0, 10, 20, 30], y: [1, 2, 3, 4] }, { name: "b", color: "#0000ff", x: [0, 15, 30], y: [5, 6, 7] }]; const p = c.layoutPlot(c.width, c.height - 20); const q = c.mapToItem(null, p.px(11), c.height / 2); ui.move(q.x, q.y) })()
ui.wait(300)
(() => { const find = (i, n) => { if (!i) return null; if (i.objectName === n) return i; const ch = i.children || []; for (let k = 0; k < ch.length; ++k) { const r = find(ch[k], n); if (r) return r } return null }; const c = find(simulationPanel, "cfdChartAB"); const r = c.readout; ui.log("AB HOVER SAMPLED " + JSON.stringify(r && { x: r.x, v: r.values.map(v => [v.name, v.value, v.ownX]) })); if (!r || r.x !== 10 || r.values[0].value !== 2 || r.values[1].value !== 6 || r.values[1].ownX !== 15) ui.fail("sampled readout") })()
# Differing conditions are listed in words with both values, not as internal names (CAD-159).
(() => { const c = Object.assign({}, simulationPanel.comparison); c.verdict = "not comparable"; c.differingConditions = ["groundHeight"]; c.conditionChanges = ["Floor height: A -40 mm, B -150 mm"]; simulationPanel.comparison = c })()
ui.wait(400)
ui.clickText("⚠ Different: Floor height: A -40 mm, B -150 mm")
ui.log("cfd ab table done")
