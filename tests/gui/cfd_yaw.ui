# CAD-188: the New run form sets a yaw (crosswind); empty = 0. The part is turned in the tunnel,
# so the frontal area grows; runs store it and show it. Prepared cases only (no engine).
Qt.createQmlObject('import QtQuick; Item { objectName: "cfTest"; visible: false; function find(i, name) { if (!i) return null; if (i.objectName === name) return i; const ch = i.children || []; for (let k = 0; k < ch.length; ++k) { const r = find(ch[k], name); if (r) return r } return null } function runButton(i) { if (!i) return null; if (i.text === "Run CFD" && i.highlighted !== undefined) return i; const ch = i.children || []; for (let k = 0; k < ch.length; ++k) { const r = runButton(ch[k]); if (r) return r } return null } }', window.contentItem)
ui.wait(800)
(() => { for (const r of controller.execute("simulation.list").result.runs) controller.execute("simulation.delete", { run: r.id }) })()
(() => { const p = controller.execute("document.parts").result.parts[0]; window.selectPart(p.id) })()
ui.clickText("SIMULATE")
ui.wait(300)
ui.clickText("Wind Tunnel")
ui.wait(1000)
(() => { simulationPanel.tab = 0; simulationPanel.refreshProposal() })()
ui.wait(300)
(() => { const t = Array.from(window.contentItem.children).find(c => c.objectName === "cfTest"); const f = t.find(simulationPanel, "cfdYawField"); if (!f || f.text !== "") ui.fail("no empty yaw field"); if ("yaw" in simulationPanel.runParams()) ui.fail("empty yaw sent"); ui.log("STRAIGHT " + t.find(simulationPanel, "cfdRefAreaField").placeholderText) })()
(() => { const t = Array.from(window.contentItem.children).find(c => c.objectName === "cfTest"); const f = t.find(simulationPanel, "cfdYawField"); const p = f.mapToItem(null, f.width / 2, f.height / 2); ui.click(p.x, p.y) })()
ui.type("31")
ui.wait(200)
(() => { const t = Array.from(window.contentItem.children).find(c => c.objectName === "cfTest"); const e = t.find(simulationPanel, "cfdYawError"); const b = t.runButton(simulationPanel); ui.log("31: error " + e.visible + " run " + b.enabled); if (!e.visible || b.enabled) ui.fail("yaw 31 accepted") })()
(() => { const t = Array.from(window.contentItem.children).find(c => c.objectName === "cfTest"); t.find(simulationPanel, "cfdYawField").selectAll() })()
ui.type("-2,5")
ui.wait(200)
(() => { const y = simulationPanel.runParams().yaw; ui.log("COMMA " + y); if (y !== -2.5) ui.fail("-2,5 read as " + y) })()
(() => { const t = Array.from(window.contentItem.children).find(c => c.objectName === "cfTest"); t.find(simulationPanel, "cfdYawField").selectAll() })()
ui.type("5")
ui.wait(1200)
# At 5 degrees the 200 x 80 x 60 mm box seen along the air is 60 x (200 cos 5 + 80 sin 5) mm = 123.7 cm².
(() => { const t = Array.from(window.contentItem.children).find(c => c.objectName === "cfTest"); const e = t.find(simulationPanel, "cfdYawError"); const b = t.runButton(simulationPanel); const ph = t.find(simulationPanel, "cfdRefAreaField").placeholderText; ui.log("YAW 5: error " + e.visible + " run " + b.enabled + " area " + ph); if (e.visible || !b.enabled || simulationPanel.runParams().yaw !== 5) ui.fail("yaw 5"); if (ph !== "auto: 123.7 cm² (frontal)") ui.fail("frontal area at yaw: " + ph) })()
# The tunnel preview stands turned: its case-X edge (corner 0 -> 1) runs along the yawed air.
(() => { const p = simulationPanel.proposal; const c = p.domainCorners, f = p.flowModel; const e = [0, 1, 2].map(i => c[1][i] - c[0][i]); const len = Math.hypot(...e); const cos = (e[0] * f[0] + e[1] * f[1] + e[2] * f[2]) / len; const a = 5 * Math.PI / 180; ui.log("TUNNEL edge·flow " + cos.toFixed(6) + " flow " + f.map(x => x.toFixed(4)).join(",")); if (Math.abs(cos - 1) > 1e-9 || Math.abs(f[0] + Math.sin(a)) > 1e-9 || Math.abs(f[1] - Math.cos(a)) > 1e-9) ui.fail("tunnel or flow not turned by the yaw") })()
ui.shot("cfd-yaw.png")
(() => { const r = controller.execute("simulation.run", Object.assign(simulationPanel.runParams(), { label: "yawed", prepareOnly: true })); if (!r.ok) ui.fail("prepare: " + r.error); const res = controller.execute("simulation.results", { run: r.result.id, maxPoints: 2 }).result; ui.log("STORED yaw " + res.conditions.settings.yaw); if (res.conditions.settings.yaw !== 5) ui.fail("stored yaw") })()
(() => { const p = controller.execute("document.parts").result.parts[0]; const r = controller.execute("simulation.run", { id: p.id, label: "straight", prepareOnly: true }); if (!r.ok) ui.fail("prepare 2: " + r.error); simulationPanel.refreshRuns() })()
ui.wait(300)
(() => { const t = Array.from(window.contentItem.children).find(c => c.objectName === "cfTest"); const f = t.find(simulationPanel, "cfdYawField"); const yawed = simulationPanel.runs.find(r => r.source.label === "yawed"); const straight = simulationPanel.runs.find(r => r.source.label === "straight"); simulationPanel.useSettingsOf(straight.id); if (f.text !== "") ui.fail("straight run copied a yaw: " + f.text); simulationPanel.useSettingsOf(yawed.id); ui.log("COPY yawed '" + f.text + "'"); if (f.text !== "5") ui.fail("yawed copy: " + f.text); const l = t.find(simulationPanel, "runConditions_" + yawed.id); ui.log("ROW " + l.text); if (l.text.indexOf("flow +Y, yaw 5°") < 0) ui.fail("row: " + l.text); const m = t.find(simulationPanel, "runConditions_" + straight.id); if (m.text.indexOf("yaw") >= 0) ui.fail("straight row names a yaw: " + m.text) })()
ui.log("cfd yaw done")
