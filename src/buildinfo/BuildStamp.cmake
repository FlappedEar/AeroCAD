# Script mode (cmake -P): writes OUT with the current build stamp. The file is rewritten only
# when the stamp changes, so builds within the same minute do not recompile anything.
string(TIMESTAMP stamp "%Y.%m.%d-%H%M")

find_package(Git QUIET)
set(hash "")
if(GIT_FOUND)
    execute_process(
        COMMAND ${GIT_EXECUTABLE} rev-parse --short=7 HEAD
        WORKING_DIRECTORY ${SOURCE_DIR}
        OUTPUT_VARIABLE hash
        OUTPUT_STRIP_TRAILING_WHITESPACE
        ERROR_QUIET
        RESULT_VARIABLE result)
    if(NOT result EQUAL 0)
        set(hash "")
    endif()
endif()
if(hash)
    string(APPEND stamp " (${hash})")
endif()

set(content "// Generated by BuildStamp.cmake. Do not edit.\n#include \"aerocad/BuildInfo.hpp\"\n\nconst char* aerocad::buildStamp()\n{\n    return \"${stamp}\";\n}\n")
if(EXISTS ${OUT})
    file(READ ${OUT} old)
else()
    set(old "")
endif()
if(NOT old STREQUAL content)
    file(WRITE ${OUT} "${content}")
endif()
